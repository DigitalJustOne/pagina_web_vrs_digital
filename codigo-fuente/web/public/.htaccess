# ══════════════════════════════════════════════════════════════════════════════
#  VRS Digital: configuración del servidor para Hostinger (Apache / LiteSpeed).
#  Astro copia este archivo tal cual a dist/. Súbalo junto con el resto de dist/
#  a public_html. Cada bloque está protegido con <IfModule> para que un módulo
#  ausente no tumbe el sitio con un error 500.
# ══════════════════════════════════════════════════════════════════════════════

# ── 1. Ajustes generales ──────────────────────────────────────────────────────
# Sin listados de carpetas ni negociación de contenido (evita que /precios
# responda con /precios.html por su cuenta). index.html es la página de cada carpeta.
Options -Indexes -MultiViews
DirectoryIndex index.html
# La barra final la agrega la sección 5c, en un solo salto y siempre con HTTPS.
<IfModule mod_dir.c>
  DirectorySlash Off
</IfModule>

# Todo el texto se sirve en UTF-8 (tildes y eñes correctas en HTML, .txt y .xml).
AddDefaultCharset utf-8

# ── 2. Tipos de contenido ─────────────────────────────────────────────────────
<IfModule mod_mime.c>
  AddType application/manifest+json      .webmanifest
  AddType text/javascript                .js .mjs
  AddType image/avif                     .avif
  AddType image/webp                     .webp
  AddType image/svg+xml                  .svg
  AddType font/woff2                     .woff2
  AddCharset utf-8 .css .js .mjs .json .webmanifest .xml .txt .svg
</IfModule>

# ── 3. Página de error ────────────────────────────────────────────────────────
# Astro genera dist/404.html (src/pages/404.astro). Responde con código 404 real.
ErrorDocument 404 /404.html

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # ── 4a. Redirecciones 301 de la web anterior ────────────────────────────────
  # Rutas de la versión anterior (aplicación de una sola página) hacia su
  # equivalente nuevo, en un solo salto. Aceptan la ruta con o sin barra
  # final y con .html. Van antes de forzar HTTPS: como ya apuntan a https://,
  # desde http:// también llegan a su destino en un solo 301.
  RewriteRule ^sobre-mi(/|\.html)?$        https://%{HTTP_HOST}/nosotros/            [R=301,L]
  RewriteRule ^servicios(/|\.html)?$       https://%{HTTP_HOST}/paginas-web-bogota/  [R=301,L]
  RewriteRule ^casos-de-exito(/|\.html)?$  https://%{HTTP_HOST}/proyectos/           [R=301,L]
  RewriteRule ^contacto\.html$             https://%{HTTP_HOST}/contacto/            [R=301,L]
  RewriteRule ^proyectos\.html$            https://%{HTTP_HOST}/proyectos/           [R=301,L]
  # /proyectos y /contacto (sin barra) los resuelve la regla 5c.
  # Páginas por sector retiradas el 2026-10-18 (sin menú por mercado) → empresas de servicios.
  RewriteRule ^paginas-web-(contadores|consultores|construccion)(/.*)?$  https://%{HTTP_HOST}/paginas-web-empresas-servicios/ [R=301,L]
  # Guía del agente de WhatsApp retirada el 2026-10-18 (la web no explica cómo se presta el servicio).
  RewriteRule ^recursos/agente-ia-whatsapp-business(/.*)?$  https://%{HTTP_HOST}/asistente-whatsapp-business/ [R=301,L]

  # ── 4b. Forzar HTTPS ────────────────────────────────────────────────────────
  # Redirige http:// a https:// con 301. La segunda condición evita bucles si
  # Hostinger (CDN o proxy) ya recibió la visita por HTTPS.
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !https [NC]
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L,NE]

  # Opcional, cuando tenga dominio propio: unificar sin "www".
  # Quite el # de las dos líneas siguientes si el dominio principal es sin www.
  # RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
  # RewriteRule ^ https://%1%{REQUEST_URI} [R=301,L,NE]

  # ── 5a. Archivos ocultos ────────────────────────────────────────────────────
  # Bloquea .git, .env y similares. Deja pasar /.well-known/ (certificados SSL).
  RewriteRule (^|/)\.(?!well-known/) - [F,L]

  # ── 5b. Sin "index.html" visible ────────────────────────────────────────────
  # /precios/index.html → /precios/ (evita contenido duplicado). Se mira la
  # petición original (THE_REQUEST) para no chocar con DirectoryIndex.
  RewriteCond %{THE_REQUEST} \s/+(.*/)?index\.html[\s?] [NC]
  RewriteRule ^ https://%{HTTP_HOST}/%1 [R=301,L,NE]

  # ── 5c. Barra final obligatoria ─────────────────────────────────────────────
  # El sitio usa trailingSlash 'always': /proyectos → /proyectos/, /contacto →
  # /contacto/. Solo para rutas sin extensión que no sean un archivo real.
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_URI} !^/\.well-known/
  RewriteCond %{REQUEST_URI} !\.[a-zA-Z0-9]{1,8}$
  RewriteCond %{REQUEST_URI} !/$
  RewriteRule ^(.*)$ https://%{HTTP_HOST}/$1/ [R=301,L,NE]

  # ── 5d. Marca de caché para archivos con huella ─────────────────────────────
  # Los archivos de /_astro/ llevan un hash en el nombre: si cambian, cambia el
  # nombre. La sección 7 les da un año de caché.
  RewriteRule ^_astro/ - [E=VRS_INMUTABLE:1]
</IfModule>

# ── 6. Compresión ─────────────────────────────────────────────────────────────
# LiteSpeed comprime por su cuenta (gzip y brotli). En Apache se usa brotli si el
# módulo existe y gzip (deflate) como respaldo; no se comprimen dos veces.
<IfModule mod_brotli.c>
  AddOutputFilterByType BROTLI_COMPRESS text/html text/plain text/css text/xml text/javascript application/javascript application/json application/ld+json application/manifest+json application/xml application/rss+xml image/svg+xml font/ttf font/otf
</IfModule>
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml text/javascript application/javascript application/json application/ld+json application/manifest+json application/xml application/rss+xml image/svg+xml font/ttf font/otf
</IfModule>

<IfModule mod_headers.c>
  # ── 7. Caché ──────────────────────────────────────────────────────────────
  # Por defecto, incluido el HTML de las URL de carpeta (/precios/): siempre se
  # pregunta al servidor si hay versión nueva (publicar un cambio se ve de
  # inmediato). El navegador reutiliza la copia si no cambió.
  Header set Cache-Control "public, max-age=0, must-revalidate"

  # Imágenes y fuentes (/img/, favicon, íconos): una semana, y se revalidan en
  # segundo plano el día siguiente.
  <FilesMatch "\.(png|jpe?g|webp|avif|gif|svg|ico|woff2?)$">
    Header set Cache-Control "public, max-age=604800, stale-while-revalidate=86400"
  </FilesMatch>

  # Archivos de rastreo y para IA: una hora.
  <FilesMatch "^(robots\.txt|llms(-full)?\.txt|sitemap.*\.xml|manifest\.webmanifest)$">
    Header set Cache-Control "public, max-age=3600"
  </FilesMatch>

  # Archivos con huella en /_astro/ (CSS, JS, fuentes, imágenes optimizadas):
  # un año, inmutables. Va después de la regla general para reemplazarla.
  Header set Cache-Control "public, max-age=31536000, immutable" env=VRS_INMUTABLE
  Header set Cache-Control "public, max-age=31536000, immutable" env=REDIRECT_VRS_INMUTABLE
  # Respaldo por nombre (por si el servidor no pasa la marca de la sección 5d):
  # Astro nombra estos archivos como nombre.HASH8.ext, p. ej. index.B1x_9aZq.css.
  # Va después del bloque de imágenes y fuentes para reemplazarlo en /_astro/.
  <FilesMatch "\.[A-Za-z0-9_-]{8}\.(css|js|mjs|woff2?|webp|avif|png|jpe?g|svg)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  # Los llms.txt son para asistentes de IA, no para la lista de resultados de Google.
  <FilesMatch "^llms(-full)?\.txt$">
    Header set X-Robots-Tag "noindex"
  </FilesMatch>

  # ── 8. Cabeceras de seguridad ─────────────────────────────────────────────
  # Impide que el navegador adivine tipos de archivo.
  Header always set X-Content-Type-Options "nosniff"
  # Solo se envía el dominio (no la ruta completa) a sitios externos.
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  # Bloquea funciones del dispositivo que el sitio no usa.
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
  # El sitio no se puede mostrar dentro de marcos de otros dominios (clickjacking).
  Header always set X-Frame-Options "SAMEORIGIN"
  # Obliga HTTPS durante un año. Cuando el dominio propio y todos sus
  # subdominios tengan HTTPS, puede agregar "; includeSubDomains".
  Header always set Strict-Transport-Security "max-age=31536000"
  # No anuncia la tecnología del servidor.
  Header unset X-Powered-By
  Header always unset X-Powered-By
</IfModule>
