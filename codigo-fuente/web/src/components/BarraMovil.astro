---
// Barra de acción fija inferior, solo en celular (<768 px).
// - Aparece al bajar ~40 % de la primera pantalla (centinela + IntersectionObserver).
// - Se oculta si el formulario de contacto (#formulario) está en pantalla o si
//   la persona está escribiendo en un campo (el teclado del celular la subiría).
// - Incluye su propio espaciador al final de la página para no tapar el pie.
// - Sin JavaScript queda siempre visible.
import Icono from './navegacion/Icono.astro';
import { CTA_PRINCIPAL, enlaceWhatsApp } from '@/data/sitio';

interface Props {
  /** Opcional: ruta actual. En /contacto/ el botón "Revisión gratuita" lleva a #formulario. */
  ruta?: string;
}

const normalizar = (valor: string) => {
  let r = valor.split(/[?#]/)[0] || '/';
  if (!r.endsWith('/')) r = `${r}/`;
  return r;
};
const ruta = normalizar(Astro.props.ruta ?? Astro.url.pathname);
const hrefRevision = ruta === normalizar(CTA_PRINCIPAL.href) ? '#formulario' : CTA_PRINCIPAL.href;
---
<div class="barra-espaciador" aria-hidden="true"></div>
<div class="barra-centinela" data-centinela-barra aria-hidden="true"></div>

<div class="barra-movil" data-barra-movil>
  <nav class="barra-movil__caja vidrio" aria-label="Contacto rápido">
    <a href={enlaceWhatsApp()} target="_blank" rel="noopener" class="boton boton-whatsapp barra-movil__boton">
      <Icono nombre="whatsapp" tamano={20} />
      WhatsApp
      <span class="sr-only"> (escribir a VRS Digital; se abre en una pestaña nueva)</span>
    </a>
    <a href={hrefRevision} class="boton boton-primario barra-movil__boton">
      <Icono nombre="revision" tamano={18} class="barra-movil__icono-opcional" />
      Revisión gratuita
    </a>
  </nav>
</div>

<script>
  const barra = document.querySelector<HTMLElement>('[data-barra-movil]');
  const centinela = document.querySelector('[data-centinela-barra]');

  if (barra && centinela && 'IntersectionObserver' in window) {
    let bajo = false;
    let formularioVisible = false;
    let escribiendo = false;

    const actualizar = () => {
      const visible = bajo && !formularioVisible && !escribiendo;
      barra.toggleAttribute('data-visible', visible);
      barra.inert = !visible; // oculta = fuera del orden de tabulación y del lector de pantalla
    };

    new IntersectionObserver(([e]) => {
      bajo = !e.isIntersecting && e.boundingClientRect.top < 0;
      actualizar();
    }).observe(centinela);

    // #formulario puede llegar después (isla hidratada): se busca hasta encontrarlo.
    const observarFormulario = (formulario: Element) =>
      new IntersectionObserver(([e]) => {
        formularioVisible = e.isIntersecting;
        actualizar();
      }).observe(formulario);
    const formulario = document.getElementById('formulario');
    if (formulario) observarFormulario(formulario);
    else {
      const espera = new MutationObserver(() => {
        const f = document.getElementById('formulario');
        if (f) {
          espera.disconnect();
          observarFormulario(f);
        }
      });
      espera.observe(document.body, { childList: true, subtree: true });
      window.setTimeout(() => espera.disconnect(), 15000);
    }

    const esCampo = (t: EventTarget | null) =>
      t instanceof HTMLElement && t.matches('input:not([type="checkbox"]):not([type="radio"]):not([type="submit"]):not([type="button"]), textarea, select, [contenteditable="true"]');
    document.addEventListener('focusin', (e) => {
      if (esCampo(e.target)) {
        escribiendo = true;
        actualizar();
      }
    });
    document.addEventListener('focusout', (e) => {
      if (esCampo(e.target)) {
        escribiendo = false;
        actualizar();
      }
    });

    actualizar();
  }
</script>

<style is:global>
  .barra-espaciador { height: calc(5.5rem + env(safe-area-inset-bottom)); background: var(--color-surface-lowest); }
  .barra-centinela { position: absolute; top: 40vh; top: 40svh; left: 0; width: 1px; height: 1px; pointer-events: none; }

  .barra-movil {
    position: fixed; inset-inline: 0; bottom: 0; z-index: 40; pointer-events: none;
    padding: 0 0.75rem max(0.75rem, env(safe-area-inset-bottom));
  }
  .barra-movil__caja {
    pointer-events: auto; display: grid; grid-template-columns: 1fr 1fr; gap: 0.5rem;
    max-width: 28rem; margin-inline: auto; padding: 0.375rem; border-radius: 1.25rem;
    box-shadow: 0 20px 40px rgb(0 0 0 / 0.45), inset 0 0 0 1px rgb(229 225 228 / 0.08);
  }
  .barra-movil__boton { min-height: 3rem; padding: 0.625rem 0.75rem; gap: 0.5rem; font-size: 0.9375rem; border-radius: 0.875rem; white-space: nowrap; }
  .barra-movil__boton svg { flex: none; }
  @media (max-width: 359.98px) { .barra-movil__icono-opcional { display: none; } }

  /* Con JS empieza oculta y entra deslizándose. */
  html.js .barra-movil {
    opacity: 0; transform: translateY(calc(100% + 0.5rem));
    transition: transform 0.5s var(--ease-out-expo), opacity 0.3s ease;
  }
  html.js .barra-movil:not([data-visible]) .barra-movil__caja { pointer-events: none; }
  html.js .barra-movil[data-visible] { opacity: 1; transform: none; }

  /* Pantallas bajas (celular acostado, zoom al 200 %): la barra taparía demasiado; el menú ya
     ofrece las mismas acciones. */
  @media (min-width: 768px), (max-height: 31rem) {
    .barra-espaciador, .barra-centinela, .barra-movil { display: none; }
  }
  @media (prefers-reduced-motion: reduce) {
    html.js .barra-movil { transform: none; transition: opacity 0.2s linear; }
  }
</style>
