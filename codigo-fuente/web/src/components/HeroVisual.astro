---
// ─────────────────────────────────────────────────────────────────────────────
//  Visual del hero: "ser encontrado y responder".
//  1. Pinta primero un PÓSTER SVG calculado al compilar con la misma geometría,
//     cámara y azar que la escena 3D (Escena3DGeometria.ts): mismo encuadre.
//  2. Cuando el navegador queda libre (load + requestIdleCallback) y el visual
//     está cerca de la pantalla, descarga three.js y monta la escena encima,
//     con una transición de opacidad. Sin React.
//  3. Con movimiento reducido, sin WebGL 2, en equipos de gama baja o con ahorro
//     de datos, el póster se queda (y three.js nunca se descarga).
//  Espacio reservado con aspect-ratio: CLS 0. No contiene encabezados.
// ─────────────────────────────────────────────────────────────────────────────
import {
  ANILLOS,
  CANTIDADES,
  CRISTAL as K,
  ENCUADRE,
  LADO_POSTER,
  LADO_REFERENCIA,
  alfaBurbuja,
  alfaEntrante,
  datosBurbujas,
  datosEntrantes,
  datosNodos,
  datosPolvo,
  distanciaCamara,
  icosaedro,
  posicionBurbuja,
  proyectar,
  puntoAnillo,
  suave,
  trayectoEntrante,
} from '@/components/islas/Escena3DGeometria';

interface Tarjeta {
  titulo: string;
  detalle: string;
}

interface Props {
  /** Descripción para lectores de pantalla (el visual completo es una imagen). */
  etiqueta?: string;
  /** Tarjeta de vidrio superior. false para ocultarla. */
  consulta?: Tarjeta | false;
  /** Tarjeta de vidrio inferior. false para ocultarla. */
  respuesta?: Tarjeta | false;
  /** false: solo póster, nunca descarga three.js. */
  escena?: boolean;
  /** Solo para pruebas: acepta WebGL por software (SwiftShader) y equipos de gama baja. */
  forzarEscena?: boolean;
  class?: string;
}

const {
  etiqueta = 'Ilustración: un núcleo de cristal recibe consultas que llegan desde Google y envía respuestas por WhatsApp, incluso a las 11:42 de la noche.',
  consulta = { titulo: 'Nueva consulta desde Google', detalle: '«contador tributario en Bogotá»' },
  respuesta = { titulo: 'Respuesta enviada', detalle: '11:42\u00a0p.\u00a0m. · fuera de horario' },
  escena = true,
  forzarEscena = false,
  class: clase,
} = Astro.props;

// ── Póster: cálculo al compilar (no llega JS al navegador) ──────────────────
type C3 = [number, number, number];
const uid = Math.random().toString(36).slice(2, 8);
const D = distanciaCamara(1);
const S = LADO_POSTER / LADO_REFERENCIA; // de px de referencia a unidades del SVG
const r1 = (n: number) => Math.round(n * 10) / 10;
const r3 = (n: number) => Math.round(n * 1000) / 1000;
const LAV: C3 = [192 / 255, 193 / 255, 1];
const VIO: C3 = [128 / 255, 131 / 255, 1];
const IND: C3 = [99 / 255, 102 / 255, 241 / 255];
const mezcla = (a: number, b: number, t: number) => a + (b - a) * t;
const mezcla3 = (a: C3, b: C3, t: number): C3 => [mezcla(a[0], b[0], t), mezcla(a[1], b[1], t), mezcla(a[2], b[2], t)];
const por = (a: C3, k: number): C3 => [a[0] * k, a[1] * k, a[2] * k];
const suma = (a: C3, b: C3): C3 => [a[0] + b[0], a[1] + b[1], a[2] + b[2]];
const punto = (a: C3, b: C3) => a[0] * b[0] + a[1] * b[1] + a[2] * b[2];
const normal = (a: C3): C3 => por(a, 1 / Math.hypot(...a));
const rgb = (c: C3) => '#' + c.map((v) => Math.round(Math.min(1, Math.max(0, v)) * 255).toString(16).padStart(2, '0')).join('');
/** Color premultiplicado (luz aditiva) a color + opacidad para mix-blend-mode: plus-lighter. */
const luz = (c: C3) => {
  const a = Math.min(1, Math.max(c[0], c[1], c[2], 1e-4));
  return { color: rgb(por(c, 1 / a)), opacidad: r3(a) };
};
const xy = (p: { x: number; y: number }) => `${Math.round(p.x)} ${Math.round(p.y)}`;
const ruta = (pts: C3[]) => pts.map((p, i) => `${i ? 'L' : 'M'}${xy(proyectar(p))}`).join('');

// Halo (plano en z = -1.4, mismo sombreador que FRAG_HALO con pulso 0 y tiempo 0).
const fHalo = D / (D + 1.4);
const radioHalo = 3.7 * fHalo * (LADO_POSTER / 2 / ENCUADRE);
const paradasHalo = Array.from({ length: 26 }, (_, i) => {
  const d = i / 25;
  const g = Math.exp(-d * d * 9) * 0.2 + Math.exp(-d * d * 40) * 0.16;
  const onda = Math.exp(-(((d - 0.3) * 34) ** 2)) * 0.16;
  return { d, ...luz(por(mezcla3(IND, VIO, Math.exp(-d * d * 14)), g + onda)) };
});

// Cristal: icosaedro subdividido, normales planas, mismo "entorno" que FRAG_CRISTAL (pulso 0).
const franjaDir = normal([0.62, 0.78, 0]);
/** [color, intensidad de franjas] como en el sombreador. */
const entorno = (d: C3): [C3, number] => {
  const y = d[1] * 0.5 + 0.5;
  const base = mezcla3(por(IND, K.baseOscura), por(VIO, K.baseClara), suave(0.05, 1, y));
  const franja = suave(0.955, 0.995, 1 - Math.abs(punto(d, franjaDir) - 0.2));
  const franja2 = suave(0.982, 1, 1 - Math.abs(d[0] + 0.58));
  const intensidad = franja * K.franja + franja2 * K.franja2;
  return [suma(base, por(LAV, intensidad)), intensidad];
};
const reflejar = (I: C3, N: C3): C3 => suma(I, por(N, -2 * punto(N, I)));
const refractar = (I: C3, N: C3, eta: number): C3 => {
  const c = punto(N, I);
  const k = 1 - eta * eta * (1 - c * c);
  return k < 0 ? [0, 0, 0] : suma(por(I, eta), por(N, -(eta * c + Math.sqrt(k))));
};
const sombrearCara = (N: C3, centro: C3, frente: boolean) => {
  const V = normal([-centro[0], -centro[1], D - centro[2]]);
  const n = frente ? N : por(N, -1);
  const ndv = Math.min(1, Math.max(0, punto(n, V)));
  const fres = Math.pow(1 - ndv, K.potenciaFresnel);
  const [cT, lT] = entorno(refractar(por(V, -1), n, 0.72));
  const [cR, lR] = entorno(reflejar(por(V, -1), n));
  const kT = (1 - fres) * K.refraccion;
  const kR = K.reflejo + fres * K.reflejoFresnel;
  let col = por(suma(suma(por(cT, kT), por(cR, kR)), por(LAV, fres * K.bordeFresnel)), 0.88);
  col = por(col, 1 / Math.max(1, ...col));
  let alfa = Math.min(K.alfaMax, Math.max(0, K.alfaBase + fres * K.alfaFresnel + (lT * kT + lR * kR) * K.alfaBrillo));
  if (!frente) alfa *= K.alfaAtras;
  return { color: rgb(col), opacidad: r3(alfa) };
};
const caras = icosaedro(1).map((tri) => {
  const centro = por(suma(suma(tri[0], tri[1]), tri[2]), 1 / 3) as C3;
  const e1 = suma(tri[1], por(tri[0], -1));
  const e2 = suma(tri[2], por(tri[0], -1));
  const N = normal([e1[1] * e2[2] - e1[2] * e2[1], e1[2] * e2[0] - e1[0] * e2[2], e1[0] * e2[1] - e1[1] * e2[0]]);
  const haciaCamara = punto(N, normal([-centro[0], -centro[1], D - centro[2]])) > 0;
  return { tri, centro, N, haciaCamara, d: ruta(tri) + 'Z' };
});
const carasAtras = caras.filter((c) => !c.haciaCamara).map((c) => ({ d: c.d, ...sombrearCara(c.N, c.centro, false) }));
const carasFrente = caras.filter((c) => c.haciaCamara).map((c) => ({ d: c.d, ...sombrearCara(c.N, c.centro, true) }));

// Aristas únicas, más tenues las de atrás (FRAG_ARISTA): se agrupan por intensidad.
const aristas = new Map<string, [C3, C3]>();
for (const { tri } of caras) {
  for (const [a, b] of [[tri[0], tri[1]], [tri[1], tri[2]], [tri[2], tri[0]]] as [C3, C3][]) {
    const k = [a, b].map((p) => p.map((v) => v.toFixed(4)).join(',')).sort().join('|');
    aristas.set(k, [a, b]);
  }
}
const gruposAristas = [0, 1, 2, 3].map(() => ({ d: '', i: 0 }));
for (const [a, b] of aristas.values()) {
  const cerca = suave(-0.9, 0.9, (a[2] + b[2]) / 2);
  const g = Math.min(3, Math.floor(cerca * 4));
  gruposAristas[g].d += ruta([a, b]);
}
gruposAristas.forEach((g, i) => (g.i = r3(mezcla(K.aristaAtras, K.aristaFrente, (i + 0.5) / 4))));

// Corazón (FRAG_CORAZON con pulso 0): degradado radial.
const radioCorazon = K.radioCorazon * (LADO_POSTER / 2 / ENCUADRE) * (D / Math.sqrt(D * D - K.radioCorazon ** 2));
const paradasCorazon = Array.from({ length: 9 }, (_, i) => {
  const rho = i / 8;
  const ndv = Math.sqrt(Math.max(0, 1 - rho * rho));
  return { d: rho, ...luz(por(mezcla3(VIO, [0.96, 0.96, 1], Math.pow(ndv, 5)), Math.pow(ndv, 2.6) * K.corazon)) };
});

// Anillos: mitad trasera y delantera (más brillante), cola del cometa y nodos.
const anillos = ANILLOS.map((a, i) => {
  const muestras = 64;
  const pts: C3[] = Array.from({ length: muestras + 1 }, (_, k) => {
    const th = (k / muestras) * Math.PI * 2;
    return puntoAnillo(i, Math.cos(th) * a.radio, Math.sin(th) * a.radio);
  });
  const atras: C3[][] = [];
  const delante: C3[][] = [];
  let tramo: C3[] = [];
  let lado: boolean | null = null;
  for (const p of pts) {
    const esDelante = p[2] >= 0;
    if (lado !== null && esDelante !== lado) {
      tramo.push(p);
      (lado ? delante : atras).push(tramo);
      tramo = [];
    }
    tramo.push(p);
    lado = esDelante;
  }
  if (tramo.length > 1) (lado ? delante : atras).push(tramo);
  // Cometa: a = fract(u + desfase); cabeza en u = 1 - desfase; cola hacia ángulos menores.
  const thCabeza = (1 - a.desfase) * Math.PI * 2;
  const cola: C3[] = Array.from({ length: 25 }, (_, k) => {
    const th = thCabeza - (1 - k / 24) * Math.PI * 2 * 0.32;
    return puntoAnillo(i, Math.cos(th) * a.radio, Math.sin(th) * a.radio);
  });
  const cabeza = cola[cola.length - 1];
  const cercaCabeza = suave(-2.4, 2.4, cabeza[2]);
  return {
    atras: atras.map(ruta).join(''),
    delante: delante.map(ruta).join(''),
    cola: ruta(cola),
    desde: proyectar(cola[0]),
    hasta: proyectar(cabeza),
    cabeza: proyectar(cabeza),
    brilloCabeza: r3(mezcla(0.35, 1, cercaCabeza)),
  };
});
const nodos = datosNodos().flatMap(({ pos, datos }, i) =>
  Array.from({ length: pos.length / 3 }, (_, k) => {
    const p = proyectar(puntoAnillo(i, pos[k * 3], pos[k * 3 + 1]));
    const alfa = 0.75 + 0.25 * Math.sin(datos[k * 2] * 30);
    return { ...p, r: r1(datos[k * 2 + 1] * S * p.escala * 0.5), alfa: r3(alfa) };
  }),
);

// Búsquedas que llegan (t = 0): estela y cabeza.
const N = CANTIDADES.computador.entrantes;
const ent = datosEntrantes(N);
const entrantes = Array.from({ length: N }, (_, k) => {
  const dir = ent.dir.subarray(k * 3, k * 3 + 3);
  const [fase, , giro, tam] = ent.datos.subarray(k * 4, k * 4 + 4);
  const p = fase;
  const cabeza = trayectoEntrante(dir, giro, p);
  const cola = trayectoEntrante(dir, giro, Math.max(p - 0.075, 0));
  const cerca = suave(-3, 3, cabeza[2]);
  const alfa = alfaEntrante(p) * mezcla(0.45, 1, cerca);
  const ph = proyectar(cabeza);
  return {
    cabeza: ph,
    cola: proyectar(cola),
    r: r1((tam * S * mezcla(0.7, 1.25, p) * ph.escala) / 2),
    alfa: r3(alfa),
    alfaEstela: r3(alfaEntrante(p) * mezcla(0.4, 1, cerca) * 0.75),
    claro: p > 0.5,
  };
}).filter((e) => e.alfa > 0.04);

// Respuestas que salen (t = 0).
const M = CANTIDADES.computador.burbujas;
const bur = datosBurbujas(M);
const burbujas = Array.from({ length: M }, (_, k) => {
  const dir = bur.dir.subarray(k * 3, k * 3 + 3);
  const [fase, , tam, deriva] = bur.datos.subarray(k * 4, k * 4 + 4);
  const p = fase % 1;
  const e = 1 - Math.pow(1 - p, 2.2);
  const pr = proyectar(posicionBurbuja(dir, deriva, p));
  const diametro = tam * S * mezcla(0.45, 1.5, e) * pr.escala;
  return { ...pr, r: r1(diametro * 0.43), grosor: r1(Math.max(0.7, diametro * 0.07)), alfa: r3(alfaBurbuja(p)) };
}).filter((b) => b.alfa > 0.04);

// Polvo (los primeros 70, comunes a celular y computador).
const pol = datosPolvo(70);
const polvo = Array.from({ length: 70 }, (_, k) => {
  const p = proyectar(pol.pos.subarray(k * 3, k * 3 + 3));
  return { ...p, r: r1(Math.max(0.5, pol.datos[k * 2 + 1] * S * p.escala * 0.32)), alfa: r3(0.22 + 0.2 * Math.sin(pol.datos[k * 2] * 30)) };
}).filter((p) => p.alfa > 0.06 && p.x > 4 && p.x < 596 && p.y > 4 && p.y < 596);

// ── Póster en texto (set:html: sin atributos de alcance en cada nodo, HTML más liviano) ──
const n0 = (n: number) => String(Math.round(n));
const n1 = (n: number) => String(Math.round(n * 10) / 10);
const n2 = (n: number) => String(Math.round(n * 100) / 100);
const LUZ = ' style="mix-blend-mode:plus-lighter"';
const paradas = (lista: { d: number; color: string; opacidad: number }[]) =>
  lista.map((p) => `<stop offset="${n2(p.d)}" stop-color="${p.color}" stop-opacity="${n2(p.opacidad)}"/>`).join('');
const degradadoPunto = (id: string, centro: string, color: string) =>
  `<radialGradient id="${id}"><stop offset="0" stop-color="${centro}"/><stop offset=".2" stop-color="${color}" stop-opacity=".8"/>` +
  `<stop offset=".4" stop-color="${color}" stop-opacity=".42"/><stop offset=".6" stop-color="${color}" stop-opacity=".12"/>` +
  `<stop offset="1" stop-color="${color}" stop-opacity="0"/></radialGradient>`;
const pa = `hv-pa-${uid}`;
const pb = `hv-pb-${uid}`;

// Estelas agrupadas por color y opacidad (pocas rutas en lugar de una línea por partícula).
const estelas = new Map<string, string>();
for (const e of entrantes) {
  const o = Math.round(e.alfaEstela * 0.55 * 20) / 20;
  if (o < 0.05) continue;
  const k = `${e.claro ? '#c0c1ff' : '#8083ff'}|${o}`;
  estelas.set(k, (estelas.get(k) ?? '') + `M${n1(e.cola.x)} ${n1(e.cola.y)}L${n1(e.cabeza.x)} ${n1(e.cabeza.y)}`);
}

/** Une caras con el mismo color (cuantizado) en una sola ruta. */
const agrupar = (lista: { d: string; color: string; opacidad: number }[]) => {
  const grupos = new Map<string, string>();
  for (const c of lista) {
    const color = '#' + [1, 3, 5].map((i) => Math.min(255, Math.round(parseInt(c.color.slice(i, i + 2), 16) / 6) * 6).toString(16).padStart(2, '0')).join('');
    const k = `${color}|${Math.round(c.opacidad * 50) / 50}`;
    grupos.set(k, (grupos.get(k) ?? '') + c.d);
  }
  return [...grupos].map(([k, d]) => {
    const [color, o] = k.split('|');
    return `<path d="${d}" fill="${color}" fill-opacity="${o}"/>`;
  });
};

const poster = [
  '<defs>',
  `<radialGradient id="hv-halo-${uid}">${paradas(paradasHalo)}</radialGradient>`,
  `<radialGradient id="hv-corazon-${uid}">${paradas(paradasCorazon)}</radialGradient>`,
  degradadoPunto(pa, '#e4e4ff', '#c0c1ff'),
  degradadoPunto(pb, '#d6d7ff', '#8083ff'),
  ...anillos.map(
    (a, i) =>
      `<linearGradient id="hv-cometa-${i}-${uid}" gradientUnits="userSpaceOnUse" x1="${n1(a.desde.x)}" y1="${n1(a.desde.y)}" x2="${n1(a.hasta.x)}" y2="${n1(a.hasta.y)}">` +
      `<stop offset="0" stop-color="#8083ff" stop-opacity="0"/><stop offset=".7" stop-color="#a5a7ff" stop-opacity="${n2(0.45 * a.brilloCabeza)}"/>` +
      `<stop offset="1" stop-color="#e8e8ff" stop-opacity="${n2(0.95 * a.brilloCabeza)}"/></linearGradient>`,
  ),
  '</defs>',
  // Halo y polvo
  `<g${LUZ}><circle cx="300" cy="300" r="${n0(radioHalo)}" fill="url(#hv-halo-${uid})"/><g fill="#c0c1ff">`,
  ...polvo.map((p) => `<circle cx="${n0(p.x)}" cy="${n0(p.y)}" r="${n1(p.r)}" opacity="${n1(p.alfa)}"/>`),
  '</g></g>',
  // Cristal: caras traseras, corazón, caras delanteras, aristas
  ...agrupar(carasAtras),
  `<circle${LUZ} cx="300" cy="300" r="${n1(radioCorazon)}" fill="url(#hv-corazon-${uid})"/>`,
  ...agrupar(carasFrente),
  `<g${LUZ} fill="none" stroke="#c0c1ff" stroke-width=".9" stroke-linejoin="round">`,
  ...gruposAristas.filter((g) => g.d).map((g) => `<path d="${g.d}" stroke-opacity="${n2(g.i)}"/>`),
  '</g>',
  // Anillos, cometas y nodos
  `<g${LUZ} fill="none" stroke-linecap="round">`,
  ...anillos.map(
    (a, i) =>
      `<path d="${a.atras}" stroke="#8083ff" stroke-opacity=".09" stroke-width="1.3"/>` +
      `<path d="${a.delante}" stroke="#8083ff" stroke-opacity=".19" stroke-width="1.5"/>` +
      `<path d="${a.cola}" stroke="url(#hv-cometa-${i}-${uid})" stroke-width="1.8"/>`,
  ),
  `<g stroke="none" fill="url(#${pa})">`,
  ...anillos.map((a) => `<circle cx="${n1(a.cabeza.x)}" cy="${n1(a.cabeza.y)}" r="5" opacity="${n2(a.brilloCabeza)}"/>`),
  ...nodos.map((n) => `<circle cx="${n0(n.x)}" cy="${n0(n.y)}" r="${n1(n.r)}" opacity="${n1(n.alfa)}"/>`),
  '</g></g>',
  // Búsquedas que llegan
  `<g${LUZ} fill="none" stroke-width=".8" stroke-linecap="round">`,
  ...[...estelas].map(([k, d]) => {
    const [color, o] = k.split('|');
    return `<path d="${d}" stroke="${color}" stroke-opacity="${o}"/>`;
  }),
  '</g>',
  ...[true, false].map(
    (claro) =>
      `<g${LUZ} fill="url(#${claro ? pa : pb})">` +
      entrantes
        .filter((e) => e.claro === claro)
        .map((e) => `<circle cx="${n0(e.cabeza.x)}" cy="${n0(e.cabeza.y)}" r="${n1(e.r)}" opacity="${n1(e.alfa)}"/>`)
        .join('') +
      '</g>',
  ),
  // Respuestas que salen
  `<g${LUZ} fill="#c0c1ff" stroke="#c0c1ff">`,
  ...burbujas.map(
    (b) => `<circle cx="${n1(b.x)}" cy="${n1(b.y)}" r="${n1(b.r)}" fill-opacity="${n2(b.alfa * 0.05)}" stroke-opacity="${n2(b.alfa * 0.8)}" stroke-width="${n1(b.grosor)}"/>`,
  ),
  '</g>',
].join('');
---

<div
  class:list={['hero-visual', clase]}
  data-hero-visual
  data-escena={escena ? '' : undefined}
  data-escena-forzar={forzarEscena ? '' : undefined}
  data-estado="poster"
  role="img"
  aria-label={etiqueta}
>
  <div class="hv-ambiente" aria-hidden="true"></div>

  <svg class="hv-poster" viewBox={`0 0 ${LADO_POSTER} ${LADO_POSTER}`} aria-hidden="true" focusable="false" set:html={poster} />

  <div class="hv-lienzo" data-hero-lienzo aria-hidden="true"></div>

  {
    consulta && (
      <div class="hv-ancla hv-ancla--consulta" data-parallax="-0.05" aria-hidden="true">
        <div class="hv-entrada">
          <div class="hv-tarjeta">
            <span class="hv-icono hv-icono--busqueda">
              <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="11" cy="11" r="7" />
                <path d="m20 20-3.5-3.5" />
              </svg>
            </span>
            <span class="hv-textos">
              <span class="hv-titulo">{consulta.titulo}</span>
              <span class="hv-detalle">{consulta.detalle}</span>
            </span>
          </div>
        </div>
      </div>
    )
  }
  {
    respuesta && (
      <div class="hv-ancla hv-ancla--respuesta" data-parallax="0.07" aria-hidden="true">
        <div class="hv-entrada">
          <div class="hv-tarjeta">
            <span class="hv-icono hv-icono--respuesta">
              <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
                <path d="M18 6 7 17l-5-5" />
                <path d="m22 10-7.5 7.5L13 16" />
              </svg>
            </span>
            <span class="hv-textos">
              <span class="hv-titulo">{respuesta.titulo}</span>
              <span class="hv-detalle">
                <span class="hv-en-linea" />
                {respuesta.detalle}
              </span>
            </span>
          </div>
        </div>
      </div>
    )
  }
</div>

<style>
  .hero-visual {
    position: relative;
    width: 100%;
    aspect-ratio: 1 / 1;
    isolation: isolate;
  }

  /* Luz ambiente muy suave para fundir el visual con la página (dentro de la caja: sin desbordar). */
  .hv-ambiente {
    position: absolute;
    inset: 0;
    z-index: -1;
    pointer-events: none;
    background:
      radial-gradient(closest-side at 50% 50%, rgb(99 102 241 / 0.16), rgb(99 102 241 / 0.05) 55%, transparent 100%),
      radial-gradient(closest-side at 62% 38%, rgb(192 193 255 / 0.06), transparent 70%);
  }

  .hv-poster,
  .hv-lienzo {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    transition: opacity 1.2s var(--ease-out-expo);
  }
  .hv-lienzo {
    opacity: 0;
  }
  .hero-visual[data-estado='lista'] .hv-lienzo {
    opacity: 1;
  }
  .hero-visual[data-estado='lista'] .hv-poster {
    opacity: 0;
  }

  /* ── Tarjetas de vidrio ── */
  .hv-ancla {
    position: absolute;
    z-index: 2;
    max-width: min(19rem, 80%);
    pointer-events: none;
  }
  .hv-ancla--consulta {
    top: 4%;
    left: 0;
  }
  .hv-ancla--respuesta {
    bottom: 5%;
    right: 0;
  }
  @media (min-width: 1024px) {
    .hv-ancla--consulta {
      top: 9%;
      left: -5%;
    }
    .hv-ancla--respuesta {
      bottom: 9%;
      right: -3%;
    }
  }

  .hv-tarjeta {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.75rem 1rem 0.75rem 0.75rem;
    border-radius: 1rem;
    background: rgb(53 52 55 / 0.55);
    -webkit-backdrop-filter: blur(20px) saturate(150%);
    backdrop-filter: blur(20px) saturate(150%);
    box-shadow:
      inset 0 1px 0 rgb(255 255 255 / 0.07),
      inset 0 0 0 1px rgb(192 193 255 / 0.1),
      0 20px 40px rgb(0 0 0 / 0.4);
  }
  .hv-icono {
    display: inline-flex;
    flex: none;
    align-items: center;
    justify-content: center;
    width: 2.25rem;
    height: 2.25rem;
    border-radius: 0.75rem;
  }
  .hv-icono--busqueda {
    background: linear-gradient(135deg, #c0c1ff, #6366f1);
    color: var(--color-on-primary);
  }
  .hv-icono--respuesta {
    background: rgb(74 222 128 / 0.14);
    color: var(--color-online);
    box-shadow: inset 0 0 0 1px rgb(74 222 128 / 0.22);
  }
  .hv-textos {
    display: flex;
    min-width: 0;
    flex-direction: column;
    gap: 0.125rem;
  }
  .hv-titulo {
    font-family: var(--font-display);
    font-size: 0.875rem;
    font-weight: 600;
    line-height: 1.25;
    letter-spacing: -0.01em;
    color: var(--color-ink);
  }
  .hv-detalle {
    display: flex;
    align-items: center;
    gap: 0.375rem;
    font-size: 0.8125rem;
    line-height: 1.3;
    color: var(--color-ink-soft);
  }
  .hv-en-linea {
    width: 0.4375rem;
    height: 0.4375rem;
    flex: none;
    border-radius: 9999px;
    background: var(--color-online);
    box-shadow: 0 0 0 3px rgb(74 222 128 / 0.18);
  }

  @media (max-width: 380px) {
    .hv-tarjeta {
      gap: 0.625rem;
      padding: 0.625rem 0.75rem 0.625rem 0.625rem;
    }
    .hv-titulo {
      font-size: 0.8125rem;
    }
    .hv-detalle {
      font-size: 0.75rem;
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    /* "backwards" y no "both": una animación de opacidad que queda activa convierte a
       .hv-entrada en raíz del fondo y el backdrop-filter de la tarjeta deja de difuminar. */
    .hv-entrada {
      animation: hv-entrar 1s var(--ease-out-expo) backwards;
      animation-delay: 0.35s;
    }
    .hv-ancla--respuesta .hv-entrada {
      animation-delay: 0.7s;
    }
    .hv-tarjeta {
      animation: hv-flotar 7s ease-in-out infinite;
    }
    .hv-ancla--respuesta .hv-tarjeta {
      animation-duration: 8s;
      animation-delay: -3s;
    }
  }
  @keyframes hv-entrar {
    from {
      opacity: 0;
      translate: 0 14px;
    }
  }
  @keyframes hv-flotar {
    50% {
      translate: 0 -6px;
    }
  }
</style>

<script>
  // Cargador propio: póster primero; la escena (three.js) solo cuando el navegador está libre
  // y el visual está cerca de la pantalla. Sin React.
  import { motivoParaPoster, tieneWebGL2Real } from '@/components/islas/Escena3DSoporte';
  import type { ControlEscena } from '@/components/islas/Escena3DMotor';
  import '@/scripts/desplazamiento';

  const cuandoInactivo = (fn: () => void) => {
    const programar = () => {
      if ('requestIdleCallback' in window) requestIdleCallback(fn, { timeout: 2500 });
      else setTimeout(fn, 300);
    };
    if (document.readyState === 'complete') programar();
    else window.addEventListener('load', programar, { once: true });
  };

  const cuandoCerca = (el: Element, fn: () => void) => {
    const io = new IntersectionObserver(
      (entradas) => {
        if (entradas.some((e) => e.isIntersecting)) {
          io.disconnect();
          fn();
        }
      },
      { rootMargin: '200px 0px' },
    );
    io.observe(el);
  };

  document.querySelectorAll<HTMLElement>('[data-hero-visual][data-escena]').forEach((visual) => {
    const forzar = visual.hasAttribute('data-escena-forzar');
    const motivo = motivoParaPoster({ forzar });
    const capa = visual.querySelector<HTMLElement>('[data-hero-lienzo]');
    if (motivo || !capa) {
      visual.dataset.motivo = motivo ?? 'sin-capa';
      return;
    }

    let control: ControlEscena | undefined;
    const alPoster = (razon: string) => {
      visual.dataset.estado = 'poster';
      visual.dataset.motivo = razon;
    };

    const montar = async () => {
      // Sin GPU real (dibujo por software): se queda el póster y three.js no se descarga.
      if (!tieneWebGL2Real({ forzar })) {
        visual.dataset.motivo = 'sin-webgl';
        return;
      }
      visual.dataset.estado = 'cargando';
      const t0 = performance.now();
      try {
        const { montarEscena } = await import('@/components/islas/Escena3DMotor');
        const descarga = Math.round(performance.now() - t0);
        control = await montarEscena(capa, { forzar, alPerderContexto: () => alPoster('contexto-perdido') });
        control.metricas.tramos.descargaEImportacion = descarga;
        requestAnimationFrame(() => (visual.dataset.estado = 'lista'));
        visual.dispatchEvent(new CustomEvent('escena3d:lista', { detail: control.metricas, bubbles: true }));
      } catch {
        alPoster('error');
      }
    };

    cuandoInactivo(() => cuandoCerca(visual, montar));

    // Si la persona activa "reducir movimiento" con la página abierta, vuelve el póster.
    const reducido = window.matchMedia('(prefers-reduced-motion: reduce)');
    reducido.addEventListener('change', () => {
      if (!reducido.matches || !control) return;
      control.destruir();
      control = undefined;
      alPoster('movimiento-reducido');
    });
  });
</script>
