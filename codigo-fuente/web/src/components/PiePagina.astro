---
// Pie de página: marca y propuesta, contacto (NAP idéntico a sitio.ts), aval
// MinTIC, mapa del sitio y nota legal. Con `compacto` (la página ya cierra con BandaCta)
// no repite el lema grande, los botones ni la marca de agua: solo contacto, aval y enlaces. En celular, las columnas del mapa se
// pliegan con <details>, en dos columnas; desde 768 px se muestran abiertas (script en línea,
// sin salto de diseño). Compacto en computador: marca y mapa del sitio (2 x 2) a la izquierda y
// contacto a la derecha, sin columnas vacías.
import Marca from './navegacion/Marca.astro';
import Icono from './navegacion/Icono.astro';
import type { NombreIcono } from './navegacion/iconos';
import { SITIO, CONTACTO, FUNDADOR, AVAL, MENU, SERVICIOS, CTA_PRINCIPAL, enlaceWhatsApp } from '@/data/sitio';

interface Props {
  /** Opcional: ruta actual para marcar el enlace activo. Si falta, se usa la URL de la página. */
  ruta?: string;
  /** true si la página termina con BandaCta (Base.astro, pieCompacto). */
  compacto?: boolean;
}
const { compacto = false } = Astro.props;

const normalizar = (valor: string) => {
  let r = valor.split(/[?#]/)[0] || '/';
  if (!r.startsWith('/')) r = `/${r}`;
  if (!r.endsWith('/')) r = `${r}/`;
  return r;
};
const ruta = normalizar(Astro.props.ruta ?? Astro.url.pathname);
const actual = (href: string) => (normalizar(href) === ruta ? 'page' : undefined);

type Enlace = { nombre: string; href: string };
const empresa: Enlace[] = [
  ...(MENU as readonly { nombre: string; href: string; hijos?: unknown }[])
    .filter((i) => !i.hijos)
    .map((i) => ({ nombre: i.nombre, href: i.href })),
  { nombre: 'Contacto', href: CTA_PRINCIPAL.href },
];
const columnas: { titulo: string; enlaces: Enlace[] }[] = [
  { titulo: 'Servicios', enlaces: SERVICIOS.map((s) => ({ nombre: s.nombre, href: `/${s.slug}/` })) },
  { titulo: 'Empresa', enlaces: empresa },
  {
    titulo: 'Legal',
    enlaces: [
      { nombre: 'Política de privacidad', href: '/politica-de-privacidad/' },
      { nombre: 'Términos y condiciones', href: '/terminos/' },
    ],
  },
];

const redes: { icono: NombreIcono; href: string; etiqueta: string }[] = [
  { icono: 'instagram', href: CONTACTO.redes.instagram, etiqueta: `${SITIO.nombre} en Instagram` },
  { icono: 'facebook', href: CONTACTO.redes.facebook, etiqueta: `${SITIO.nombre} en Facebook` },
  { icono: 'linkedin', href: CONTACTO.redes.linkedin, etiqueta: `${FUNDADOR.nombreCorto}, fundador de ${SITIO.nombre}, en LinkedIn` },
  { icono: 'github', href: CONTACTO.redes.github, etiqueta: `Proyectos de ${SITIO.nombre} en GitHub` },
];

const [esloganA, ...esloganB] = SITIO.eslogan.split('. ');
const nuevaPestana = ' (se abre en una pestaña nueva)';
const anio = new Date().getFullYear();
---
<footer class:list={['pie', compacto && 'pie--compacto']}>
  <span class="pie-luz" aria-hidden="true"></span>

  <div class="contenedor pie-contenido">
    <div class="pie-portada">
      <div class="pie-columna-marca">
        <a href="/" class="pie-marca" aria-current={actual('/')}>
          <Marca alto={40} inmediata={false} />
          <span class="sr-only">: ir a la página de inicio</span>
        </a>
        {
          !compacto && (
            <p class="pie-eslogan">
              <span>{esloganB.length ? `${esloganA}.` : esloganA}</span>
              {esloganB.length > 0 && <span class="degradado-texto">{esloganB.join('. ')}</span>}
            </p>
          )
        }
        <p class="pie-propuesta">{SITIO.propuesta}</p>
        {
          !compacto && (
        <div class="pie-ctas">
          <a href={CTA_PRINCIPAL.href} class="boton boton-primario">
            {CTA_PRINCIPAL.texto}
            <Icono nombre="flecha-derecha" tamano={18} />
          </a>
          <a href={enlaceWhatsApp()} target="_blank" rel="noopener" class="boton boton-secundario">
            <Icono nombre="whatsapp" tamano={20} class="icono-whatsapp" />
            Escribir por WhatsApp
            <span class="sr-only">{nuevaPestana}</span>
          </a>
        </div>
          )
        }
      </div>

      <div class="pie-columna-contacto">
        <div class="pie-tarjeta">
          <h2 class="etiqueta">Contacto directo</h2>
          <address class="pie-direccion">
            <p class="pie-nombre">{SITIO.nombre}</p>
            <a href={enlaceWhatsApp()} target="_blank" rel="noopener" class="pie-dato">
              <span class="pie-dato__icono pie-verde"><Icono nombre="whatsapp" tamano={20} /></span>
              <span class="pie-dato__textos">
                <span class="pie-dato__etiqueta">WhatsApp</span>
                <span class="pie-dato__valor">{CONTACTO.whatsappVisible}</span>
              </span>
              <span class="sr-only">{nuevaPestana}</span>
            </a>
            <a href={`mailto:${CONTACTO.correo}`} class="pie-dato">
              <span class="pie-dato__icono"><Icono nombre="correo" tamano={20} /></span>
              <span class="pie-dato__textos">
                <span class="pie-dato__etiqueta">Correo</span>
                <span class="pie-dato__valor">{CONTACTO.correo}</span>
              </span>
            </a>
            <div class="pie-dato">
              <span class="pie-dato__icono"><Icono nombre="ubicacion" tamano={20} /></span>
              <span class="pie-dato__textos">
                <span class="pie-dato__etiqueta">Ubicación</span>
                <span class="pie-dato__valor">{SITIO.ciudad}, Colombia</span>
              </span>
            </div>
            <div class="pie-dato">
              <span class="pie-dato__icono"><Icono nombre="reloj" tamano={20} /></span>
              <span class="pie-dato__textos">
                <span class="pie-dato__etiqueta">Horario</span>
                <span class="pie-dato__valor">{CONTACTO.horario}</span>
              </span>
            </div>
          </address>

          <ul class="pie-redes" aria-label="Redes sociales">
            {
              redes.map((red) => (
                <li>
                  <a href={red.href} target="_blank" rel="noopener" class="pie-red" aria-label={`${red.etiqueta}${nuevaPestana}`}>
                    <Icono nombre={red.icono} tamano={20} />
                  </a>
                </li>
              ))
            }
          </ul>
        </div>

        <a href={AVAL.enlace} target="_blank" rel="noopener" class="pie-aval">
          <span class="pie-aval__sello"><Icono nombre="insignia" tamano={24} /></span>
          <span class="pie-aval__textos">
            <span class="pie-aval__titulo">{AVAL.titulo}</span>
            <span class="pie-aval__texto"><span class="pie-aval__ver">Ver verificación en Cercia</span></span>
          </span>
          <Icono nombre="flecha-diagonal" tamano={18} class="pie-aval__flecha" />
          <span class="sr-only">{nuevaPestana}</span>
        </a>
      </div>
    </div>

    <nav id="navegacion-pie" class="pie-nav" aria-label="Mapa del sitio">
      {
        columnas.map((col) => (
          <details class="pie-grupo" data-pie-grupo>
            <summary class="pie-grupo__resumen">
              <h2 class="pie-grupo__titulo">{col.titulo}</h2>
              <Icono nombre="flecha-abajo" tamano={18} class="pie-grupo__flecha" />
            </summary>
            <ul class="pie-grupo__lista">
              {col.enlaces.map((e) => (
                <li>
                  <a href={e.href} class="pie-enlace" aria-current={actual(e.href)}>
                    {e.nombre}
                  </a>
                </li>
              ))}
            </ul>
          </details>
        ))
      }
    </nav>
    <script is:inline>
      // Desde 768 px las columnas quedan abiertas y su título deja de ser un control.
      (function () {
        var mq = window.matchMedia('(min-width: 768px)');
        var grupos = document.querySelectorAll('[data-pie-grupo]');
        function sincronizar() {
          grupos.forEach(function (d) {
            d.open = mq.matches;
            var s = d.querySelector('summary');
            if (mq.matches) s.setAttribute('tabindex', '-1');
            else s.removeAttribute('tabindex');
          });
        }
        grupos.forEach(function (d) {
          d.querySelector('summary').addEventListener('click', function (e) {
            if (mq.matches) e.preventDefault();
          });
        });
        sincronizar();
        mq.addEventListener('change', sincronizar);
      })();
    </script>

    <div class="pie-final">
      <p>© {anio} {SITIO.nombre}. {SITIO.ciudad}, Colombia.</p>
      <!-- Pausa los bucles de animación (src/scripts/pausa.ts). Sin JS o con «reducir movimiento» no hace falta. -->
      <button type="button" class="pie-pausa" data-pausar-movimiento aria-pressed="false" hidden>
        <span aria-hidden="true" class="pie-pausa__icono"></span>
        <span data-texto>Pausar animaciones</span>
      </button>
      <p>Las funciones de atención inteligente dependen de las condiciones de WhatsApp Business (Meta).</p>
    </div>
  </div>

  {!compacto && <p class="pie-marca-agua" aria-hidden="true">{SITIO.nombre}</p>}
</footer>

<style is:global>
  .pie { position: relative; isolation: isolate; overflow: clip; background: var(--color-surface-lowest); }
  .pie-luz {
    position: absolute; z-index: -1; top: -14rem; left: -12rem; width: 44rem; height: 44rem; border-radius: 50%; pointer-events: none;
    background: radial-gradient(closest-side, rgb(99 102 241 / 0.16), rgb(99 102 241 / 0));
  }
  .pie-contenido { padding-top: 4.5rem; padding-bottom: 1rem; }
  @media (min-width: 1024px) { .pie-contenido { padding-top: 7rem; } }
  /* Pie compacto (tras BandaCta): menos aire y la propuesta en una línea corta. */
  .pie--compacto .pie-contenido { padding-top: 2.5rem; }
  @media (min-width: 640px) { .pie--compacto .pie-contenido { padding-top: 3rem; } }
  @media (min-width: 1024px) { .pie--compacto .pie-contenido { padding-top: 4rem; } }
  .pie--compacto .pie-portada { gap: 1.5rem; }
  .pie--compacto .pie-propuesta { margin-top: 1rem; font-size: 0.9375rem; line-height: 1.6; }
  .pie--compacto .pie-nav { margin-top: 1.5rem; }
  @media (min-width: 640px) { .pie--compacto .pie-nav { margin-top: 2rem; } }
  @media (min-width: 1024px) { .pie--compacto .pie-nav { margin-top: 3rem; } }
  .pie--compacto .pie-final { margin-top: 1rem; }
  @media (min-width: 768px) { .pie--compacto .pie-final { margin-top: 2.5rem; } }
  @media (max-width: 1023.98px) {
    .pie--compacto .pie-tarjeta { padding: 1.25rem; }
    .pie--compacto .pie-direccion { grid-template-columns: repeat(auto-fit, minmax(15rem, 1fr)); column-gap: 1.5rem; }
    .pie--compacto .pie-redes { margin-top: 1rem; }
  }

  .pie-portada { display: grid; gap: 3rem; }
  @media (min-width: 1024px) {
    .pie-portada { grid-template-columns: repeat(12, minmax(0, 1fr)); gap: 2rem; align-items: start; }
    .pie-columna-marca { grid-column: 1 / span 7; }
    .pie-columna-contacto { grid-column: 8 / span 5; }
    /* Compacto: el mapa del sitio sube bajo la marca (antes quedaba un hueco a la izquierda). */
    .pie--compacto .pie-contenido { display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); column-gap: 2rem; align-items: start; }
    .pie--compacto .pie-portada { display: contents; }
    .pie--compacto .pie-columna-marca { grid-column: 1 / span 6; grid-row: 1; }
    .pie--compacto .pie-columna-contacto { grid-column: 8 / span 5; grid-row: 1 / span 2; }
    .pie--compacto .pie-nav { grid-column: 1 / span 6; grid-row: 2; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 2.5rem 2rem; }
    .pie--compacto .pie-final { grid-column: 1 / -1; grid-row: 3; }
  }

  .pie-marca { display: inline-flex; align-items: center; min-height: 2.75rem; border-radius: 0.75rem; }
  .pie-eslogan {
    margin-top: 2.5rem; font-family: var(--font-display); font-weight: 600; color: var(--color-ink);
    font-size: clamp(2.5rem, 1.5rem + 4.2vw, 4.75rem); line-height: 1; letter-spacing: -0.035em;
  }
  .pie-eslogan > span { display: block; padding-bottom: 0.06em; }
  .pie-propuesta { margin-top: 1.5rem; max-width: 34rem; font-size: 1.0625rem; line-height: 1.7; color: var(--color-ink-soft); }
  .pie-ctas { margin-top: 2rem; display: flex; flex-direction: column; gap: 0.75rem; }
  @media (min-width: 640px) { .pie-ctas { flex-direction: row; flex-wrap: wrap; } }
  .pie-verde { color: var(--color-whatsapp); }

  .pie-tarjeta { border-radius: var(--radius-panel); background: var(--color-surface-low); padding: 1.5rem 1.25rem; }
  @media (min-width: 640px) { .pie-tarjeta { padding: 2rem; } }
  .pie-direccion { font-style: normal; display: grid; gap: 0.25rem; margin-top: 1rem; }
  .pie-nombre { font-family: var(--font-display); font-weight: 600; font-size: 1.25rem; color: var(--color-ink); margin-bottom: 0.5rem; }
  .pie-dato {
    position: relative; display: flex; align-items: center; gap: 0.875rem;
    min-height: 3rem; padding: 0.375rem 0.5rem; margin-inline: -0.5rem; border-radius: 0.875rem;
  }
  @media (min-width: 640px) { .pie-dato { min-height: 3.5rem; padding-block: 0.5rem; } }
  a.pie-dato::before {
    content: ''; position: absolute; inset: 0; border-radius: inherit; background: rgb(229 225 228 / 0.05); opacity: 0; transition: opacity 0.2s;
  }
  a.pie-dato:hover::before { opacity: 1; }
  .pie-dato__icono {
    position: relative; flex: none; display: grid; place-items: center; width: 2.5rem; height: 2.5rem; border-radius: 0.75rem;
    background: var(--color-surface-high); color: var(--color-ink-soft);
  }
  .pie-dato__icono.pie-verde { color: var(--color-whatsapp); }
  .pie-dato__textos { position: relative; display: grid; gap: 0.125rem; min-width: 0; }
  .pie-dato__etiqueta { font-family: var(--font-mono); font-size: 0.6875rem; letter-spacing: 0.16em; text-transform: uppercase; color: var(--color-ink-mute); }
  .pie-dato__valor { color: var(--color-ink); font-weight: 500; line-height: 1.4; overflow-wrap: anywhere; }
  a.pie-dato .pie-dato__valor { text-decoration: underline; text-decoration-color: rgb(192 193 255 / 0.35); text-underline-offset: 4px; }
  a.pie-dato:hover .pie-dato__valor { text-decoration-color: var(--color-primary); }

  .pie-redes { display: flex; flex-wrap: wrap; gap: 0.5rem; margin-top: 1.5rem; }
  .pie-red {
    display: grid; place-items: center; width: 2.75rem; height: 2.75rem; border-radius: 0.875rem;
    background: rgb(229 225 228 / 0.06); color: var(--color-ink-soft);
    transition: transform 0.3s var(--ease-out-expo), box-shadow 0.3s;
  }
  .pie-red:hover { color: var(--color-ink); transform: translateY(-2px); box-shadow: 0 8px 24px -8px rgb(128 131 255 / 0.6), inset 0 0 0 1px rgb(192 193 255 / 0.3); }

  .pie-aval {
    position: relative; display: flex; align-items: center; gap: 1rem; margin-top: 0.75rem;
    padding: 1rem 1.25rem; border-radius: var(--radius-panel); min-height: 4.5rem;
    background: linear-gradient(135deg, rgb(128 131 255 / 0.14), rgb(99 102 241 / 0.04));
    box-shadow: inset 0 0 0 1px rgb(192 193 255 / 0.16);
  }
  .pie-aval__sello {
    flex: none; display: grid; place-items: center; width: 3rem; height: 3rem; border-radius: 50%;
    background: rgb(128 131 255 / 0.16); color: var(--color-primary); box-shadow: 0 0 24px -4px rgb(128 131 255 / 0.6);
  }
  .pie-aval__textos { display: grid; gap: 0.125rem; min-width: 0; flex: 1; }
  .pie-aval__titulo { font-weight: 600; color: var(--color-ink); }
  .pie-aval__texto { font-size: 0.875rem; line-height: 1.45; color: var(--color-ink-soft); }
  .pie-aval__ver { color: var(--color-primary); font-weight: 500; white-space: nowrap; }
  .pie-aval__flecha { flex: none; color: var(--color-primary); transition: transform 0.3s var(--ease-out-expo); }
  .pie-aval:hover .pie-aval__flecha { transform: translate(2px, -2px); }

  /* ── Mapa del sitio ──────────────────────────────────────────────────── */
  /* Celular: los cuatro grupos plegados en dos columnas (cada uno se abre en su columna). */
  .pie-nav { margin-top: 3.5rem; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 0.5rem; align-items: start; }
  @media (min-width: 768px) { .pie-nav { grid-template-columns: 1.35fr 1.2fr 0.8fr 0.9fr; gap: 2rem; } }
  @media (min-width: 1024px) { .pie-nav { margin-top: 6rem; } }

  .pie-grupo { border-radius: 1rem; background: var(--color-surface-low); }
  .pie-grupo__resumen {
    display: flex; align-items: center; justify-content: space-between; gap: 0.5rem;
    min-height: 3.5rem; padding-inline: 1rem; border-radius: 1rem; cursor: pointer; list-style: none;
  }
  .pie-grupo__resumen::-webkit-details-marker { display: none; }
  .pie-grupo__titulo { font-family: var(--font-display); font-size: 1.0625rem; font-weight: 500; color: var(--color-ink); letter-spacing: 0; }
  .pie-grupo__flecha { flex: none; color: var(--color-ink-mute); transition: transform 0.3s var(--ease-out-expo); }
  .pie-grupo[open] .pie-grupo__flecha { transform: rotate(180deg); color: var(--color-primary); }
  .pie-grupo__lista { display: grid; padding: 0 0.5rem 0.5rem; }
  .pie-enlace {
    display: flex; align-items: center; min-height: 2.75rem; padding: 0.375rem 0.5rem; border-radius: 0.625rem;
    color: var(--color-ink-soft); line-height: 1.35;
  }
  .pie-enlace:hover { color: var(--color-ink); }
  .pie-enlace[aria-current] { color: var(--color-primary); }

  @media (min-width: 768px) {
    .pie-grupo { background: transparent; }
    .pie-grupo__resumen { min-height: 0; padding: 0; cursor: default; pointer-events: none; }
    .pie-grupo__titulo { font-family: var(--font-mono); font-size: 0.75rem; letter-spacing: 0.2em; text-transform: uppercase; color: var(--color-primary); font-weight: 400; }
    .pie-grupo__flecha { display: none; }
    .pie-grupo__lista { padding: 0; margin-top: 1rem; margin-inline: -0.5rem; }
  }

  .pie-final {
    display: flex; flex-direction: column; gap: 0.5rem; margin-top: 3.5rem; padding-block: 1.5rem 1rem;
    font-size: 0.8125rem; line-height: 1.5; color: var(--color-ink-mute);
  }
  @media (min-width: 768px) { .pie-final { flex-direction: row; justify-content: space-between; gap: 2rem; margin-top: 5rem; } }
  .pie-final p:last-child { max-width: 34rem; }
  .pie-pausa {
    display: inline-flex; align-items: center; gap: 0.5rem; align-self: flex-start; min-height: 2.75rem; padding: 0.25rem 0.875rem;
    border-radius: 999px; color: var(--color-ink-soft); background: rgb(229 225 228 / 0.06); font-size: 0.8125rem;
  }
  .pie-pausa:hover { color: var(--color-ink); }
  .pie-pausa[hidden] { display: none; }
  .pie-pausa__icono { width: 0.625rem; height: 0.75rem; border-inline: 3px solid currentColor; }
  .pie-pausa[aria-pressed='true'] .pie-pausa__icono { border: 0; border-left: 0.625rem solid currentColor; border-block: 0.375rem solid transparent; width: 0; height: 0; }
  @media (min-width: 768px) { .pie-pausa { align-self: center; } }
  @media (prefers-reduced-motion: reduce) { .pie-pausa { display: none; } }
  @media (min-width: 768px) { .pie-final p:last-child { text-align: right; } }

  /* Marca de agua editorial (decorativa, recortada por el pie). */
  .pie-marca-agua {
    position: relative; z-index: -1; margin-top: -0.5rem; margin-bottom: -0.18em; pointer-events: none; user-select: none;
    font-family: var(--font-display); font-weight: 700; text-transform: uppercase; white-space: nowrap; text-align: center;
    font-size: 15vw; line-height: 0.8; letter-spacing: -0.05em;
    background: linear-gradient(180deg, rgb(192 193 255 / 0.1) 0%, rgb(192 193 255 / 0.015) 75%);
    -webkit-background-clip: text; background-clip: text; color: transparent;
  }

  @media (prefers-reduced-motion: reduce) {
    .pie-red, .pie-aval__flecha, .pie-grupo__flecha, a.pie-dato::before { transition: none; }
    .pie-red:hover, .pie-aval:hover .pie-aval__flecha { transform: none; }
  }
</style>
