---
// Metadatos de cada página: título, descripción, canónica, Open Graph y JSON-LD.
// La página de error (/404.html) no declara canónica, hreflang ni og:url: no es una URL que
// deba indexarse. Las guías (tipo article) llevan sus fechas de publicación y actualización.
import { SITIO } from '@/data/sitio';
import { urlAbsoluta } from '@/lib/schema';

interface Props {
  titulo: string;        // 50-60 caracteres idealmente, sin repetir la marca
  descripcion: string;   // 140-160 caracteres
  ruta: string;          // ej. '/precios/'
  imagen?: string;
  tipo?: 'website' | 'article';
  noIndexar?: boolean;
  jsonld?: object;
  /** Solo con tipo article: fechas AAAA-MM-DD (article:published_time y article:modified_time). */
  publicado?: string;
  modificado?: string;
}
const { titulo, descripcion, ruta, imagen = SITIO.imagenSocial, tipo = 'website', noIndexar = false, jsonld, publicado, modificado } = Astro.props;
const esError = ruta === '/404.html';
const tituloCompleto = ruta === '/' ? `${titulo}` : `${titulo} | ${SITIO.nombre}`;
const canonica = urlAbsoluta(ruta);
const imagenAbs = urlAbsoluta(imagen);
---
<title>{tituloCompleto}</title>
<meta name="description" content={descripcion} />
{
  !esError && (
    <>
      <link rel="canonical" href={canonica} />
      <link rel="alternate" hreflang="es-CO" href={canonica} />
      <link rel="alternate" hreflang="x-default" href={canonica} />
    </>
  )
}
{noIndexar ? <meta name="robots" content="noindex, follow" /> : <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1" />}
<meta property="og:type" content={tipo} />
<meta property="og:locale" content="es_CO" />
<meta property="og:site_name" content={SITIO.nombre} />
<meta property="og:title" content={tituloCompleto} />
<meta property="og:description" content={descripcion} />
{!esError && <meta property="og:url" content={canonica} />}
{tipo === 'article' && publicado && <meta property="article:published_time" content={publicado} />}
{tipo === 'article' && modificado && <meta property="article:modified_time" content={modificado} />}
<meta property="og:image" content={imagenAbs} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content={`${SITIO.nombre}: ${SITIO.categoria}`} />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={tituloCompleto} />
<meta name="twitter:description" content={descripcion} />
<meta name="twitter:image" content={imagenAbs} />
<meta name="geo.region" content="CO-DC" />
<meta name="geo.placename" content="Bogotá" />
{jsonld && <script type="application/ld+json" set:html={JSON.stringify(jsonld)} />}
