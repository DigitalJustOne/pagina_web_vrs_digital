---
// Icono SVG en línea. Siempre decorativo (aria-hidden): el nombre accesible
// lo da el texto del enlace o un aria-label en el elemento interactivo.
import { TRAZOS, WHATSAPP, type NombreIcono } from './iconos';

interface Props {
  nombre: NombreIcono;
  /** Tamaño en px (ancho y alto). */
  tamano?: number;
  class?: string;
}
const { nombre, tamano = 20, class: clase } = Astro.props;
const relleno = nombre === 'whatsapp';
const contenido = nombre === 'whatsapp' ? WHATSAPP : TRAZOS[nombre];
---
{
  relleno ? (
    <svg class={clase} width={tamano} height={tamano} viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" focusable="false" set:html={contenido} />
  ) : (
    <svg
      class={clase}
      width={tamano}
      height={tamano}
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="1.75"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
      focusable="false"
      set:html={contenido}
    />
  )
}
