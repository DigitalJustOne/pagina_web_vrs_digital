---
// Marca de VRS Digital: símbolo (recortado de /img/logo.png y optimizado a WebP
// por astro:assets, ~2 KB en vez de 110 KB) + nombre en texto real, legible a
// cualquier tamaño. El símbolo es decorativo: el nombre lo da el texto.
import { Image } from 'astro:assets';
import simbolo from '@/assets/marca/vrs-simbolo.png';
import { SITIO } from '@/data/sitio';

interface Props {
  /** Alto del símbolo en px (el ancho es 1,5 veces el alto). */
  alto?: number;
  /** false fuera de la primera pantalla (pie de página). */
  inmediata?: boolean;
  class?: string;
}
const { alto = 32, inmediata = true, class: clase } = Astro.props;
const ancho = Math.round(alto * 1.5);
const [primera, ...resto] = SITIO.nombre.split(' ');
---
<span class:list={['marca-vrs', clase]} style={`--alto-marca:${alto}px`}>
  <Image
    src={simbolo}
    alt=""
    width={ancho}
    height={alto}
    densities={[1, 2]}
    loading={inmediata ? 'eager' : 'lazy'}
    decoding="async"
    class="marca-vrs__simbolo"
  />
  <span class="marca-vrs__nombre"><span class="marca-vrs__fuerte">{primera}</span> {resto.join(' ')}</span>
</span>

<style is:global>
  .marca-vrs { display: inline-flex; align-items: center; gap: calc(var(--alto-marca) * 0.3); }
  .marca-vrs__simbolo { flex: none; display: block; width: calc(var(--alto-marca) * 1.5); height: var(--alto-marca); }
  .marca-vrs__nombre {
    font-family: var(--font-display);
    font-size: max(0.9375rem, calc(var(--alto-marca) * 0.5));
    font-weight: 500;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    line-height: 1;
    color: var(--color-ink-soft);
    white-space: nowrap;
  }
  .marca-vrs__fuerte { font-weight: 700; color: var(--color-ink); }
</style>
