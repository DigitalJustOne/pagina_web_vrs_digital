---
/**
 * Respaldo verificable (aval MinTIC) en una tarjeta de vidrio con borde de luz.
 *
 * <Aval aval={{ titulo: AVAL.titulo, texto: AVAL.texto, enlace: { texto: 'Ver verificación en Cercia', href: AVAL.enlace } }} />
 */
import Icono from '@/components/ui/Icono.astro';
import type { AvalSeccion } from '@/data/contenido/tipos';

interface Props {
  aval: AvalSeccion;
  /** Nivel del título: h3 dentro de una sección (por defecto). */
  nivelTitulo?: 'h3' | 'p';
  class?: string;
}

const { aval, nivelTitulo = 'h3', class: clase } = Astro.props;
const Titulo = nivelTitulo;
---
<div data-revelar class:list={['aval vidrio borde-luz relative isolate flex flex-col gap-5 overflow-hidden rounded-panel p-6 sm:flex-row sm:items-start sm:gap-7 sm:p-8', clase]}>
  <span aria-hidden="true" class="aval-luz pointer-events-none absolute -z-10"></span>
  <span class="sello flex h-16 w-16 shrink-0 items-center justify-center rounded-2xl text-on-primary">
    <Icono nombre="badge" tamano={30} />
  </span>
  <div class="min-w-0">
    <Titulo class="font-display text-xl leading-snug font-semibold tracking-[-0.01em] text-ink sm:text-2xl">{aval.titulo}</Titulo>
    <p class="mt-2 max-w-2xl leading-relaxed text-ink-soft">{aval.texto}</p>
    {
      aval.enlace && (
        <a
          href={aval.enlace.href}
          target="_blank"
          rel="noopener noreferrer"
          class="boton boton-secundario mt-5 w-full sm:w-auto"
        >
          {aval.enlace.texto}
          <span class="sr-only"> (se abre en una pestaña nueva)</span>
          <Icono nombre="arrow-up-right" tamano={18} />
        </a>
      )
    }
  </div>
</div>

<style>
  .sello {
    background: linear-gradient(135deg, #c0c1ff 0%, #8083ff 100%);
    box-shadow: 0 12px 32px -8px rgb(128 131 255 / 0.55);
  }
  .aval-luz {
    left: -6rem;
    top: -8rem;
    width: 20rem;
    height: 20rem;
    border-radius: 999px;
    background: radial-gradient(circle, rgb(128 131 255 / 0.22), transparent 70%);
  }
</style>
