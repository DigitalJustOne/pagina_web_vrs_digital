---
/**
 * Canales de atención (sección «contacto»): WhatsApp y correo en tarjetas grandes,
 * horario de atención humana, redes y párrafos aclaratorios.
 *
 * <Canales canales={s.canales} horario={s.horario} respuestaHumana={s.respuestaHumana} redes={s.redes} parrafos={s.parrafos} />
 */
import Icono from '@/components/ui/Icono.astro';
import type { NombreIcono } from '@/components/ui/iconos';
import type { CanalContacto } from '@/data/contenido/tipos';
import { esExterno } from '@/lib/paginas';

interface Props {
  canales: readonly CanalContacto[];
  horario?: string;
  respuestaHumana?: string;
  redes?: Readonly<Record<string, string>>;
  parrafos?: readonly string[];
  fondo?: 'base' | 'bajo';
  class?: string;
}

const { canales, horario, respuestaHumana, redes = {}, parrafos = [], fondo = 'base', class: clase } = Astro.props;
const capa = fondo === 'bajo' ? 'bg-surface-high hover:bg-surface-highest' : 'bg-surface-low hover:bg-surface-high';

const NOMBRE_RED: Record<string, string> = { instagram: 'Instagram', facebook: 'Facebook', linkedin: 'LinkedIn', github: 'GitHub' };
const iconoCanal = (c: CanalContacto): NombreIcono =>
  c.href.includes('wa.me') ? 'whatsapp' : c.href.startsWith('mailto:') ? 'mail' : c.href.startsWith('tel:') ? 'phone' : 'globe';
---
<div class:list={['canales grid gap-6', clase]}>
  <ul role="list" class="grid gap-4 sm:grid-cols-2">
    {
      canales.map((c, i) => {
        const externo = esExterno(c.href);
        const icono = iconoCanal(c);
        return (
          <li data-revelar style={`--retraso:${i * 90}ms`}>
            <a
              href={c.href}
              target={externo ? '_blank' : undefined}
              rel={externo ? 'noopener noreferrer' : undefined}
              class:list={['canal group flex h-full flex-col rounded-panel p-6 transition-colors duration-300 sm:p-7', capa]}
            >
              <span class="flex items-center justify-between gap-3">
                <span class="font-mono text-xs tracking-[0.18em] text-ink-soft uppercase">{c.nombre}</span>
                <span class:list={['flex h-11 w-11 items-center justify-center rounded-xl bg-surface-lowest', icono === 'whatsapp' ? 'icono-whatsapp' : 'text-primary']}>
                  <Icono nombre={icono} tamano={22} />
                </span>
              </span>
              <span class="mt-5 font-display text-xl leading-tight font-semibold tracking-[-0.01em] [overflow-wrap:anywhere] text-ink sm:text-2xl">{c.valor}</span>
              <span class="mt-4 inline-flex items-center gap-1.5 text-sm font-semibold text-primary">
                {icono === 'whatsapp' ? 'Escribir por WhatsApp' : icono === 'mail' ? 'Escribir un correo' : 'Abrir'}
                {externo && <span class="sr-only"> (se abre en una pestaña nueva)</span>}
                <Icono nombre={externo ? 'arrow-up-right' : 'arrow-right'} tamano={16} class="transition-transform duration-300 group-hover:translate-x-0.5" />
              </span>
            </a>
          </li>
        );
      })
    }
  </ul>

  {
    (horario || respuestaHumana) && (
      <div data-revelar class="horario vidrio borde-fantasma flex items-start gap-4 rounded-panel p-6">
        <span class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl bg-primary/12 text-primary">
          <Icono nombre="clock" tamano={22} />
        </span>
        <div>
          <p class="font-display text-lg font-semibold text-ink">Atención humana</p>
          {horario && <p class="mt-1 leading-relaxed text-ink-soft">{horario}</p>}
          {respuestaHumana && <p class="mt-1 leading-relaxed text-ink-soft">{respuestaHumana}</p>}
        </div>
      </div>
    )
  }

  {parrafos.length > 0 && <div class="grid gap-3 text-[1.0625rem] leading-relaxed text-ink-soft">{parrafos.map((p) => <p>{p}</p>)}</div>}

  {
    Object.keys(redes).length > 0 && (
      <div>
        <p class="font-mono text-xs tracking-[0.18em] text-ink-soft uppercase">Redes</p>
        <ul role="list" class="mt-2 flex flex-wrap gap-2">
          {Object.entries(redes).map(([red, url]) => (
            <li>
              <a
                href={url}
                target="_blank"
                rel="noopener noreferrer"
                class="boton-red inline-flex min-h-11 items-center gap-1.5 rounded-full px-4 text-sm font-medium text-ink"
              >
                {NOMBRE_RED[red] ?? red}
                <span class="sr-only"> de VRS Digital (se abre en una pestaña nueva)</span>
                <Icono nombre="arrow-up-right" tamano={14} class="text-primary" />
              </a>
            </li>
          ))}
        </ul>
      </div>
    )
  }
</div>

<style>
  .canal {
    box-shadow: inset 0 1px 0 rgb(229 225 228 / 0.05);
  }
  .boton-red {
    background: rgb(255 255 255 / 0.05);
    box-shadow: inset 0 0 0 1px rgb(229 225 228 / 0.12);
    transition: background-color 0.2s;
  }
  .boton-red:hover {
    background: rgb(255 255 255 / 0.1);
  }
</style>
