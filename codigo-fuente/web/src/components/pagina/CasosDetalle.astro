---
/**
 * Casos completos de /proyectos/: captura en un marco de navegador y, al lado, rótulo
 * (Cliente / Producto propio / Plataforma), sector, contexto, qué se hizo, logros y enlace.
 * Alterna el lado de la imagen en computador. Títulos H3.
 * Todas las capturas cargan en diferido: en /proyectos/ la primera queda bajo la portada y,
 * cargada antes, compite con las fuentes y retrasa el LCP.
 *
 * <CasosDetalle items={s.items} rotulos={s.rotulos} />
 */
import Icono from '@/components/ui/Icono.astro';
import { esCliente, imagenCaso, rotuloCaso, slugCaso } from '@/lib/casos';
import type { ProyectoDetalle, SeccionCasosDetalle } from '@/data/contenido/tipos';

interface Props {
  items: readonly ProyectoDetalle[];
  rotulos: SeccionCasosDetalle['rotulos'];
  fondo?: 'base' | 'bajo';
  class?: string;
}

const { items, rotulos, fondo = 'base', class: clase } = Astro.props;
const capa = fondo === 'bajo' ? 'bg-surface-high' : 'bg-surface-low';
const hueco = fondo === 'bajo' ? 'bg-surface-low' : 'bg-surface-lowest';
---
<ol role="list" class:list={['casos-detalle grid gap-8 lg:gap-12', clase]}>
  {
    items.map((p, i) => {
      const img = imagenCaso(p);
      const id = `proyecto-${slugCaso(p.cliente)}`;
      const rotulo = rotuloCaso(p.cliente);
      const deCliente = esCliente(p.cliente);
      return (
        <li id={id} class="scroll-mt-28">
          <article aria-labelledby={`${id}-titulo`} class:list={['caso grid items-center gap-6 rounded-panel p-4 sm:p-6 lg:grid-cols-12 lg:gap-10 lg:p-8', capa]}>
            <figure data-revelar class:list={['ventana lg:col-span-7', i % 2 === 1 && 'lg:order-2']}>
              <div aria-hidden="true" class="flex items-center gap-1.5 px-4 py-3">
                <span class="h-2.5 w-2.5 rounded-full bg-ink-mute/40" />
                <span class="h-2.5 w-2.5 rounded-full bg-ink-mute/40" />
                <span class="h-2.5 w-2.5 rounded-full bg-ink-mute/40" />
              </div>
              <div
                class:list={['relative overflow-hidden', img.ajuste === 'contain' && 'aspect-[16/10]', hueco]}
                style={img.ajuste === 'contain' ? undefined : `aspect-ratio:${img.ancho}/${img.alto}`}
              >
                <picture>
                  {img.webp && <source srcset={img.webp} type="image/webp" />}
                  <img
                    src={p.imagen}
                    alt={img.alt}
                    width={img.ancho}
                    height={img.alto}
                    loading="lazy"
                    decoding="async"
                    class:list={['captura absolute inset-0 h-full w-full', img.ajuste === 'contain' ? 'object-contain p-8' : 'object-cover']}
                    style={`object-position:${img.posicion}`}
                  />
                </picture>
              </div>
            </figure>

            <div data-revelar style="--retraso:120ms" class:list={['min-w-0 px-1 pb-2 lg:col-span-5 lg:px-0 lg:pb-0', i % 2 === 1 && 'lg:order-1']}>
              <p class="flex flex-wrap items-center gap-2">
                <span class:list={['chip font-mono text-[0.6875rem] tracking-[0.12em] uppercase', !deCliente && 'rotulo']}>{rotulo}</span>
                {p.tipo !== rotulo && <span class="chip rotulo font-mono text-[0.6875rem] tracking-[0.12em] uppercase">{p.tipo}</span>}
              </p>
              <p class="mt-4 font-mono text-xs tracking-[0.15em] text-ink-soft uppercase">{p.sector}</p>
              <h3 id={`${id}-titulo`} class="mt-2 font-display text-[1.75rem] leading-tight font-semibold tracking-[-0.02em] text-ink sm:text-[2rem]">
                {p.cliente}
              </h3>

              <dl class="mt-5 grid gap-5">
                <div>
                  <dt class="etiqueta !tracking-[0.15em]">{rotulos.contexto}</dt>
                  <dd class="mt-2 leading-relaxed text-ink-soft">{p.contexto}</dd>
                </div>
                <div>
                  <dt class="etiqueta !tracking-[0.15em]">{rotulos.queSeHizo}</dt>
                  <dd class="mt-2">
                    <ul role="list" class="grid gap-2">
                      {p.queSeHizo.map((q) => (
                        <li class="flex items-start gap-2.5 leading-snug text-ink">
                          <Icono nombre="tick" tamano={17} class="mt-0.5 text-primary" />
                          <span>{q}</span>
                        </li>
                      ))}
                    </ul>
                  </dd>
                </div>
                <div>
                  <dt class="etiqueta !tracking-[0.15em]">{deCliente ? rotulos.logros : 'Qué ofrece'}</dt>
                  <dd class="mt-2">
                    <ul role="list" class="flex flex-wrap gap-2">
                      {p.logros.map((l) => (
                        <li class="rounded-full bg-primary/10 px-3 py-1.5 text-[0.8125rem] leading-snug text-primary">{l}</li>
                      ))}
                    </ul>
                  </dd>
                </div>
              </dl>

              <a href={p.enlace} target="_blank" rel="noopener noreferrer" class="boton boton-secundario mt-6 w-full sm:w-auto">
                {rotulos.enlace}
                <span class="sr-only">{` de ${p.cliente} (se abre en una pestaña nueva)`}</span>
                <Icono nombre="arrow-up-right" tamano={18} />
              </a>
            </div>
          </article>
        </li>
      );
    })
  }
</ol>

<style>
  .caso {
    box-shadow: inset 0 1px 0 rgb(229 225 228 / 0.05);
  }
  .ventana {
    overflow: hidden;
    border-radius: 1rem;
    background: rgb(53 52 55 / 0.6);
    box-shadow: 0 24px 48px -16px rgb(0 0 0 / 0.55);
  }
  .rotulo {
    background: rgb(229 225 228 / 0.08);
    color: var(--color-ink-soft, #c9c5c8);
  }
  @media (prefers-reduced-motion: no-preference) {
    .captura {
      transition: transform 0.6s cubic-bezier(0.16, 1, 0.3, 1);
    }
    .caso:hover .captura {
      transform: scale(1.03);
    }
  }
</style>
