---
/**
 * Cifras verificadas (CIFRAS de sitio.ts) con contador al entrar en pantalla (data-contar).
 * Úselo solo con cifras que tengan fuente. Sin JS o con movimiento reducido se ve el valor final.
 *
 * <Cifras cifras={CIFRAS} />
 */
import type { Cifra } from '@/data/contenido/tipos';

interface Props {
  cifras: readonly Cifra[];
  fondo?: 'base' | 'bajo';
  class?: string;
}

const { cifras, fondo = 'base', class: clase } = Astro.props;
const capa = fondo === 'bajo' ? 'bg-surface-high' : 'bg-surface-low';
---
<dl class:list={['cifras grid gap-3 sm:grid-cols-3 sm:gap-4', clase]}>
  {
    cifras.map((c, i) => (
      <div
        data-revelar
        style={`--retraso:${i * 90}ms`}
        class:list={['cifra relative flex items-center gap-4 overflow-hidden rounded-card px-5 py-4 sm:flex-col sm:items-start sm:gap-2 sm:p-6', capa]}
      >
        <dt class="order-2 text-[0.9375rem] leading-snug text-ink-soft">{c.etiqueta}</dt>
        <dd class="order-1 min-w-[4.5rem] font-display text-[2.5rem] leading-none font-semibold tracking-[-0.04em] text-primary sm:text-[3.25rem]">
          <span data-contar>{c.valor}</span>
        </dd>
      </div>
    ))
  }
</dl>

<style>
  .cifra::after {
    content: '';
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: radial-gradient(90% 120% at 0% 0%, rgb(128 131 255 / 0.12), transparent 60%);
  }
</style>
