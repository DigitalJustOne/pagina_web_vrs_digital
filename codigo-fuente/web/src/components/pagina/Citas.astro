---
/**
 * Citas textuales de fuentes oficiales: traducción visible, original en inglés (lang="en")
 * y enlace a la fuente (el título en inglés de la fuente, `fuenteEn`, también lleva lang="en"). Cada cita es un <figure> con <blockquote cite> y <figcaption>.
 *
 * <Citas items={[{ texto: '…', original: '…', fuente: 'Google Search Central', url: 'https://…' }]} />
 */
import Icono from '@/components/ui/Icono.astro';
import { partirResaltado } from '@/lib/paginas';
import type { Cita } from '@/data/contenido/tipos';

interface Props {
  items: readonly Cita[];
  fondo?: 'base' | 'bajo';
  class?: string;
}

const { items, fondo = 'base', class: clase } = Astro.props;
---
<ul role="list" class:list={['citas grid gap-5 md:grid-cols-2', clase]}>
  {
    items.map((c, i) => (
      <li data-revelar style={`--retraso:${(i % 2) * 110}ms`}>
        <figure class:list={['cita relative isolate flex h-full flex-col overflow-hidden rounded-panel p-6 sm:p-8', fondo === 'bajo' ? 'sobre-bajo' : '']}>
          <span aria-hidden="true" class="comillas pointer-events-none absolute -top-3 right-5 -z-10 font-display select-none">”</span>
          <blockquote cite={c.url} class="flex-1">
            <p class="font-display text-lg leading-snug font-medium tracking-[-0.01em] text-ink sm:text-xl">«{c.texto}»</p>
          </blockquote>
          {c.original && (
            <p class="mt-5 text-sm leading-relaxed text-ink-mute">
              <span class="font-mono text-[0.6875rem] tracking-[0.14em] text-ink-soft uppercase">Original en inglés: </span>
              <q lang="en" class="italic">{c.original}</q>
            </p>
          )}
          <figcaption class="mt-5 pt-4 text-sm leading-snug">
            <a
              href={c.url}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex min-h-11 items-start gap-2 py-1 font-medium text-primary underline-offset-4 hover:underline"
            >
              <span>
                {partirResaltado(c.fuente, c.fuenteEn).map((parte) => (parte.resaltar ? <span lang="en">{parte.texto}</span> : parte.texto))}
                <span class="sr-only"> (se abre en una pestaña nueva)</span>
              </span>
              <Icono nombre="arrow-up-right" tamano={16} class="mt-0.5" />
            </a>
          </figcaption>
        </figure>
      </li>
    ))
  }
</ul>

<style>
  .cita {
    background:
      radial-gradient(90% 70% at 100% 0%, rgb(128 131 255 / 0.12), transparent 60%),
      var(--color-surface-low, #1c1b1e);
    box-shadow: inset 0 0 0 1px rgb(70 69 84 / 0.35);
  }
  .cita.sobre-bajo {
    background:
      radial-gradient(90% 70% at 100% 0%, rgb(128 131 255 / 0.12), transparent 60%),
      var(--color-surface-high, #2a2a2c);
  }
  .cita figcaption {
    box-shadow: inset 0 1px 0 rgb(229 225 228 / 0.07);
  }
  .comillas {
    font-size: 9rem;
    line-height: 1;
    color: rgb(128 131 255 / 0.16);
  }
</style>
