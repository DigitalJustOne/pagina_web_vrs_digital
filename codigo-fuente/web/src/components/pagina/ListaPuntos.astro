---
/**
 * Cuerpo de las secciones «lista».
 * - Ítems de texto: un panel con filas separadas por una línea fina.
 * - Ítems { titulo, texto }: tarjetas en dos columnas.
 * - variante: incluye (✓), excluye (✕), alerta (!) o, sin variante, numeradas 01, 02…
 * - ejemplo: tarjeta con una pregunta, su respuesta y la fuente.
 *
 * <ListaPuntos items={s.items} variante={s.variante} ejemplo={s.ejemplo} fondo="bajo" />
 */
import Icono from '@/components/ui/Icono.astro';
import type { NombreIcono } from '@/components/ui/iconos';
import type { BloqueTitulado, EjemploRespuesta } from '@/data/contenido/tipos';
import EnlaceFlecha from './EnlaceFlecha.astro';

interface Props {
  items: readonly (string | BloqueTitulado)[];
  variante?: 'incluye' | 'excluye' | 'alerta';
  ejemplo?: EjemploRespuesta;
  fondo?: 'base' | 'bajo';
  class?: string;
}

const { items, variante, ejemplo, fondo = 'base', class: clase } = Astro.props;
const capa = fondo === 'bajo' ? 'bg-surface-high' : 'bg-surface-low';
const conTitulo = items.some((it) => typeof it !== 'string');
const ICONO: Record<NonNullable<Props['variante']>, NombreIcono> = { incluye: 'tick', excluye: 'x', alerta: 'alert' };
const numero = (i: number) => String(i + 1).padStart(2, '0');
---
<div class:list={['lista-puntos', variante && `lista-${variante}`, clase]}>
  {
    conTitulo ? (
      <ul role="list" class="grid gap-3 sm:grid-cols-2 sm:gap-4">
        {items.map((it, i) => {
          const b = typeof it === 'string' ? { titulo: '', texto: it } : it;
          return (
            <li data-revelar style={`--retraso:${Math.min(i, 5) * 60}ms`} class:list={['item-tarjeta flex gap-4 rounded-card p-5 sm:p-6', capa]}>
              <span aria-hidden="true" class="marca">
                {variante ? <Icono nombre={ICONO[variante]} tamano={16} /> : numero(i)}
              </span>
              <div class="min-w-0">
                {b.titulo && <p class="font-display text-lg leading-snug font-semibold text-ink">{b.titulo}</p>}
                <p class:list={['leading-relaxed text-ink-soft', b.titulo && 'mt-1.5']}>{b.texto}</p>
              </div>
            </li>
          );
        })}
      </ul>
    ) : (
      <ul role="list" class:list={['panel rounded-panel px-5 sm:px-7', capa]}>
        {items.map((it, i) => (
          <li class="fila flex items-start gap-4 py-4 sm:py-5">
            <span aria-hidden="true" class="marca">
              {variante ? <Icono nombre={ICONO[variante]} tamano={16} /> : numero(i)}
            </span>
            <span class="texto pt-1 text-[1.0625rem] leading-relaxed">{typeof it === 'string' ? it : it.texto}</span>
          </li>
        ))}
      </ul>
    )
  }

  {
    ejemplo && (
      <figure data-revelar class="ejemplo vidrio borde-luz relative mt-6 overflow-hidden rounded-panel p-6 sm:p-8">
        <span aria-hidden="true" class="ejemplo-luz pointer-events-none absolute -top-24 -right-24 h-64 w-64 rounded-full" />
        <p class="etiqueta relative flex items-center gap-2.5">
          <Icono nombre="message" tamano={16} />
          {ejemplo.titulo}
        </p>
        <blockquote class="relative mt-5">
          <p class="font-display text-lg leading-snug font-semibold text-ink sm:text-xl">{ejemplo.pregunta}</p>
          <p class="mt-3 leading-relaxed text-ink-soft">{ejemplo.respuesta}</p>
        </blockquote>
        {ejemplo.fuente && (
          <figcaption class="relative mt-4 text-sm text-ink-soft">
            Fuente: <EnlaceFlecha href={ejemplo.fuente.href} texto={ejemplo.fuente.texto} class="text-sm" />
          </figcaption>
        )}
      </figure>
    )
  }
</div>

<style>
  .fila + .fila {
    box-shadow: inset 0 1px 0 rgb(229 225 228 / 0.07);
  }
  .panel {
    box-shadow: inset 0 1px 0 rgb(229 225 228 / 0.05);
  }
  .texto {
    color: var(--color-ink, #e5e1e4);
  }
  .marca {
    display: inline-flex;
    flex: none;
    align-items: center;
    justify-content: center;
    width: 2.25rem;
    height: 2.25rem;
    border-radius: 0.75rem;
    background: rgb(128 131 255 / 0.12);
    color: var(--color-primary, #c0c1ff);
    font-family: var(--font-mono, ui-monospace, monospace);
    font-size: 0.8125rem;
    font-weight: 600;
  }
  .lista-incluye .marca {
    border-radius: 999px;
  }
  .lista-excluye .marca {
    border-radius: 999px;
    background: rgb(229 225 228 / 0.07);
    color: var(--color-ink-soft, #c9c5c8);
  }
  .lista-excluye .texto {
    color: var(--color-ink-soft, #c9c5c8);
  }
  .lista-alerta .marca {
    border-radius: 999px;
    background: rgb(255 180 171 / 0.12);
    color: #ffb4ab;
  }
  .item-tarjeta {
    box-shadow: inset 0 1px 0 rgb(229 225 228 / 0.05);
  }
  .ejemplo-luz {
    background: radial-gradient(circle, rgb(128 131 255 / 0.25), transparent 70%);
  }
</style>
