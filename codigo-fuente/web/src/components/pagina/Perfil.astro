---
/**
 * Perfil de una persona (sección «perfil» de /nosotros/): retrato fijo a la izquierda en
 * computador; a la derecha, los párrafos (el primero como entrada) y las cifras verificadas.
 *
 * <Perfil persona={s.persona} parrafos={s.parrafos} cifras={s.cifras} />
 */
import type { Cifra, Persona } from '@/data/contenido/tipos';
import Cifras from './Cifras.astro';
import Retrato from './Retrato.astro';

interface Props {
  persona: Persona;
  parrafos: readonly string[];
  cifras?: readonly Cifra[];
  fondo?: 'base' | 'bajo';
  /** Ilumina el primer párrafo palabra por palabra al desplazarse. */
  iluminar?: boolean;
  class?: string;
}

const { persona, parrafos, cifras = [], fondo = 'base', iluminar = false, class: clase } = Astro.props;
const [primero, ...resto] = parrafos;
---
<div class:list={['perfil grid gap-10 lg:grid-cols-12 lg:gap-14', clase]}>
  <div class="lg:col-span-5">
    <Retrato
      foto={persona.foto}
      alt={persona.altFoto}
      nombre={persona.nombre}
      cargo={persona.cargo}
      enlaces={persona.enlaces}
      class="mx-auto max-w-[26rem] lg:sticky lg:top-[calc(var(--alto-encabezado)+2rem)] lg:max-w-none"
    />
  </div>
  <div class="min-w-0 lg:col-span-7 lg:pt-2">
    {
      primero && (
        <p
          data-revelar-texto={iluminar ? 'desplazamiento' : undefined}
          class="font-display text-[1.375rem] leading-snug font-medium tracking-[-0.01em] text-ink sm:text-[1.75rem]"
        >
          {primero}
        </p>
      )
    }
    {resto.length > 0 && <div class="mt-6 grid gap-4 text-[1.0625rem] leading-relaxed text-ink-soft sm:text-lg">{resto.map((p) => <p>{p}</p>)}</div>}
    {cifras.length > 0 && <Cifras cifras={cifras} fondo={fondo} class="mt-10" />}
  </div>
</div>
