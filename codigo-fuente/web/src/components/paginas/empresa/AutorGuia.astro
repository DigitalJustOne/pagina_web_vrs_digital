---
/**
 * Recuadro del autor al final de una guía: retrato, nombre, cargo, su presentación (el primer
 * párrafo del perfil de /nosotros/), cifras verificadas (CIFRAS) y enlaces a su perfil.
 * Señal de experiencia y autoría (quién escribe y por qué se le puede creer).
 *
 * <AutorGuia etiqueta="Quién la escribe" titulo="Sobre el autor" enlace={{ texto: '…', href: '/nosotros/' }} />
 */
import Icono from '@/components/ui/Icono.astro';
import { contenido as nosotros } from '@/data/contenido/nosotros';
import type { Enlace } from '@/data/contenido/tipos';
import { CIFRAS, FUNDADOR } from '@/data/sitio';
import { imagenPublica } from '@/lib/casos';

interface Props {
  etiqueta: string;
  titulo: string;
  enlace: Enlace;
  class?: string;
}

const { etiqueta, titulo, enlace, class: clase } = Astro.props;

const perfil = nosotros.secciones.find((s) => s.tipo === 'perfil');
const presentacion = perfil?.tipo === 'perfil' ? perfil.parrafos[0] : undefined;
const enlacesPerfil = perfil?.tipo === 'perfil' ? (perfil.persona.enlaces ?? []) : [];
// Las dos primeras cifras hablan de la persona (proyectos y años); la tercera, del cupo.
const cifras = CIFRAS.slice(0, 2);
const foto = imagenPublica(FUNDADOR.foto);
---
<section id="autor" aria-labelledby="autor-titulo" class:list={['contenedor py-14 lg:py-20', clase]}>
  <div class="autor vidrio borde-luz relative isolate grid gap-8 overflow-hidden rounded-panel p-6 sm:p-8 md:grid-cols-[13rem_1fr] md:gap-10 lg:p-10">
    <span aria-hidden="true" class="autor-luz pointer-events-none absolute -z-10"></span>
    <picture class="retrato-autor relative block aspect-square w-40 overflow-hidden rounded-[1.25rem] md:w-full">
      {foto.webp && <source srcset={foto.webp} type="image/webp" />}
      <img
        src={FUNDADOR.foto}
        alt={`Retrato de ${FUNDADOR.nombreCorto}, autor de esta guía`}
        width={foto.ancho}
        height={foto.alto}
        loading="lazy"
        decoding="async"
        class="h-full w-full object-cover object-top"
      />
    </picture>

    <div class="min-w-0">
      <p class="etiqueta">{etiqueta}</p>
      <h2 id="autor-titulo" class="mt-3 font-display text-2xl leading-tight font-semibold tracking-[-0.02em] text-ink sm:text-[1.75rem]">
        {titulo}: {FUNDADOR.nombre}
      </h2>
      <p class="mt-1.5 text-ink-soft">{FUNDADOR.cargo}</p>
      {presentacion && <p class="mt-5 max-w-2xl text-[1.0625rem] leading-relaxed text-ink-soft">{presentacion}</p>}

      <dl class="mt-6 flex flex-wrap gap-3">
        {
          cifras.map((c) => (
            <div class="flex items-baseline gap-2 rounded-full bg-primary/10 px-4 py-2">
              <dt class="order-2 text-sm text-ink-soft">{c.etiqueta}</dt>
              <dd class="order-1 font-display text-lg leading-none font-semibold text-primary">{c.valor}</dd>
            </div>
          ))
        }
      </dl>

      <ul role="list" class="mt-6 flex flex-wrap items-center gap-x-6 gap-y-1">
        <li>
          <a href={enlace.href} class="group inline-flex min-h-11 items-center gap-1.5 font-semibold text-primary underline-offset-4 hover:underline">
            {enlace.texto}
            <Icono nombre="arrow-right" tamano={17} class="transition-transform duration-300 group-hover:translate-x-1" />
          </a>
        </li>
        {
          enlacesPerfil.map((e) => (
            <li>
              <a href={e.href} target="_blank" rel="noopener noreferrer" class="inline-flex min-h-11 items-center gap-1.5 text-sm font-semibold text-ink-soft underline-offset-4 hover:text-ink hover:underline">
                {e.texto}
                <span class="sr-only"> de {FUNDADOR.nombreCorto} (se abre en una pestaña nueva)</span>
                <Icono nombre="arrow-up-right" tamano={15} class="text-primary" />
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>

<style>
  .autor-luz {
    left: -8rem;
    top: -10rem;
    width: 26rem;
    height: 26rem;
    border-radius: 999px;
    background: radial-gradient(circle, rgb(128 131 255 / 0.22), transparent 70%);
  }
  .retrato-autor {
    background:
      radial-gradient(60% 55% at 50% 38%, rgb(128 131 255 / 0.4), transparent 72%),
      var(--color-surface-low, #1c1b1e);
    box-shadow: inset 0 0 0 1px rgb(192 193 255 / 0.18);
  }
</style>
