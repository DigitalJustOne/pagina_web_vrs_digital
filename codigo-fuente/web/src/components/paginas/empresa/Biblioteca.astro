---
/**
 * Visual de la portada de /recursos/: las guías publicadas como portadas apiladas en 3D (CSS),
 * con una portada «en preparación» al fondo. Cada portada muestra la etiqueta, el título, la
 * fecha de actualización y el número de fuentes de su guía (datos de la colección).
 *
 * Decorativo para lectores de pantalla (aria-hidden): las mismas guías están enlazadas en la
 * sección #guias, justo debajo. Con mouse, la pila se inclina con el puntero; sin JS o con
 * «reducir movimiento», queda quieta. Relación de aspecto fija (sin saltos de diseño). La pila
 * (con su giro y su perspectiva) cabe en el ancho del bloque: no ensancha la página a 360 px.
 *
 * <Biblioteca slot="visual" guias={fichas} enPreparacion="En preparación" rotuloFuentes="Fuentes enlazadas" />
 */
import Icono from '@/components/ui/Icono.astro';
import { fechaLarga } from '@/lib/paginas';
import type { FichaGuia } from './guias';

interface Props {
  guias: readonly FichaGuia[];
  enPreparacion: string;
  rotuloActualizada: string;
  rotuloFuentes: string;
  class?: string;
}

const { guias, enPreparacion, rotuloActualizada, rotuloFuentes, class: clase } = Astro.props;
// Hasta dos portadas visibles; la más reciente adelante.
const portadas = guias.slice(0, 2);
---
<div aria-hidden="true" data-biblioteca class:list={['biblioteca relative mx-auto w-full max-w-[24rem] sm:max-w-[30rem]', clase]}>
  <span class="luz pointer-events-none absolute -z-10"></span>
  <div class="pila">
    <div class="portada fantasma">
      <span class="flex items-center gap-2 font-mono text-[0.6875rem] tracking-[0.18em] text-ink-soft uppercase">
        <Icono nombre="clock" tamano={14} class="text-primary" />
        {enPreparacion}
      </span>
      <span class="mt-5 block h-3 w-4/5 rounded-full bg-ink/10"></span>
      <span class="mt-2 block h-3 w-3/5 rounded-full bg-ink/10"></span>
    </div>
    {
      portadas
        .map((g, i) => (
          <div class:list={['portada', `capa-${i}`]}>
            <span class="flex items-center justify-between gap-3">
              <span class="chip font-mono text-[0.625rem] tracking-[0.12em] uppercase">{g.etiqueta}</span>
              {g.icono && (
                <span class="flex h-9 w-9 items-center justify-center rounded-xl bg-surface-lowest text-primary">
                  <Icono nombre={g.icono} tamano={18} />
                </span>
              )}
            </span>
            <span class="titulo mt-3 block font-display text-[0.9375rem] leading-snug sm:mt-4 font-semibold tracking-[-0.01em] text-ink sm:text-xl">{g.titulo}</span>
            <span class="meta mt-auto flex flex-wrap gap-x-4 gap-y-1 pt-4 text-xs text-ink-soft">
              <span class="flex items-center gap-1.5">
                <Icono nombre="refresh" tamano={12} class="text-primary" />
                {rotuloActualizada} {fechaLarga(g.actualizado)}
              </span>
              <span class="fuentes flex items-center gap-1.5">
                <Icono nombre="file" tamano={12} class="text-primary" />
                {g.fuentes} {rotuloFuentes.toLowerCase()}
              </span>
            </span>
          </div>
        ))
        .reverse()
    }
  </div>
</div>

<style>
  .biblioteca {
    aspect-ratio: 1 / 0.9;
    perspective: 1200px;
    --rx: 0deg;
    --ry: 0deg;
  }
  .luz {
    inset: 5% 0 0;
    border-radius: 999px;
    background: radial-gradient(circle, rgb(99 102 241 / 0.35), transparent 62%);
    filter: blur(30px);
  }
  .pila {
    position: absolute;
    inset: 0;
    transform-style: preserve-3d;
    transform: rotateX(calc(14deg + var(--rx))) rotateY(calc(-18deg + var(--ry)));
    transition: transform 0.7s var(--ease-out-expo);
  }
  .portada {
    position: absolute;
    left: 3%;
    top: 34%;
    width: 76%;
    height: 58%;
    display: flex;
    flex-direction: column;
    border-radius: 1.25rem;
    padding: 1.1rem 1.2rem;
    box-shadow:
      inset 0 0 0 1px rgb(192 193 255 / 0.22),
      0 30px 60px -25px rgb(0 0 0 / 0.85);
  }
  /* Celular: portadas más altas y una sola línea de datos, para que el título nunca se monte. */
  @media (max-width: 639.98px) {
    .biblioteca {
      aspect-ratio: 1 / 0.95;
    }
    .portada {
      top: 32%;
      height: 64%;
      padding: 0.9rem 1rem;
    }
    .capa-1 {
      transform: translate3d(12%, -44%, -10px);
    }
    .fantasma {
      transform: translate3d(22%, -68%, -90px);
    }
    .fuentes {
      display: none;
    }
    .capa-1 .titulo {
      -webkit-line-clamp: 1;
    }
  }
  /* Las portadas de atrás solo asoman la etiqueta y el título. */
  .capa-1 .meta {
    visibility: hidden;
  }
  .titulo {
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  /* Portada del frente (la más reciente). */
  .capa-0 {
    transform: translate3d(0, 0, 60px);
    background:
      radial-gradient(120% 90% at 0% 0%, rgb(128 131 255 / 0.28), transparent 60%),
      rgb(46 45 49);
  }
  /* Segunda portada: detrás, más arriba y a la derecha (se lee su etiqueta y su título).
     Portadas opacas: en 3D el desenfoque del vidrio no aplica y el texto de atrás se colaría. */
  .capa-1 {
    transform: translate3d(12%, -50%, -10px);
    background:
      radial-gradient(120% 90% at 100% 0%, rgb(99 102 241 / 0.25), transparent 60%),
      rgb(36 36 39);
  }
  /* Portada en preparación: la más lejana, solo contorno. */
  .fantasma {
    transform: translate3d(22%, -80%, -90px);
    background: rgb(14 14 16 / 0.35);
    box-shadow: inset 0 0 0 1px rgb(229 225 228 / 0.16);
    border: 1px dashed rgb(192 193 255 / 0.28);
  }

  @media (prefers-reduced-motion: no-preference) {
    .capa-0 {
      animation: biblioteca-flotar 7s ease-in-out infinite;
    }
    .capa-1 {
      animation: biblioteca-flotar 7s ease-in-out -2.5s infinite;
    }
  }
  /* «translate» para no pisar la posición 3D (transform) de cada portada. */
  @keyframes biblioteca-flotar {
    0%,
    100% {
      translate: 0 0;
    }
    50% {
      translate: 0 -8px;
    }
  }
</style>

<script>
  // Inclinación que sigue al puntero (solo mouse y sin «reducir movimiento»).
  const fino = window.matchMedia('(pointer: fine)').matches;
  const reducido = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (fino && !reducido) {
    for (const el of document.querySelectorAll<HTMLElement>('[data-biblioteca]')) {
      const zona = el.closest('header') ?? el;
      let cuadro = 0;
      let x = 0;
      let y = 0;
      zona.addEventListener('pointermove', (e) => {
        const r = el.getBoundingClientRect();
        x = (e.clientX - (r.left + r.width / 2)) / window.innerWidth;
        y = (e.clientY - (r.top + r.height / 2)) / window.innerHeight;
        if (cuadro) return;
        cuadro = requestAnimationFrame(() => {
          cuadro = 0;
          el.style.setProperty('--ry', `${(x * 18).toFixed(2)}deg`);
          el.style.setProperty('--rx', `${(-y * 12).toFixed(2)}deg`);
        });
      });
      zona.addEventListener('pointerleave', () => {
        el.style.setProperty('--ry', '0deg');
        el.style.setProperty('--rx', '0deg');
      });
    }
  }
</script>
