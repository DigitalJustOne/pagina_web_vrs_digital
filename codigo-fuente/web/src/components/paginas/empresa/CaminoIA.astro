---
/**
 * Sección «inteligencia-artificial» de /nosotros/: la tabla «qué acelera la IA / qué decide y
 * revisa Víctor» presentada como un recorrido. Cada fila pasa por una «compuerta» de revisión
 * humana antes de llegar a la columna de Víctor: la idea de la sección (la IA propone, una
 * persona decide) se ve sin leer.
 *
 * Sigue siendo una tabla de verdad (roles ARIA explícitos, encabezados de columna y de fila),
 * así que lectores de pantalla, Google y asistentes de IA la leen como tabla.
 * - Computador y tableta: tres columnas; la compuerta une la segunda con la tercera y se enciende
 *   cuando la fila entra en pantalla (CSS, sin JS).
 * - Celular: cada fila es una tarjeta: actividad → lo que acelera la IA → compuerta → lo que decide Víctor.
 *
 * <CaminoIA seccion={s} fondo="bajo" numero={2} resaltado="con supervisión humana" />
 */
import Icono from '@/components/ui/Icono.astro';
import type { SeccionTabla } from '@/data/contenido/tipos';
import { idTitulo } from '@/lib/paginas';
import MarcoEmpresa from './MarcoEmpresa.astro';

interface Props {
  seccion: SeccionTabla;
  fondo?: 'base' | 'bajo';
  numero?: number;
  resaltado?: string;
}

const { seccion: s, fondo = 'bajo', numero, resaltado } = Astro.props;
const [colActividad, colIA, colPersona] = s.columnas;
---
<MarcoEmpresa seccion={s} fondo={fondo} numero={numero} resaltado={resaltado}>
  <div class:list={['camino', fondo === 'bajo' && 'sobre-bajo']}>
    <table role="table" aria-labelledby={idTitulo(s.id)}>
      <thead role="rowgroup">
        <tr role="row">
          <th role="columnheader" scope="col">{colActividad}</th>
          <th role="columnheader" scope="col" class="col-ia">
            <span class="inline-flex items-center gap-2"><Icono nombre="spark" tamano={15} />{colIA}</span>
          </th>
          <th role="columnheader" scope="col" class="col-persona">
            <span class="inline-flex items-center gap-2"><Icono nombre="user" tamano={15} />{colPersona}</span>
          </th>
        </tr>
      </thead>
      <tbody role="rowgroup">
        {
          s.filas.map((fila, i) => (
            <tr role="row" data-revelar style={`--retraso:${Math.min(i, 6) * 70}ms`}>
              <th role="rowheader" scope="row">
                <span aria-hidden="true" class="indice">{String(i + 1).padStart(2, '0')}</span>
                {fila[0]}
              </th>
              <td role="cell" class="celda-ia">
                <span aria-hidden="true" class="rotulo-movil">
                  <Icono nombre="spark" tamano={13} />
                  {colIA}
                </span>
                {fila[1]}
              </td>
              <td role="cell" class="celda-persona">
                <span aria-hidden="true" class="compuerta">
                  <Icono nombre="tick" tamano={14} />
                </span>
                <span aria-hidden="true" class="rotulo-movil">
                  <Icono nombre="user" tamano={13} />
                  {colPersona}
                </span>
                {fila[2]}
              </td>
            </tr>
          ))
        }
      </tbody>
    </table>
  </div>
</MarcoEmpresa>

<style>
  .camino table {
    width: 100%;
    border-collapse: separate;
    border-spacing: 0;
    font-size: 0.9375rem;
    line-height: 1.55;
  }
  .camino th,
  .camino td {
    text-align: left;
    vertical-align: top;
  }
  .camino tbody th {
    font-family: var(--font-display);
    font-size: 1.0625rem;
    font-weight: 600;
    color: var(--color-ink, #e5e1e4);
  }
  .indice {
    display: block;
    margin-bottom: 0.2rem;
    font-family: var(--font-mono, ui-monospace, monospace);
    font-size: 0.6875rem;
    font-weight: 400;
    letter-spacing: 0.14em;
    color: var(--color-primary, #c0c1ff);
  }
  .celda-ia {
    color: var(--color-ink-soft, #c9c5c8);
  }
  .celda-persona {
    position: relative;
    color: var(--color-ink, #e5e1e4);
  }
  .compuerta {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 1.75rem;
    height: 1.75rem;
    border-radius: 999px;
    color: var(--color-on-primary, #0b0080);
    background: linear-gradient(135deg, #c0c1ff, #8083ff);
    box-shadow:
      0 0 0 4px rgb(128 131 255 / 0.16),
      0 6px 20px -4px rgb(128 131 255 / 0.7);
  }
  .rotulo-movil {
    display: none;
  }

  /* ── Celular: cada fila es una tarjeta ── */
  @media (max-width: 767.98px) {
    .camino table,
    .camino thead,
    .camino tbody,
    .camino tr,
    .camino th,
    .camino td {
      display: block;
    }
    .camino thead tr {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip: rect(0 0 0 0);
      white-space: nowrap;
    }
    .camino tbody {
      display: grid;
      gap: 0.75rem;
    }
    .camino tbody tr {
      border-radius: var(--radius-card, 1rem);
      background: var(--color-surface-low, #1c1b1e);
      box-shadow: inset 0 1px 0 rgb(229 225 228 / 0.05);
      padding: 1.125rem 1.125rem 1.25rem;
    }
    .sobre-bajo tbody tr {
      background: var(--color-surface-high, #2a2a2c);
    }
    .camino tbody th {
      padding-bottom: 0.875rem;
    }
    .rotulo-movil {
      display: flex;
      align-items: center;
      gap: 0.4rem;
      margin-bottom: 0.3rem;
      font-family: var(--font-mono, ui-monospace, monospace);
      font-size: 0.6875rem;
      letter-spacing: 0.12em;
      text-transform: uppercase;
      color: var(--color-ink-mute, #a19da0);
    }
    .celda-persona .rotulo-movil {
      color: var(--color-primary, #c0c1ff);
    }
    .celda-ia {
      border-radius: 0.75rem;
      padding: 0.75rem 0.875rem;
      background: rgb(14 14 16 / 0.45);
    }
    .celda-persona {
      margin-top: 1.5rem;
      border-radius: 0.75rem;
      padding: 0.75rem 0.875rem;
      background: rgb(128 131 255 / 0.1);
      box-shadow: inset 0 0 0 1px rgb(192 193 255 / 0.22);
    }
    /* La compuerta queda entre las dos cajas, con un trazo vertical. */
    .compuerta {
      position: absolute;
      left: 50%;
      top: -1.5rem;
      translate: -50% -50%;
      width: 1.5rem;
      height: 1.5rem;
    }
    .celda-persona::before {
      content: '';
      position: absolute;
      left: 50%;
      top: -1.5rem;
      height: 1.5rem;
      width: 1px;
      background: linear-gradient(rgb(192 193 255 / 0.1), rgb(192 193 255 / 0.6));
    }
  }

  /* ── Tableta y computador: recorrido en tres columnas ── */
  @media (min-width: 768px) {
    .camino {
      border-radius: var(--radius-panel, 1.5rem);
      background: var(--color-surface, #131315);
      box-shadow: inset 0 0 0 1px rgb(70 69 84 / 0.35);
      overflow: hidden;
    }
    .sobre-bajo.camino {
      background: rgb(14 14 16 / 0.55);
    }
    .camino thead th {
      padding: 1.1rem 1.5rem;
      font-family: var(--font-mono, ui-monospace, monospace);
      font-size: 0.6875rem;
      font-weight: 500;
      letter-spacing: 0.14em;
      text-transform: uppercase;
      color: var(--color-ink-soft, #c9c5c8);
      box-shadow: inset 0 -1px 0 rgb(229 225 228 / 0.07);
    }
    .camino thead .col-ia {
      color: var(--color-ink-soft, #c9c5c8);
    }
    .camino thead .col-persona {
      color: var(--color-primary, #c0c1ff);
      padding-left: 3.25rem;
      background: rgb(128 131 255 / 0.08);
    }
    .camino tbody th,
    .camino tbody td {
      padding: 1.15rem 1.5rem;
      box-shadow: inset 0 1px 0 rgb(229 225 228 / 0.05);
    }
    .camino tbody tr:first-child th,
    .camino tbody tr:first-child td {
      box-shadow: none;
    }
    .camino tbody th {
      width: 24%;
    }
    .celda-ia {
      width: 36%;
      position: relative;
    }
    /* Trazo que sale de la IA y llega a la compuerta. */
    .celda-ia::after {
      content: '';
      position: absolute;
      right: 0;
      top: 1.95rem;
      width: 1.5rem;
      height: 1px;
      background: linear-gradient(90deg, rgb(192 193 255 / 0.05), rgb(192 193 255 / 0.55));
    }
    .celda-persona {
      padding-left: 3.25rem !important;
      background: rgb(128 131 255 / 0.08);
    }
    .compuerta {
      position: absolute;
      left: -0.875rem;
      top: 1.1rem;
    }
    .camino tbody tr:hover th,
    .camino tbody tr:hover .celda-ia {
      background: rgb(255 255 255 / 0.02);
    }
    .camino tbody tr:hover .celda-persona {
      background: rgb(128 131 255 / 0.13);
    }
  }

  /* La compuerta se enciende cuando la fila entra en pantalla. */
  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) {
      .compuerta {
        animation: camino-encender linear both;
        animation-timeline: view();
        animation-range: entry 40% cover 35%;
      }
    }
  }
  @keyframes camino-encender {
    from {
      scale: 0.4;
      opacity: 0.2;
      filter: grayscale(1);
    }
    to {
      scale: 1;
      opacity: 1;
      filter: none;
    }
  }
</style>
