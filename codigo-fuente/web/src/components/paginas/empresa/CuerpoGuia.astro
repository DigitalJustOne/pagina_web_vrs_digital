---
/**
 * Cuerpo de una guía: índice fijo a la izquierda (en celular, plegado) y el texto de la guía
 * con tipografía de lectura. El HTML llega preparado desde guias.ts (prepararGuia).
 *
 * Lectura cómoda: columna de ~68 caracteres; las tablas y la fórmula usan todo el ancho
 * disponible. Cada H2 lleva su número (01, 02…), el mismo del índice.
 *
 * <CuerpoGuia html={guia.html} indice={[{ texto: 'Precios publicados', href: '#precios-…' }]} tituloIndice="Contenido de la guía" />
 */
import IndicePagina from '@/components/pagina/IndicePagina.astro';
import type { Enlace } from '@/data/contenido/tipos';

interface Props {
  html: string;
  indice: readonly Enlace[];
  tituloIndice: string;
  class?: string;
}

const { html, indice, tituloIndice, class: clase } = Astro.props;
---
<div class:list={['contenedor grid gap-8 lg:grid-cols-12 lg:gap-14', clase]}>
  <aside class="min-w-0 lg:col-span-3">
    <div class="indice-fijo lg:sticky lg:top-[calc(var(--alto-encabezado)+2rem)]">
      <IndicePagina items={indice} titulo={tituloIndice} variante="lateral" />
    </div>
  </aside>

  <div class="cuerpo-guia prosa min-w-0 lg:col-span-9" set:html={html} />
</div>

<style>
  /* El índice nunca queda más alto que la pantalla (laptops de 768 px de alto). */
  @media (min-width: 1024px) {
    .indice-fijo {
      max-height: calc(100dvh - var(--alto-encabezado) - 4rem);
      overflow-y: auto;
      overscroll-behavior: contain;
      scrollbar-width: thin;
      scrollbar-color: rgb(192 193 255 / 0.25) transparent;
    }
  }

  /* ── Tipografía de lectura ─────────────────────────────────────────────── */
  .cuerpo-guia {
    counter-reset: guia-h2;
    font-size: 1.0625rem;
    line-height: 1.78;
    color: var(--color-ink-soft, #c9c5c8);
  }
  @media (min-width: 640px) {
    .cuerpo-guia {
      font-size: 1.125rem;
    }
  }
  /* Columna de lectura: ~68 caracteres. Tablas y fórmula usan el ancho completo. */
  .cuerpo-guia > :global(*) {
    max-width: 44rem;
  }
  .cuerpo-guia > :global(.tabla-guia),
  .cuerpo-guia > :global(blockquote) {
    max-width: none;
  }
  .cuerpo-guia > :global(:first-child) {
    margin-top: 0;
  }

  .cuerpo-guia :global(h2) {
    counter-increment: guia-h2;
    position: relative;
    margin: 4.5rem 0 1.25rem;
    padding-top: 2.25rem;
    font-size: clamp(1.625rem, 1.25rem + 1.4vw, 2.25rem);
    line-height: 1.15;
    letter-spacing: -0.02em;
    color: var(--color-ink, #e5e1e4);
    /* Sin scroll-margin-top: html ya reserva el encabezado con scroll-padding-top (global.css);
       sumar los dos dejaba el título del índice a ~200 px del borde. */
    box-shadow: inset 0 1px 0 rgb(229 225 228 / 0.08);
  }
  .cuerpo-guia :global(h2)::before {
    content: counter(guia-h2, decimal-leading-zero);
    display: block;
    margin-bottom: 0.75rem;
    font-family: var(--font-mono, ui-monospace, monospace);
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.2em;
    color: var(--color-primary, #c0c1ff);
  }
  /* Filo de luz sobre el número: marca el inicio de cada parte. */
  .cuerpo-guia :global(h2)::after {
    content: '';
    position: absolute;
    top: -1px;
    left: 0;
    width: 4rem;
    height: 2px;
    border-radius: 2px;
    background: linear-gradient(90deg, #c0c1ff, #8083ff);
  }
  .cuerpo-guia > :global(h2:first-child) {
    margin-top: 0;
  }
  .cuerpo-guia :global(h3) {
    margin: 2.5rem 0 0.75rem;
    font-size: 1.25rem;
    line-height: 1.35;
    color: var(--color-ink, #e5e1e4);
  }
  .cuerpo-guia :global(p),
  .cuerpo-guia :global(ul),
  .cuerpo-guia :global(ol) {
    margin-block: 1.1rem;
  }
  .cuerpo-guia :global(strong) {
    color: var(--color-ink, #e5e1e4);
    font-weight: 600;
  }
  .cuerpo-guia :global(em) {
    font-style: normal;
    color: var(--color-ink-mute, #a19da0);
  }
  .cuerpo-guia :global(a) {
    color: var(--color-primary, #c0c1ff);
    text-decoration: underline;
    text-decoration-color: rgb(192 193 255 / 0.4);
    text-underline-offset: 0.2em;
    text-decoration-thickness: 1px;
    transition: text-decoration-color 0.2s;
  }
  .cuerpo-guia :global(a:hover) {
    text-decoration-color: currentColor;
  }
  .cuerpo-guia :global(a.enlace-externo)::after {
    content: '↗' / '';
    display: inline-block;
    margin-left: 0.15em;
    font-size: 0.8em;
    text-decoration: none;
  }

  /* Listas: viñetas de marca y numeración en mono. */
  .cuerpo-guia :global(ul) {
    list-style: none;
    padding-left: 0;
  }
  .cuerpo-guia :global(ul > li) {
    position: relative;
    padding-left: 1.75rem;
    margin-block: 0.6rem;
  }
  .cuerpo-guia :global(ul > li)::before {
    content: '';
    position: absolute;
    left: 0.25rem;
    top: 0.72em;
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 2px;
    transform: rotate(45deg);
    background: linear-gradient(135deg, #c0c1ff, #8083ff);
  }
  .cuerpo-guia :global(ol) {
    list-style: none;
    counter-reset: guia-ol;
    padding-left: 0;
    display: grid;
    gap: 0.5rem;
  }
  .cuerpo-guia :global(ol > li) {
    counter-increment: guia-ol;
    position: relative;
    padding: 0.9rem 1.1rem 0.9rem 3.5rem;
    margin: 0;
    border-radius: var(--radius-card, 1rem);
    background: var(--color-surface-low, #1c1b1e);
    box-shadow: inset 0 1px 0 rgb(229 225 228 / 0.05);
  }
  .cuerpo-guia :global(ol > li)::before {
    content: counter(guia-ol, decimal-leading-zero);
    position: absolute;
    left: 1.1rem;
    top: 0.95rem;
    font-family: var(--font-mono, ui-monospace, monospace);
    font-size: 0.8125rem;
    line-height: 1.78rem;
    color: var(--color-primary, #c0c1ff);
  }

  /* Fórmula o cita destacada (> en Markdown). */
  .cuerpo-guia :global(blockquote) {
    position: relative;
    isolation: isolate;
    margin: 2rem 0;
    padding: 1.5rem 1.5rem 1.5rem 1.75rem;
    border-radius: var(--radius-panel, 1.5rem);
    background:
      radial-gradient(120% 140% at 0% 0%, rgb(128 131 255 / 0.18), transparent 60%),
      rgb(53 52 55 / 0.55);
    box-shadow: inset 0 0 0 1px rgb(192 193 255 / 0.22);
    font-family: var(--font-display);
    font-size: clamp(1.125rem, 1rem + 0.6vw, 1.375rem);
    line-height: 1.5;
    color: var(--color-ink, #e5e1e4);
  }
  .cuerpo-guia :global(blockquote p) {
    margin: 0;
  }
  .cuerpo-guia :global(blockquote strong) {
    background: linear-gradient(120deg, #e5e1e4 0%, #c0c1ff 45%, #8083ff 100%);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  /* Nota de IVA bajo los precios de VRS Digital. */
  .cuerpo-guia :global(.nota-precios) {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-top: -0.25rem;
    font-size: 0.875rem;
    line-height: 1.5;
    color: var(--color-ink-soft, #c9c5c8);
  }
  .cuerpo-guia :global(.nota-precios)::before {
    content: '';
    flex: none;
    width: 0.375rem;
    height: 0.375rem;
    border-radius: 999px;
    background: var(--color-primary, #c0c1ff);
  }

  /* ── Tablas ───────────────────────────────────────────────────────────── */
  .cuerpo-guia :global(.tabla-guia) {
    margin: 1.75rem 0;
    border-radius: var(--radius-panel, 1.5rem);
  }
  .cuerpo-guia :global(.tabla-guia:focus-visible) {
    outline: 2px solid var(--color-primary, #c0c1ff);
    outline-offset: 3px;
  }
  .cuerpo-guia :global(.tabla-guia table) {
    width: 100%;
    margin: 0;
    border-collapse: separate;
    border-spacing: 0;
    font-size: 0.9375rem;
    line-height: 1.55;
  }
  .cuerpo-guia :global(.tabla-guia th),
  .cuerpo-guia :global(.tabla-guia td) {
    text-align: left;
    vertical-align: top;
    background: none;
  }
  .cuerpo-guia :global(.tabla-guia td) {
    color: var(--color-ink-soft, #c9c5c8);
  }
  .cuerpo-guia :global(.tabla-guia tbody th) {
    font-family: var(--font-display);
    font-weight: 600;
    color: var(--color-ink, #e5e1e4);
  }
  /* Enlace del nombre de la fila (la fuente): área táctil de 44 px en todas las vistas. */
  .cuerpo-guia :global(.tabla-guia tbody th a) {
    display: inline-block;
    min-height: 2.75rem;
    padding-block: 0.625rem;
  }
  .cuerpo-guia :global(.tabla-guia caption) {
    caption-side: bottom;
    text-align: left;
    font-size: 0.875rem;
    line-height: 1.5;
    color: var(--color-ink-soft, #c9c5c8);
  }

  /* Celular: cada fila es una tarjeta con el nombre de cada columna. */
  @media (max-width: 767.98px) {
    .cuerpo-guia :global(.tabla-guia table),
    .cuerpo-guia :global(.tabla-guia thead),
    .cuerpo-guia :global(.tabla-guia tbody),
    .cuerpo-guia :global(.tabla-guia tr),
    .cuerpo-guia :global(.tabla-guia th),
    .cuerpo-guia :global(.tabla-guia td),
    .cuerpo-guia :global(.tabla-guia caption) {
      display: block;
    }
    .cuerpo-guia :global(.tabla-guia thead tr) {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip: rect(0 0 0 0);
      white-space: nowrap;
    }
    .cuerpo-guia :global(.tabla-guia tbody) {
      display: grid;
      gap: 0.75rem;
    }
    .cuerpo-guia :global(.tabla-guia tbody tr) {
      border-radius: var(--radius-card, 1rem);
      background: var(--color-surface-low, #1c1b1e);
      box-shadow: inset 0 1px 0 rgb(229 225 228 / 0.05);
      padding: 1rem 1.125rem 0.375rem;
    }
    .cuerpo-guia :global(.tabla-guia tbody th) {
      font-size: 1.0625rem;
      line-height: 1.35;
      padding: 0 0 0.625rem;
    }

    .cuerpo-guia :global(.tabla-guia td) {
      padding: 0.625rem 0;
      box-shadow: inset 0 1px 0 rgb(229 225 228 / 0.07);
    }
    /* La leyenda va debajo de las tarjetas (en bloque, «caption-side» no aplica). */
    .cuerpo-guia :global(.tabla-guia table) {
      display: flex;
      flex-direction: column;
    }
    .cuerpo-guia :global(.tabla-guia caption) {
      order: 2;
      margin-top: 0.75rem;
    }
    .cuerpo-guia :global(.col-movil) {
      display: block;
      margin-bottom: 0.2rem;
      font-family: var(--font-mono, ui-monospace, monospace);
      font-size: 0.6875rem;
      letter-spacing: 0.14em;
      text-transform: uppercase;
      color: var(--color-ink-mute, #a19da0);
    }
  }

  /* Tableta y computador: tabla con encabezado en mono y filas que se iluminan. */
  @media (min-width: 768px) {
    .cuerpo-guia :global(.tabla-guia) {
      overflow-x: auto;
      background: var(--color-surface-low, #1c1b1e);
      box-shadow: inset 0 0 0 1px rgb(70 69 84 / 0.35);
    }
    /* .prosa pone las tablas en display:block; aquí vuelven a ser tablas. */
    .cuerpo-guia :global(.tabla-guia table) {
      display: table;
      overflow: visible;
    }
    .cuerpo-guia :global(.tabla-guia thead th) {
      padding: 0.95rem 1.1rem;
      background: rgb(14 14 16 / 0.6);
      font-family: var(--font-mono, ui-monospace, monospace);
      font-size: 0.6875rem;
      font-weight: 500;
      letter-spacing: 0.14em;
      text-transform: uppercase;
      color: var(--color-primary, #c0c1ff);
      white-space: nowrap;
    }
    .cuerpo-guia :global(.tabla-guia tbody th),
    .cuerpo-guia :global(.tabla-guia tbody td) {
      padding: 1rem 1.1rem;
      box-shadow: inset 0 1px 0 rgb(229 225 228 / 0.06);
    }
    .cuerpo-guia :global(.tabla-guia tbody th) {
      min-width: 9.5rem;
    }
    /* Con enlace de 44 px, menos relleno: la primera línea queda alineada con las demás celdas. */
    .cuerpo-guia :global(.tabla-guia tbody th:has(> a)) {
      padding-block: 0.3rem;
    }
    .cuerpo-guia :global(.tabla-guia tbody tr:hover th),
    .cuerpo-guia :global(.tabla-guia tbody tr:hover td) {
      background: rgb(128 131 255 / 0.05);
    }
    .cuerpo-guia :global(.tabla-guia caption) {
      padding: 0.9rem 1.1rem;
      box-shadow: inset 0 1px 0 rgb(229 225 228 / 0.06);
    }
    .cuerpo-guia :global(.col-movil) {
      display: none;
    }
  }
</style>
