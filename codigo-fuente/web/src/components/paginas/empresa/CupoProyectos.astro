---
/**
 * Sección «capacidad» de /nosotros/: los límites del estudio, con un visual del cupo.
 * - Izquierda (fija en computador): título y el «tablero de cupo»: dos carriles encendidos
 *   (los dos proyectos activos como máximo) y un tercero apagado con candado. La cifra y su
 *   texto salen de CIFRAS (sitio.ts); no muestra ocupación real, solo el límite.
 * - Derecha: cada límite en una fila numerada (título y explicación).
 * - Pie: la nota de la sección (la disponibilidad 24 horas es del sitio y del agente).
 *
 * <CupoProyectos seccion={s} fondo="base" numero={3} resaltado="a propósito" />
 */
import Icono from '@/components/ui/Icono.astro';
import type { SeccionLista } from '@/data/contenido/tipos';
import { CIFRAS } from '@/data/sitio';
import MarcoEmpresa from './MarcoEmpresa.astro';

interface Props {
  seccion: SeccionLista;
  fondo?: 'base' | 'bajo';
  numero?: number;
  resaltado?: string;
}

const { seccion: s, fondo = 'base', numero, resaltado } = Astro.props;
const cupo = CIFRAS.find((c) => c.etiqueta.includes('proyectos activos')) ?? CIFRAS[CIFRAS.length - 1];
const maximo = Number.parseInt(cupo.valor, 10) || 2;
const items = s.items.map((it) => (typeof it === 'string' ? { titulo: '', texto: it } : it));
const capa = fondo === 'bajo' ? 'bg-surface-high' : 'bg-surface-low';
---
<MarcoEmpresa seccion={s} fondo={fondo} numero={numero} resaltado={resaltado} disposicion="dividido">
  <div slot="lateral" class="tablero vidrio borde-luz relative isolate mt-10 overflow-hidden rounded-panel p-6 sm:p-7">
    <span aria-hidden="true" class="tablero-luz pointer-events-none absolute -z-10"></span>
    <p class="flex items-end gap-4">
      <span class="font-display text-[4.5rem] leading-[0.8] font-semibold tracking-[-0.05em] text-primary">
        <span data-contar>{cupo.valor}</span>
      </span>
      <span class="max-w-[13rem] pb-1 text-[0.9375rem] leading-snug text-ink-soft">{cupo.etiqueta}</span>
    </p>
    <div aria-hidden="true" class="carriles mt-7 grid gap-2.5">
      {
        Array.from({ length: maximo }, (_, i) => (
          <span class="carril activo" style={`--i:${i}`}>
            <span class="font-mono text-[0.6875rem] tracking-[0.14em]">{String(i + 1).padStart(2, '0')}</span>
            <span class="barra"><span /></span>
            <Icono nombre="tick" tamano={14} />
          </span>
        ))
      }
      <span class="carril cerrado">
        <span class="font-mono text-[0.6875rem] tracking-[0.14em]">{String(maximo + 1).padStart(2, '0')}</span>
        <span class="barra" />
        <Icono nombre="lock" tamano={14} />
      </span>
    </div>
  </div>

  <ol role="list" class="grid gap-3">
    {
      items.map((it, i) => (
        <li data-revelar style={`--retraso:${i * 70}ms`} class:list={['limite flex gap-4 rounded-card p-5 sm:gap-5 sm:p-6', capa]}>
          <span aria-hidden="true" class="mt-0.5 flex h-8 w-8 shrink-0 items-center justify-center rounded-lg bg-primary/12 font-mono text-xs text-primary">
            {String(i + 1).padStart(2, '0')}
          </span>
          <div class="min-w-0">
            {it.titulo && <h3 class="titulo-tarjeta">{it.titulo}</h3>}
            <p class:list={['leading-relaxed text-ink-soft', it.titulo && 'mt-1.5']}>{it.texto}</p>
          </div>
        </li>
      ))
    }
  </ol>
</MarcoEmpresa>

<style>
  .tablero-luz {
    right: -8rem;
    top: -9rem;
    width: 22rem;
    height: 22rem;
    border-radius: 999px;
    background: radial-gradient(circle, rgb(128 131 255 / 0.28), transparent 70%);
  }
  .carril {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: 0.75rem;
    border-radius: 0.75rem;
    padding: 0.7rem 0.85rem;
  }
  .carril.activo {
    color: var(--color-primary, #c0c1ff);
    background: rgb(128 131 255 / 0.12);
    box-shadow: inset 0 0 0 1px rgb(192 193 255 / 0.25);
  }
  .carril.cerrado {
    color: var(--color-ink-mute, #a19da0);
    box-shadow: inset 0 0 0 1px rgb(229 225 228 / 0.14);
    background-image: repeating-linear-gradient(135deg, rgb(229 225 228 / 0.05) 0 6px, transparent 6px 12px);
  }
  .barra {
    position: relative;
    height: 0.375rem;
    border-radius: 999px;
    overflow: hidden;
    background: rgb(229 225 228 / 0.08);
  }
  .activo .barra > span {
    position: absolute;
    inset: 0;
    border-radius: inherit;
    background: linear-gradient(90deg, #8083ff, #c0c1ff);
  }
  .activo .barra > span::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(90deg, transparent, rgb(255 255 255 / 0.55), transparent);
    translate: -100% 0;
  }
  .limite {
    box-shadow: inset 0 1px 0 rgb(229 225 228 / 0.05);
  }
  @media (prefers-reduced-motion: no-preference) {
    .activo .barra > span::after {
      animation: cupo-brillo 3.2s ease-in-out infinite;
      animation-delay: calc(var(--i, 0) * 0.6s);
    }
  }
  @keyframes cupo-brillo {
    0% {
      translate: -100% 0;
    }
    60%,
    100% {
      translate: 100% 0;
    }
  }
</style>
