---
/**
 * Portada de una guía (/recursos/<slug>/): migas, etiqueta, H1 (el único de la página, sin
 * animación: es el LCP), descripción, firma con el retrato del autor y una ficha técnica
 * (publicada, actualizada, lectura, fuentes y preguntas).
 * Fondo: el mismo suelo en perspectiva y las luces de las demás portadas (CSS, sin JS).
 *
 * <EncabezadoGuia titulo="…" bajada="…" migas={[…]} etiqueta="Guía · Precios" firma="Por <strong>…</strong>…"
 *   ficha={[{ rotulo: 'Publicada', valor: '6 de octubre de 2026', fecha: '2026-10-06' }]} />
 */
import Migas from '@/components/ui/Migas.astro';
import Icono from '@/components/ui/Icono.astro';
import type { NombreIcono } from '@/components/ui/iconos';
import { FUNDADOR } from '@/data/sitio';

interface Dato {
  rotulo: string;
  valor: string;
  /** AAAA-MM-DD: el valor se marca con <time>. */
  fecha?: string;
  icono: NombreIcono;
}

interface Props {
  titulo: string;
  bajada: string;
  etiqueta: string;
  migas: readonly { nombre: string; ruta: string }[];
  /** HTML de la firma (viene del Markdown de la guía, ya escapado por Astro). */
  firma?: string;
  rotuloFicha: string;
  ficha: readonly Dato[];
}

const { titulo, bajada, etiqueta, migas, firma, rotuloFicha, ficha } = Astro.props;
// Avatar de 128 px (unos 3 KB) para la firma de 56 px: no descarga el retrato de 1024 px.
const AVATAR = '/img/miniaturas/hero-image-128.webp';
---
<header aria-labelledby="titulo-pagina" class="portada-guia relative isolate pt-[calc(var(--alto-encabezado)+1.75rem)] pb-10 lg:pt-[calc(var(--alto-encabezado)+2.5rem)] lg:pb-14">
  <div aria-hidden="true" class="portada-fondo pointer-events-none absolute inset-0 -z-10">
    <span class="portada-luz portada-luz-a"></span>
    <span class="portada-luz portada-luz-b"></span>
    <span class="portada-suelo"><span class="portada-reticula"></span></span>
  </div>

  <div class="contenedor">
    <Migas items={migas} class="-ml-1 mb-4 lg:mb-8" />

    <div class="lg:grid lg:grid-cols-12 lg:items-end lg:gap-12">
    <div class="max-w-[58rem] lg:col-span-8">
      <h1 id="titulo-pagina" class="titulo-pagina">{titulo}</h1>
      <p class="texto-guia mt-6 sm:text-xl sm:leading-relaxed">{bajada}</p>

      {
        firma && (
          <div class="entra mt-8 flex items-center gap-4" style="--d:120ms">
            <picture class="avatar borde-luz shrink-0 overflow-hidden rounded-full">
              <source srcset={AVATAR} type="image/webp" />
              <img src={FUNDADOR.foto} alt="" width="56" height="56" loading="eager" decoding="async" class="h-14 w-14 object-cover object-top" />
            </picture>
            <p class="firma max-w-2xl text-[0.9375rem] leading-relaxed text-ink-soft" set:html={firma} />
          </div>
        )
      }
    </div>

    <div class="entra mt-10 lg:col-span-4 lg:mt-0" style="--d:200ms">
      <p class="sr-only">{rotuloFicha}</p>
      <dl class="ficha borde-fantasma grid grid-cols-2 overflow-hidden rounded-panel sm:grid-cols-3 lg:grid-cols-1">
        {
          ficha.map((d) => (
            <div class="dato flex flex-col gap-1.5 px-5 py-4 sm:px-6 sm:py-5 lg:py-4">
              <dt class="flex items-center gap-2 font-mono text-[0.6875rem] tracking-[0.16em] text-ink-soft uppercase">
                <Icono nombre={d.icono} tamano={14} class="text-primary" />
                {d.rotulo}
              </dt>
              <dd class="font-display text-lg leading-tight font-semibold text-ink sm:text-xl">
                {d.fecha ? <time datetime={d.fecha}>{d.valor}</time> : d.valor}
              </dd>
            </div>
          ))
        }
      </dl>
    </div>
    </div>
  </div>
</header>

<style>
  .portada-fondo {
    overflow: clip;
  }
  .portada-luz {
    position: absolute;
    border-radius: 999px;
    filter: blur(80px);
  }
  .portada-luz-a {
    width: min(48rem, 120vw);
    aspect-ratio: 1;
    left: -18rem;
    top: -22rem;
    background: radial-gradient(circle, rgb(99 102 241 / 0.3), transparent 65%);
  }
  .portada-luz-b {
    width: min(36rem, 90vw);
    aspect-ratio: 1;
    right: -12rem;
    top: 0;
    background: radial-gradient(circle, rgb(192 193 255 / 0.12), transparent 65%);
  }
  .portada-suelo {
    position: absolute;
    inset: auto 0 0;
    height: 55%;
    perspective: 520px;
    perspective-origin: 50% 0%;
    -webkit-mask-image: linear-gradient(to top, #000 10%, transparent 92%);
    mask-image: linear-gradient(to top, #000 10%, transparent 92%);
  }
  /* Sobra un cuadro (64 px) por arriba para moverla con transform sin dejar borde vacío. */
  .portada-reticula {
    position: absolute;
    left: -50%;
    right: -50%;
    top: -64px;
    height: calc(200% + 64px);
    transform: rotateX(72deg);
    transform-origin: 50% 64px;
    background-image:
      linear-gradient(rgb(192 193 255 / 0.14) 1px, transparent 1px),
      linear-gradient(90deg, rgb(192 193 255 / 0.1) 1px, transparent 1px);
    background-size: 64px 64px;
  }
  .avatar {
    background: radial-gradient(circle at 50% 35%, rgb(128 131 255 / 0.45), rgb(28 27 30) 70%);
  }
  .firma :global(strong) {
    color: var(--color-ink, #e5e1e4);
    font-weight: 600;
  }
  .ficha {
    background: rgb(14 14 16 / 0.55);
    -webkit-backdrop-filter: blur(16px);
    backdrop-filter: blur(16px);
  }
  /* Celular (2 columnas): el último dato impar ocupa toda la fila. */
  .dato:last-child:nth-child(odd) {
    grid-column: 1 / -1;
  }
  @media (min-width: 640px) and (max-width: 1023.98px) {
    .dato:last-child:nth-child(odd) {
      grid-column: auto / span 2;
    }
  }
  @media (min-width: 1024px) {
    .dato:last-child:nth-child(odd) {
      grid-column: auto;
    }
  }
  /* Separadores finos entre datos (sin bordes dobles en ninguna cuadrícula). */
  .dato {
    box-shadow:
      inset 1px 0 0 rgb(229 225 228 / 0.06),
      inset 0 1px 0 rgb(229 225 228 / 0.06);
  }

  @media (prefers-reduced-motion: no-preference) {
    .portada-reticula {
      animation: portada-avanzar 7s linear infinite;
      will-change: transform;
    }
    .entra {
      animation: portada-entrar 0.9s var(--ease-out-expo) both;
      animation-delay: var(--d, 0ms);
    }
  }
  @keyframes portada-avanzar {
    from {
      transform: rotateX(72deg) translateY(0);
    }
    to {
      transform: rotateX(72deg) translateY(64px);
    }
  }
  @keyframes portada-entrar {
    from {
      opacity: 0;
      transform: translateY(16px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }
</style>
