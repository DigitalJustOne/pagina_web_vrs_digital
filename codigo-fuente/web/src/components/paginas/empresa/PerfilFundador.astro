---
/**
 * Sección «responsable» de /nosotros/ (reemplaza la sección «perfil» de la plantilla, que
 * repetiría el retrato grande que ya está en la portada).
 *
 * - Izquierda (fija en computador): título y una tarjeta de identidad (nombre completo, cargo,
 *   LinkedIn y GitHub).
 * - Derecha: el primer párrafo se ilumina palabra por palabra al bajar; luego los demás párrafos,
 *   la línea de etapas («la misma persona en cada etapa»: el mismo rostro en las seis) y las
 *   cifras verificadas (CIFRAS) con contador.
 *
 * <PerfilFundador seccion={s} fondo="base" numero={1} resaltado="de principio a fin" />
 */
import Cifras from '@/components/pagina/Cifras.astro';
import Icono from '@/components/ui/Icono.astro';
import { etapasFundador } from '@/data/contenido/nosotros';
import type { SeccionPerfil } from '@/data/contenido/tipos';
import { imagenPublica } from '@/lib/casos';
import MarcoEmpresa from './MarcoEmpresa.astro';

interface Props {
  seccion: SeccionPerfil;
  fondo?: 'base' | 'bajo';
  numero?: number;
  resaltado?: string;
}

const { seccion: s, fondo = 'base', numero, resaltado } = Astro.props;
const persona = s.persona;
const [entrada, ...resto] = s.parrafos;
const foto = imagenPublica(persona.foto);
const tono = fondo === 'bajo' ? 'bajo' : 'base';
---
<MarcoEmpresa seccion={s} fondo={fondo} numero={numero} resaltado={resaltado} disposicion="dividido" parrafos={[]}>
  <div slot="lateral" class="identidad borde-fantasma mt-10 flex items-center gap-4 rounded-panel p-4 sm:p-5">
    <picture class="avatar shrink-0 overflow-hidden rounded-2xl">
      {foto.webp && <source srcset={foto.webp} type="image/webp" />}
      <img src={persona.foto} alt="" width="72" height="72" loading="lazy" decoding="async" class="h-[4.5rem] w-[4.5rem] object-cover object-top" />
    </picture>
    <div class="min-w-0">
      <p class="font-display text-lg leading-tight font-semibold text-ink">{persona.nombre}</p>
      <p class="mt-1 text-sm leading-snug text-ink-soft">{persona.cargo}</p>
      {
        persona.enlaces && persona.enlaces.length > 0 && (
          <ul role="list" class="mt-1 flex flex-wrap gap-x-4">
            {persona.enlaces.map((e) => (
              <li>
                <a href={e.href} target="_blank" rel="noopener noreferrer" class="inline-flex min-h-11 items-center gap-1.5 text-sm font-semibold text-primary underline-offset-4 hover:underline">
                  {e.texto}
                  <span class="sr-only"> de {persona.nombreCorto ?? persona.nombre} (se abre en una pestaña nueva)</span>
                  <Icono nombre="arrow-up-right" tamano={15} />
                </a>
              </li>
            ))}
          </ul>
        )
      }
    </div>
  </div>

  {
    entrada && (
      <p data-revelar-texto="desplazamiento" class="font-display text-[1.375rem] leading-snug font-medium tracking-[-0.01em] text-ink sm:text-[1.75rem] sm:leading-[1.3]">
        {entrada}
      </p>
    )
  }
  {resto.length > 0 && <div class="mt-6 grid gap-4 text-[1.0625rem] leading-relaxed text-ink-soft sm:text-lg">{resto.map((p) => <p>{p}</p>)}</div>}

  <figure class="etapas mt-10">
    <figcaption class="flex items-center gap-3 font-mono text-xs tracking-[0.18em] text-ink-soft uppercase">
      <span aria-hidden="true" class="h-px w-8 bg-linear-to-r from-primary/0 to-primary/80"></span>
      {etapasFundador.titulo}
    </figcaption>
    <ol role="list" class="linea mt-5 grid grid-cols-3 gap-x-3 gap-y-6 sm:grid-cols-6">
      {
        etapasFundador.etapas.map((etapa, i) => (
          <li data-revelar style={`--retraso:${i * 90}ms`} class="etapa flex flex-col items-center gap-2.5 text-center">
            <span class="nodo relative flex h-14 w-14 items-center justify-center rounded-full">
              <picture class="block h-12 w-12 overflow-hidden rounded-full">
                {foto.webp && <source srcset={foto.webp} type="image/webp" />}
                <img src={persona.foto} alt="" width="48" height="48" loading="lazy" decoding="async" class="h-12 w-12 object-cover object-top" />
              </picture>
              <span aria-hidden="true" class="num absolute -top-1 -right-1 flex h-5 w-5 items-center justify-center rounded-full font-mono text-[0.625rem] text-on-primary">
                {i + 1}
              </span>
            </span>
            <span class="text-sm leading-tight font-medium text-ink">
              {etapa}
              <span class="sr-only">: {persona.nombreCorto ?? persona.nombre}</span>
            </span>
          </li>
        ))
      }
    </ol>
  </figure>

  {s.cifras && s.cifras.length > 0 && <Cifras cifras={s.cifras} fondo={tono} class="mt-10" />}
</MarcoEmpresa>

<style>
  .identidad {
    background: rgb(14 14 16 / 0.45);
  }
  .avatar {
    background: radial-gradient(circle at 50% 35%, rgb(128 131 255 / 0.5), rgb(28 27 30) 72%);
    box-shadow: inset 0 0 0 1px rgb(192 193 255 / 0.2);
  }
  .nodo {
    background: radial-gradient(circle at 50% 35%, rgb(128 131 255 / 0.5), rgb(28 27 30) 72%);
    box-shadow:
      0 0 0 1px rgb(192 193 255 / 0.35),
      0 10px 30px -10px rgb(128 131 255 / 0.6);
  }
  .num {
    background: linear-gradient(135deg, #c0c1ff, #8083ff);
  }
  /* Línea que une las etapas (computador y tableta). Se dibuja al entrar en pantalla. */
  .linea {
    position: relative;
  }
  @media (min-width: 640px) {
    .linea::before {
      content: '';
      position: absolute;
      top: 1.75rem;
      left: calc(100% / 12);
      right: calc(100% / 12);
      height: 1px;
      background: linear-gradient(90deg, rgb(192 193 255 / 0.6), rgb(128 131 255 / 0.35));
      transform-origin: 0 50%;
    }
  }
  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) and (min-width: 640px) {
      .linea::before {
        animation: etapas-trazar linear both;
        animation-timeline: view();
        animation-range: entry 30% cover 45%;
      }
    }
  }
  @keyframes etapas-trazar {
    from {
      transform: scaleX(0);
    }
    to {
      transform: scaleX(1);
    }
  }
</style>
