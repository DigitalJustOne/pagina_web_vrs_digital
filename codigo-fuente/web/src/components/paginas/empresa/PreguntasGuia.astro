---
/**
 * Preguntas frecuentes de una guía (#preguntas), con la misma presentación que las demás
 * páginas: encabezado fijo a la izquierda con el botón de WhatsApp y la lista nativa
 * <details> a la derecha. Las respuestas con un precio de VRS Digital llevan la nota de IVA
 * (componente Preguntas).
 *
 * <PreguntasGuia preguntas={…} etiqueta="Dudas comunes" titulo="Preguntas frecuentes" mensajeWhatsApp="Hola…" />
 */
import EncabezadoSeccion from '@/components/ui/EncabezadoSeccion.astro';
import Icono from '@/components/ui/Icono.astro';
import Preguntas from '@/components/ui/Preguntas.astro';
import { CONTACTO, enlaceWhatsApp } from '@/data/sitio';

interface Props {
  preguntas: readonly { pregunta: string; respuesta: string }[];
  etiqueta: string;
  titulo: string;
  mensajeWhatsApp?: string;
  fondo?: 'base' | 'bajo';
}

const { preguntas, etiqueta, titulo, mensajeWhatsApp, fondo = 'bajo' } = Astro.props;
---
<section id="preguntas" aria-labelledby="preguntas-titulo" class:list={['seccion relative isolate', fondo === 'bajo' && 'fondo-bajo bg-surface-low']}>
  <div class="contenedor grid gap-10 lg:grid-cols-12 lg:gap-14">
    <div class="lg:col-span-4">
      <div class="lg:sticky lg:top-[calc(var(--alto-encabezado)+2.5rem)]">
        <EncabezadoSeccion etiqueta={etiqueta} titulo={titulo} id="preguntas-titulo" />
        {
          mensajeWhatsApp && (
            <div class="mt-8 max-w-sm">
              <p class="leading-relaxed text-ink-soft">¿Tiene otra pregunta? {CONTACTO.respuestaHumana}</p>
              <a href={enlaceWhatsApp(mensajeWhatsApp)} target="_blank" rel="noopener noreferrer" class="boton boton-secundario mt-4 w-full sm:w-auto">
                <Icono nombre="whatsapp" tamano={20} class="icono-whatsapp" />
                Preguntar por WhatsApp
                <span class="sr-only"> (se abre en una pestaña nueva)</span>
              </a>
            </div>
          )
        }
      </div>
    </div>
    <div class="min-w-0 lg:col-span-8">
      <Preguntas preguntas={preguntas} fondo={fondo} />
    </div>
  </div>
</section>

<style>
  .fondo-bajo::before {
    content: '';
    position: absolute;
    inset: 0 0 auto;
    height: 1px;
    background: linear-gradient(90deg, transparent, rgb(192 193 255 / 0.28) 30%, rgb(128 131 255 / 0.22) 70%, transparent);
  }
</style>
