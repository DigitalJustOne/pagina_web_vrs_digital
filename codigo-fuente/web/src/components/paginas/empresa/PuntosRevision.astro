---
/**
 * Sección «que-revisamos» de /contacto/: los cinco puntos de la revisión como un recorrido.
 * - Computador: cinco columnas; los iconos son nodos sobre una línea que recorre un destello
 *   (el «escaneo»).
 * - Tableta: dos columnas de tarjetas (el quinto punto ocupa el ancho completo).
 * - Celular: tarjetas en una columna.
 * Cada punto: número, icono, título H3 y explicación (del módulo de /contacto/).
 *
 * <PuntosRevision seccion={s} fondo="base" numero={1} resaltado="su empresa" />
 */
import Icono from '@/components/ui/Icono.astro';
import type { SeccionTarjetas } from '@/data/contenido/tipos';
import MarcoEmpresa from './MarcoEmpresa.astro';

interface Props {
  seccion: SeccionTarjetas;
  fondo?: 'base' | 'bajo';
  numero?: number;
  resaltado?: string;
}

const { seccion: s, fondo = 'base', numero, resaltado } = Astro.props;
const capa = fondo === 'bajo' ? 'bg-surface-high' : 'bg-surface-low';
---
<MarcoEmpresa seccion={s} fondo={fondo} numero={numero} resaltado={resaltado}>
  <ol role="list" class="recorrido relative grid gap-3 sm:grid-cols-2 sm:gap-4 lg:grid-cols-5">
    <span aria-hidden="true" class="riel pointer-events-none"><span class="destello"></span></span>
    {
      s.items.map((it, i) => (
        <li data-revelar style={`--retraso:${i * 90}ms`} class:list={['punto relative flex gap-4 rounded-panel p-5 sm:flex-col sm:p-6', capa, i === s.items.length - 1 && 'sm:col-span-2 lg:col-span-1']}>
          <span class="icono relative z-10 flex h-12 w-12 shrink-0 items-center justify-center rounded-2xl text-primary">
            {it.icono && <Icono nombre={it.icono} tamano={22} />}
          </span>
          <div class="min-w-0">
            <p aria-hidden="true" class="font-mono text-[0.6875rem] tracking-[0.16em] text-ink-mute">{String(i + 1).padStart(2, '0')}</p>
            <h3 class="titulo-tarjeta mt-1">{it.titulo}</h3>
            <p class="mt-2 text-[0.9375rem] leading-relaxed text-ink-soft">{it.texto}</p>
          </div>
        </li>
      ))
    }
  </ol>
</MarcoEmpresa>

<style>
  .punto {
    z-index: 1;
    box-shadow: inset 0 1px 0 rgb(229 225 228 / 0.05);
  }
  .icono {
    background: var(--color-surface-lowest, #0e0e10);
    box-shadow:
      inset 0 0 0 1px rgb(192 193 255 / 0.22),
      0 8px 24px -10px rgb(128 131 255 / 0.6);
  }
  /* Riel del escaneo (solo computador): pasa por el centro de los iconos, que quedan como
     nodos sobre la línea; un destello lo recorre. En celular y tableta, tarjetas sin riel. */
  .riel {
    display: none;
  }
  @media (min-width: 1024px) {
    .recorrido {
      column-gap: 2rem;
    }
    .punto {
      padding: 0;
      background: none;
      box-shadow: none;
    }
    .riel {
      display: block;
      position: absolute;
      z-index: 0;
      left: 0;
      right: 0;
      top: 1.5rem;
      height: 1px;
      overflow: hidden;
      container-type: inline-size;
      background: linear-gradient(90deg, rgb(192 193 255 / 0.45), rgb(128 131 255 / 0.12));
    }
    /* Se mueve con translate (no con left): el compositor lo anima sin recalcular el diseño. */
    .destello {
      position: absolute;
      top: 0;
      left: 0;
      translate: -100% 0;
      width: 6rem;
      height: 1px;
      background: linear-gradient(90deg, transparent, #c0c1ff, transparent);
      box-shadow: 0 0 10px 1px rgb(128 131 255 / 0.8);
    }
  }
  @media (prefers-reduced-motion: no-preference) and (min-width: 1024px) {
    .destello {
      animation: revision-avanzar 4.5s cubic-bezier(0.45, 0, 0.55, 1) infinite;
    }
  }
  @keyframes revision-avanzar {
    from {
      translate: -100% 0;
    }
    to {
      translate: 100cqw 0;
    }
  }
</style>
