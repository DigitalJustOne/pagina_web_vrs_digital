---
/**
 * Recorrido de la portada: «encuentran su empresa → entienden qué ofrece → reciben respuesta».
 * Historia fija (data-historia, src/scripts/desplazamiento.ts): a la izquierda los tres pasos,
 * a la derecha una pantalla que cambia con el desplazamiento (búsqueda, página web y WhatsApp)
 * y se inclina en 3D. Todo el texto sale de `recorrido` en src/data/contenido/inicio.ts.
 *
 * Estados:
 *   - Con movimiento, en computador (1024 px o más) y con espacio suficiente: la sección se queda
 *     fija mientras se recorren los pasos.
 *   - En celular, sin JS, con movimiento reducido o si el bloque no cabe en la pantalla: lista
 *     normal con las tres pantallas y los tres pasos completos (en celular la fijación recortaba
 *     el contenido).
 * Las pantallas son una ilustración (role="img" con su descripción); el ejemplo está rotulado.
 *
 * <Recorrido slot="despues-problema" />
 */
import EncabezadoSeccion from '@/components/ui/EncabezadoSeccion.astro';
import Icono from '@/components/ui/Icono.astro';
import Nota from '@/components/pagina/Nota.astro';
import { recorrido as r } from '@/data/contenido/inicio';

interface Props {
  class?: string;
}

const { class: clase } = Astro.props;
const idT = `${r.id}-titulo`;
const [m0, m1] = r.chat.mensajes;
const { empresa, busqueda, web, chat } = r;
const { seguimiento } = chat;
---
<section id={r.id} aria-labelledby={idT} class:list={['recorrido relative isolate', clase]}>
  <div aria-hidden="true" class="recorrido-fondo pointer-events-none absolute inset-0 -z-10">
    <span data-parallax="0.16" class="luz luz-a"></span>
    <span data-parallax="-0.1" class="luz luz-b"></span>
  </div>

  <div class="contenedor pt-20 lg:pt-28">
    <EncabezadoSeccion
      etiqueta={r.etiqueta}
      titulo={r.titulo}
      resaltado={r.resaltado}
      introduccion={r.introduccion}
      id={idT}
      dividido
    />
  </div>

  <div class="historia" data-historia>
    <div class="fijo contenedor" data-historia-fijo>
      <div class="rejilla">
        <ol role="list" aria-label={r.etiquetaPasos} class="pasos">
          {
            r.pasos.map((p) => (
              <li class="paso" data-historia-paso>
                <span aria-hidden="true" class="paso-icono">
                  <Icono nombre={p.icono} tamano={20} />
                </span>
                <div class="min-w-0">
                  <p class="paso-num">Paso {p.paso}</p>
                  <h3 class="paso-titulo">{p.titulo}</h3>
                  <p class="paso-texto">{p.texto}</p>
                </div>
                <span aria-hidden="true" class="paso-avance"></span>
              </li>
            ))
          }
        </ol>

        <div class="escenario">
          <p class="rotulo chip">
            <Icono nombre="info" tamano={14} />
            {r.rotulo}
          </p>
          <div class="marco" role="img" aria-label={r.etiquetaVisual}>
            <div class="escenas" aria-hidden="true">
              <!-- 1. Búsqueda -->
              <div class="escena e-busqueda" data-historia-escena>
                <div class="e-lienzo">
                  <div class="e-buscador e-anim" style="--n:0">
                    <Icono nombre="search" tamano={16} class="e-ico" />
                    <span class="e-consulta">{busqueda.consulta}</span>
                    <span class="e-cursor"></span>
                  </div>
                  <p class="e-rotulo e-anim" style="--n:1">{busqueda.rotulo}</p>
                  <div class="e-resultado e-tenue e-anim" style="--n:2">
                    <span class="e-l" style="width:34%"></span>
                    <span class="e-l e-l-alta" style="width:68%"></span>
                    <span class="e-l" style="width:90%"></span>
                  </div>
                  <div class="e-resultado e-destacado e-anim" style="--n:3">
                    <p class="e-sitio">
                      <span class="e-logo">{empresa.iniciales}</span>
                      <span class="e-sitio-texto">
                        <span class="e-sitio-nombre">{empresa.nombre}</span>
                        <span class="e-sitio-ciudad">{empresa.ciudad}</span>
                      </span>
                    </p>
                    <p class="e-enlace">{busqueda.titulo}</p>
                    <p class="e-desc">{busqueda.descripcion}</p>
                    <div class="e-faq">
                      {
                        busqueda.preguntas.map((q, i) => (
                          <p class="e-anim" style={`--n:${4 + i}`}>
                            <Icono nombre="chevron-down" tamano={14} class="e-ico" />
                            {q}
                          </p>
                        ))
                      }
                    </div>
                    <span class="e-sello e-anim" style="--n:6">
                      <Icono nombre="tick" tamano={14} class="e-ico" />
                      {busqueda.sello}
                    </span>
                  </div>
                  <div class="e-resultado e-tenue e-anim" style="--n:4">
                    <span class="e-l" style="width:28%"></span>
                    <span class="e-l e-l-alta" style="width:58%"></span>
                  </div>
                </div>
              </div>

              <!-- 2. Página web -->
              <div class="escena e-web" data-historia-escena>
                <div class="e-cromo">
                  <span class="e-puntos"><i></i><i></i><i></i></span>
                  <span class="e-url">
                    <Icono nombre="lock" tamano={12} class="e-ico" />
                    <span class="e-l" style="width:46%"></span>
                  </span>
                </div>
                <div class="e-lienzo">
                  <div class="e-nav e-anim" style="--n:0">
                    <span class="e-logo">{empresa.iniciales}</span>
                    <span class="e-marca">{empresa.nombre}</span>
                    <span class="e-nav-enlaces"><span class="e-l"></span><span class="e-l"></span><span class="e-l"></span></span>
                  </div>
                  <div class="e-portada">
                    <div class="e-portada-texto">
                      <div class="e-punto-guia e-anim" style="--n:1" data-guia="1">
                        <p class="e-etiqueta">{web.etiqueta}</p>
                        <p class="e-h">{web.titulo}</p>
                      </div>
                      <div class="e-punto-guia e-anim" style="--n:2" data-guia="2">
                        <div class="e-chips">{web.chips.map((c) => <span>{c}</span>)}</div>
                      </div>
                      <div class="e-punto-guia e-anim" style="--n:3" data-guia="3">
                        <div class="e-botones">
                          <span class="e-btn e-btn-wa">
                            <Icono nombre="whatsapp" tamano={14} class="e-ico" />
                            {web.botonWhatsApp}
                          </span>
                          <span class="e-btn e-btn-sec">{web.botonFormulario}</span>
                        </div>
                      </div>
                    </div>
                    <div class="e-foto e-anim" style="--n:2">
                      <span class="e-foto-icono"><Icono nombre="calculator" tamano={28} class="e-ico" /></span>
                      <span class="e-l" style="width:70%"></span>
                      <span class="e-l" style="width:46%"></span>
                    </div>
                  </div>
                  <div class="e-servicios">
                    {
                      (['file', 'calculator', 'users'] as const).map((ic, i) => (
                        <span class="e-servicio e-anim" style={`--n:${3 + i}`}>
                          <Icono nombre={ic} tamano={16} class="e-ico" />
                          <span class="e-l" style="width:80%" />
                          <span class="e-l" style="width:55%" />
                        </span>
                      ))
                    }
                  </div>
                  <div class="e-leyenda e-anim" style="--n:6">
                    <span><b>1</b>{web.anotaciones.que}</span>
                    <span><b>2</b>{web.anotaciones.quien}</span>
                    <span><b>3</b>{web.anotaciones.como}</span>
                  </div>
                </div>
              </div>

              <!-- 3. WhatsApp -->
              <div class="escena e-chat" data-historia-escena>
                <div class="e-chat-cabecera">
                  <span class="e-logo e-logo-redondo">{empresa.iniciales}</span>
                  <span class="e-chat-nombre">
                    <span class="e-sitio-nombre">{empresa.nombre}</span>
                    <span class="e-chat-estado"><i></i>{empresa.estado}</span>
                  </span>
                </div>
                <div class="e-lienzo e-chat-cuerpo">
                  {m0.separador && <span class="e-separador e-anim" style="--n:0">{m0.separador}</span>}
                  <div class="e-burbuja e-cliente e-anim" style="--n:1">
                    <span>{m0.texto}</span>
                    <span class="e-hora">{m0.hora}</span>
                  </div>
                  <span class="e-autor e-anim" style="--n:3">
                    <Icono nombre="spark" tamano={12} class="e-ico" />
                    {chat.autor}
                  </span>
                  <div class="e-escribiendo"><i></i><i></i><i></i></div>
                  <div class="e-burbuja e-agente e-anim" style="--n:4">
                    <span>{m1.texto}</span>
                    <span class="e-hora">{m1.hora}</span>
                  </div>
                  <span class="e-traspaso e-anim" style="--n:6">
                    <Icono nombre="user" tamano={14} class="e-ico" />
                    {chat.traspaso}
                  </span>
                  {seguimiento.separador && <span class="e-separador e-extra e-anim">{seguimiento.separador}</span>}
                  <span class="e-autor e-autor-persona e-extra e-anim">
                    <Icono nombre="user" tamano={12} class="e-ico" />
                    {chat.autorPersona}
                  </span>
                  <div class="e-burbuja e-persona e-extra e-anim">
                    <span>{seguimiento.texto}</span>
                    <span class="e-hora">{seguimiento.hora}</span>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>

      <div class="barra" aria-hidden="true">
        <span class="barra-pista"><span class="barra-relleno"></span></span>
        <span class="barra-nodos">
          {r.pasos.map((p) => <span class="barra-nodo"><Icono nombre={p.icono} tamano={14} /></span>)}
        </span>
      </div>
    </div>
  </div>

  <div class="contenedor pb-20 lg:pb-28">
    <Nota texto={r.nota} class="mt-10 lg:mt-12" />
  </div>
</section>

<style>
  /* ── Sección ─────────────────────────────────────────────────────────── */
  .recorrido {
    background: var(--color-surface-lowest);
    overflow: clip;
  }
  .recorrido::before {
    content: '';
    position: absolute;
    inset: 0 0 auto;
    height: 1px;
    background: linear-gradient(90deg, transparent, rgb(192 193 255 / 0.28) 30%, rgb(128 131 255 / 0.22) 70%, transparent);
  }
  .recorrido-fondo {
    background-image: radial-gradient(rgb(192 193 255 / 0.06) 1px, transparent 1px);
    background-size: 28px 28px;
    -webkit-mask-image: linear-gradient(180deg, transparent, #000 18%, #000 82%, transparent);
    mask-image: linear-gradient(180deg, transparent, #000 18%, #000 82%, transparent);
  }
  .luz {
    position: absolute;
    border-radius: 999px;
    filter: blur(80px);
  }
  .luz-a {
    width: min(44rem, 100vw);
    aspect-ratio: 1;
    right: -14rem;
    top: 18%;
    background: radial-gradient(circle, rgb(99 102 241 / 0.24), transparent 65%);
  }
  .luz-b {
    width: min(32rem, 80vw);
    aspect-ratio: 1;
    left: -12rem;
    bottom: 6%;
    background: radial-gradient(circle, rgb(192 193 255 / 0.1), transparent 65%);
  }

  /* ── Historia (por defecto: lista normal) ─────────────────────────────── */
  .historia {
    --alto-marco: 23rem;
    --tinta: var(--color-ink, #e5e1e4);
  }
  .fijo {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 1.25rem;
    padding-top: 3rem;
  }
  .rejilla {
    display: grid;
    gap: 2.5rem;
  }
  @media (min-width: 1024px) {
    .historia {
      --alto-marco: 27rem;
    }
    .historia.vrs-historia {
      --alto-marco: clamp(22rem, calc(100svh - var(--alto-encabezado) - 9rem), 32rem);
    }
    .fijo {
      padding-top: 4rem;
    }
    .rejilla {
      grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
      align-items: center;
      gap: 4rem;
    }
  }

  /* Pasos */
  .pasos {
    display: grid;
    gap: 0.75rem;
  }
  .paso {
    position: relative;
    display: grid;
    grid-template-columns: 2.75rem minmax(0, 1fr);
    gap: 1rem;
    padding: 1.25rem;
    border-radius: 1rem;
    background: var(--color-surface-low);
    box-shadow: inset 0 1px 0 rgb(229 225 228 / 0.05);
    overflow: hidden;
  }
  .paso-icono {
    display: flex;
    width: 2.75rem;
    height: 2.75rem;
    align-items: center;
    justify-content: center;
    border-radius: 0.875rem;
    background: rgb(128 131 255 / 0.12);
    color: var(--color-primary);
    transition:
      background-color 0.4s,
      color 0.4s,
      box-shadow 0.4s;
  }
  .paso-num {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--color-primary);
  }
  .paso-titulo {
    margin-top: 0.25rem;
    font-family: var(--font-display);
    font-size: 1.25rem;
    font-weight: 600;
    line-height: 1.3;
    letter-spacing: -0.01em;
    color: var(--color-ink);
  }
  .paso-texto {
    margin-top: 0.5rem;
    font-size: 1rem;
    line-height: 1.6;
    color: var(--color-ink-soft);
  }
  .paso-avance {
    position: absolute;
    inset: auto 1.25rem 0;
    height: 2px;
    border-radius: 2px;
    background: linear-gradient(90deg, #c0c1ff, #8083ff 60%, #6366f1);
    transform-origin: left;
    transform: scaleX(var(--paso-progreso, 0));
  }

  /* Escenario */
  .escenario {
    position: relative;
    display: flex;
    min-width: 0;
    flex-direction: column;
    align-items: center;
    padding-top: 0.875rem;
  }
  /* Rótulo del ejemplo: una pestaña sobre el borde superior de la pantalla. */
  .rotulo {
    position: absolute;
    top: 0;
    left: 1rem;
    right: 1rem;
    z-index: 3;
    width: fit-content;
    margin-inline: auto;
    text-align: center;
    background:
      linear-gradient(rgb(128 131 255 / 0.18), rgb(128 131 255 / 0.18)),
      var(--color-surface-lowest);
    box-shadow:
      inset 0 0 0 1px rgb(192 193 255 / 0.25),
      0 8px 24px -8px rgb(0 0 0 / 0.6);
  }
  .marco {
    position: relative;
    width: 100%;
    max-width: 38rem;
    perspective: 1600px;
  }
  .marco::before,
  .marco::after {
    content: '';
    position: absolute;
    inset: 6% 2%;
    z-index: -1;
    border-radius: 50%;
    filter: blur(56px);
    transition: opacity 0.9s;
  }
  .marco::before {
    background: radial-gradient(closest-side, rgb(99 102 241 / 0.42), transparent);
  }
  .marco::after {
    background: radial-gradient(closest-side, rgb(37 211 102 / 0.2), rgb(99 102 241 / 0.16) 55%, transparent);
    opacity: 0;
  }
  .escenas {
    display: grid;
    gap: 1.25rem;
  }
  .escena {
    position: relative;
    display: flex;
    height: var(--alto-marco);
    flex-direction: column;
    overflow: hidden;
    border-radius: 1.5rem;
    background:
      radial-gradient(120% 70% at 100% 0%, rgb(128 131 255 / 0.12), transparent 60%),
      linear-gradient(180deg, #1c1b1e 0%, #131315 100%);
    box-shadow:
      inset 0 0 0 1px rgb(192 193 255 / 0.12),
      inset 0 1px 0 rgb(255 255 255 / 0.06),
      0 40px 80px -30px rgb(0 0 0 / 0.85);
    container-type: size;
  }
  /* Todo lo de adentro se mide en em: la pantalla escala con su alto y su ancho. */
  .e-lienzo {
    display: flex;
    min-height: 0;
    flex: 1;
    flex-direction: column;
    gap: 0.75em;
    padding: 1.25em;
    font-size: clamp(0.6875rem, min(3.7cqh, 3.9cqw), 0.9375rem);
    line-height: 1.45;
    color: var(--color-ink-soft);
  }
  .escena :global(.e-ico) {
    width: 1.15em;
    height: 1.15em;
  }
  .e-l {
    display: block;
    height: 0.55em;
    border-radius: 999px;
    background: rgb(229 225 228 / 0.1);
  }
  .e-l-alta {
    height: 0.8em;
    background: rgb(192 193 255 / 0.18);
  }
  .e-logo {
    display: inline-flex;
    width: 2.2em;
    height: 2.2em;
    flex: none;
    align-items: center;
    justify-content: center;
    border-radius: 0.6em;
    background: linear-gradient(135deg, #c0c1ff, #6366f1);
    color: var(--color-on-primary);
    font-family: var(--font-display);
    font-size: 0.85em;
    font-weight: 700;
  }
  .e-logo-redondo {
    border-radius: 999px;
    width: 2.6em;
    height: 2.6em;
  }

  /* 1. Búsqueda */
  .e-buscador {
    display: flex;
    min-height: 3em;
    align-items: center;
    gap: 0.65em;
    padding: 0 1.1em;
    border-radius: 999px;
    background: #0e0e10;
    box-shadow: inset 0 0 0 1px rgb(192 193 255 / 0.18);
    color: var(--tinta);
  }
  .e-buscador :global(.e-ico) {
    color: var(--color-primary);
  }
  .e-consulta {
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
  }
  .e-cursor {
    width: 1.5px;
    height: 1.1em;
    flex: none;
    margin-left: -0.4em;
    background: var(--color-primary);
  }
  .e-rotulo {
    font-family: var(--font-mono);
    font-size: 0.78em;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-ink-mute);
  }
  .e-resultado {
    display: grid;
    gap: 0.5em;
    padding: 0.9em 1em;
    border-radius: 1em;
  }
  .e-tenue {
    background: rgb(229 225 228 / 0.03);
  }
  .e-destacado {
    position: relative;
    gap: 0.35em;
    background: rgb(42 42 44 / 0.9);
    box-shadow:
      inset 0 0 0 1px rgb(192 193 255 / 0.32),
      0 0 0 0.35em rgb(128 131 255 / 0.1),
      0 1.5em 3em -1.2em rgb(99 102 241 / 0.55);
  }
  .e-sitio {
    display: flex;
    align-items: center;
    gap: 0.6em;
  }
  .e-sitio-texto,
  .e-chat-nombre {
    display: flex;
    min-width: 0;
    flex-direction: column;
    line-height: 1.25;
  }
  .e-sitio-nombre {
    font-weight: 600;
    color: var(--tinta);
  }
  .e-sitio-ciudad {
    font-size: 0.85em;
    color: var(--color-ink-mute);
  }
  .e-enlace {
    margin-top: 0.3em;
    font-family: var(--font-display);
    font-size: 1.2em;
    font-weight: 600;
    line-height: 1.25;
    color: var(--color-primary);
  }
  .e-desc {
    line-height: 1.45;
  }
  .e-faq {
    display: grid;
    gap: 0.3em;
    margin-top: 0.35em;
  }
  .e-faq p {
    display: flex;
    align-items: center;
    gap: 0.5em;
    padding: 0.45em 0.7em;
    border-radius: 0.6em;
    background: rgb(14 14 16 / 0.6);
    color: var(--tinta);
  }
  .e-faq :global(.e-ico) {
    color: var(--color-primary);
  }
  .e-sello {
    position: absolute;
    top: -0.9em;
    right: 0.9em;
    display: inline-flex;
    align-items: center;
    gap: 0.4em;
    padding: 0.3em 0.75em;
    border-radius: 999px;
    background: linear-gradient(135deg, #c0c1ff, #8083ff);
    color: var(--color-on-primary);
    font-size: 0.82em;
    font-weight: 600;
    box-shadow: 0 0.6em 1.6em -0.4em rgb(128 131 255 / 0.7);
  }

  /* 2. Página web */
  .e-cromo {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.7rem 1rem;
    background: rgb(53 52 55 / 0.55);
    box-shadow: inset 0 -1px 0 rgb(229 225 228 / 0.06);
  }
  .e-puntos {
    display: flex;
    gap: 0.35rem;
  }
  .e-puntos i {
    width: 0.55rem;
    height: 0.55rem;
    border-radius: 999px;
    background: rgb(229 225 228 / 0.18);
  }
  .e-url {
    display: flex;
    flex: 1;
    align-items: center;
    gap: 0.5rem;
    max-width: 18rem;
    margin-inline: auto;
    padding: 0.35rem 0.75rem;
    border-radius: 999px;
    background: rgb(14 14 16 / 0.7);
    color: var(--color-online);
    font-size: 0.75rem;
  }
  .e-url .e-l {
    height: 0.4rem;
  }
  .e-nav {
    display: flex;
    align-items: center;
    gap: 0.6em;
  }
  .e-marca {
    font-family: var(--font-display);
    font-weight: 600;
    color: var(--tinta);
    white-space: nowrap;
  }
  .e-nav-enlaces {
    display: flex;
    flex: 1;
    justify-content: flex-end;
    gap: 0.6em;
  }
  .e-nav-enlaces .e-l {
    width: 2.6em;
  }
  .e-portada {
    display: grid;
    gap: 1em;
    margin-top: 0.4em;
  }
  .e-portada-texto {
    display: grid;
    min-width: 0;
    gap: 0.9em;
  }
  .e-foto,
  .e-servicios {
    display: none;
  }
  @container (min-width: 30rem) {
    .e-portada {
      grid-template-columns: minmax(0, 1.55fr) minmax(0, 1fr);
    }
    .e-foto {
      display: flex;
      min-height: 9em;
