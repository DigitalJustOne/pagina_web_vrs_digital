---
/**
 * Visual de la portada de /paginas-web-contadores/: el año tributario de una firma contable.
 * Un panel de vidrio en 3D con los doce meses y las temporadas de 2026 según la DIAN (las mismas
 * filas de la tabla «Temporadas tributarias»): una barra por obligación y un anillo en el mes en
 * que conviene preparar la web. Delante, una consulta típica por WhatsApp y su respuesta con las
 * fechas de la DIAN.
 *
 * Al cargar, las barras se trazan fila por fila y llegan los mensajes; después una línea de luz
 * recorre el año. Se inclina con el puntero y se endereza al bajar. Sin JS o con movimiento
 * reducido: quieto y completo. Una sola imagen para lectores de pantalla (los datos completos
 * están en la tabla de la página).
 * Textos y meses: visualContadores en src/data/contenido/paginas-web-contadores.ts.
 *
 * <CalendarioTributario slot="visual" />
 */
import Icono from '@/components/ui/Icono.astro';
import { visualContadores as V } from '@/data/contenido/paginas-web-contadores';

interface Props {
  class?: string;
}
const { class: clase } = Astro.props;

/** Inicial de cada mes en español: E F M A M J J A S O N D. */
const formato = new Intl.DateTimeFormat('es-CO', { month: 'narrow', timeZone: 'UTC' });
const meses = Array.from({ length: 12 }, (_, m) => formato.format(new Date(Date.UTC(2026, m, 15))).toUpperCase());
const pct = (n: number) => `${((n / 12) * 100).toFixed(4)}%`;
---
<div role="img" aria-label={V.etiqueta} data-calendario class:list={['calendario relative mx-auto w-full max-w-[34rem]', clase]}>
  <div aria-hidden="true" class="escena">
    <span class="halo"></span>
    <div class="enderezar">
      <div class="panel">
        <div class="cabeza">
          <span class="cabeza-titulo"><Icono nombre="calendar" tamano={14} />{V.titulo}</span>
          <span class="cabeza-fuente">{V.fuente}</span>
        </div>

        <div class="tablero">
          <div class="meses">
            {meses.map((m) => <span>{m}</span>)}
          </div>
          <div class="filas">
            {
              V.filas.map((f, i) => (
                <div class:list={['fila', 'destacada' in f && f.destacada && 'destacada', 'tenue' in f && f.tenue && 'tenue']} style={`--f:${i}`}>
                  <span class="fila-nombre">{f.nombre}</span>
                  <span class="pista">
                    {f.meses.map(([desde, hasta]) => (
                      <span class="tramo" style={`left:${pct(desde)};width:${pct(hasta - desde + 1)}`} />
                    ))}
                    {f.preparar !== null && <span class="preparar" style={`left:${pct(f.preparar + 0.5)}`} />}
                  </span>
                </div>
              ))
            }
            <span class="barrido"><span></span></span>
          </div>
        </div>

        <div class="leyenda">
          <span><i class="muestra-fecha"></i>{V.leyendaFechas}</span>
          <span><i class="muestra-preparar"></i>{V.leyendaPreparar}</span>
        </div>
      </div>

      <div class="chat">
        <span class="burbuja cliente">{V.pregunta}</span>
        <span class="burbuja respuesta">
          <span class="respuesta-icono"><Icono nombre="calendar" tamano={14} /></span>
          <span class="grid gap-1">
            <span>{V.respuesta}</span>
            <span class="respuesta-fuente">{V.fuenteRespuesta}</span>
          </span>
        </span>
      </div>
    </div>
  </div>
</div>

<script>
  import { inclinar } from './inclinar';
  inclinar('[data-calendario]', { x: 12, y: 8 });
</script>

<style>
  .calendario {
    --rx: 0deg;
    --ry: 0deg;
  }
  .escena {
    position: relative;
    perspective: 1500px;
    perspective-origin: 50% 35%;
  }
  .halo {
    position: absolute;
    inset: 8% 4% 18%;
    border-radius: 999px;
    background: radial-gradient(closest-side, rgb(99 102 241 / 0.32), transparent 75%);
    filter: blur(30px);
  }
  .enderezar {
    position: relative;
    transform-style: preserve-3d;
  }
  .panel {
    position: relative;
    padding: 1rem 1rem 0.875rem;
    border-radius: 1.25rem;
    background:
      linear-gradient(160deg, rgb(255 255 255 / 0.06), rgb(255 255 255 / 0.01) 55%),
      rgb(28 27 30 / 0.82);
    -webkit-backdrop-filter: blur(18px) saturate(140%);
    backdrop-filter: blur(18px) saturate(140%);
    box-shadow:
      0 40px 80px -36px rgb(0 0 0 / 0.85),
      inset 0 1px 0 rgb(255 255 255 / 0.08),
      inset 0 0 0 1px rgb(229 225 228 / 0.08);
    transform: rotateX(calc(6deg + var(--rx))) rotateY(calc(-8deg + var(--ry)));
    transition: transform 0.6s var(--ease-out-expo);
  }
  .cabeza {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.375rem 1rem;
    padding-bottom: 0.75rem;
    box-shadow: inset 0 -1px 0 rgb(229 225 228 / 0.07);
  }
  .cabeza-titulo {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-mono, ui-monospace, monospace);
    font-size: 0.6875rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--color-primary, #c0c1ff);
  }
  .cabeza-fuente {
    font-size: 0.6875rem;
    color: var(--color-ink-mute, #a19da0);
  }
  .tablero {
    padding-top: 0.75rem;
  }
  .meses {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    margin-bottom: 0.25rem;
    font-family: var(--font-mono, ui-monospace, monospace);
    font-size: 0.625rem;
    text-align: center;
    color: var(--color-ink-mute, #a19da0);
  }
  .filas {
    position: relative;
    display: grid;
    gap: 0.5rem;
    /* Retícula de meses detrás de las barras. */
    background-image: linear-gradient(90deg, rgb(229 225 228 / 0.06) 1px, transparent 1px);
    background-size: calc(100% / 12) 100%;
  }
  .fila {
    display: grid;
    gap: 0.25rem;
  }
  .fila-nombre {
    font-size: 0.6875rem;
    line-height: 1.2;
    color: var(--color-ink-soft, #c9c5c8);
  }
  .pista {
    position: relative;
    height: 0.75rem;
    border-radius: 999px;
    background: rgb(229 225 228 / 0.05);
  }
  .tramo {
    position: absolute;
    top: 0;
    bottom: 0;
    border-radius: 999px;
    background: linear-gradient(90deg, #8083ff, #c0c1ff);
    opacity: 0.75;
    transform-origin: left center;
  }
  .tenue .tramo {
    background: repeating-linear-gradient(90deg, rgb(192 193 255 / 0.5) 0 6px, transparent 6px 10px);
    opacity: 0.6;
  }
  .destacada .fila-nombre {
    color: var(--color-ink, #e5e1e4);
    font-weight: 600;
  }
  .destacada .tramo {
    opacity: 1;
    background: linear-gradient(90deg, #c0c1ff, #e5e1e4);
    box-shadow: 0 0 18px 2px rgb(128 131 255 / 0.55);
  }
  .preparar {
    position: absolute;
    top: 50%;
    width: 0.875rem;
    height: 0.875rem;
    translate: -50% -50%;
    border-radius: 999px;
    background: var(--color-surface-low, #1c1b1e);
    box-shadow: 0 0 0 2px var(--color-online, #4ade80);
  }
  .barrido {
    position: absolute;
    inset: -0.25rem 0;
    overflow: hidden;
    pointer-events: none;
    opacity: 0;
  }
  /* La línea es el borde izquierdo de una capa del ancho del año que se desplaza (transform). */
  .barrido span {
    position: absolute;
    inset: 0;
  }
  .barrido span::before {
    content: '';
    position: absolute;
    top: 0;
    bottom: 0;
    left: -1px;
    width: 2px;
    border-radius: 2px;
    background: linear-gradient(180deg, transparent, rgb(192 193 255 / 0.9), transparent);
    box-shadow: 0 0 14px 2px rgb(128 131 255 / 0.6);
  }
  .leyenda {
    display: flex;
    flex-wrap: wrap;
    gap: 0.375rem 1rem;
    margin-top: 0.875rem;
    font-size: 0.6875rem;
    color: var(--color-ink-mute, #a19da0);
  }
  .leyenda span {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
  }
  .leyenda i {
    display: inline-block;
  }
  .muestra-fecha {
    width: 1rem;
    height: 0.4rem;
    border-radius: 999px;
    background: linear-gradient(90deg, #8083ff, #c0c1ff);
  }
  .muestra-preparar {
    width: 0.625rem;
    height: 0.625rem;
    border-radius: 999px;
    box-shadow: 0 0 0 2px var(--color-online, #4ade80);
  }

  /* ── Conversación ────────────────────────────────────────────────────── */
  .chat {
    position: relative;
    display: grid;
    gap: 0.5rem;
    justify-items: start;
    margin-top: -1.25rem;
    padding-inline: 0.5rem;
    transform: translateZ(60px);
  }
  .burbuja {
    max-width: 88%;
    padding: 0.625rem 0.875rem;
    border-radius: 1rem;
    font-size: 0.8125rem;
    line-height: 1.4;
    box-shadow: 0 18px 40px -16px rgb(0 0 0 / 0.75);
  }
  .cliente {
    justify-self: end;
    border-bottom-right-radius: 0.375rem;
    background: #1f5c43;
    color: #effff6;
  }
  .respuesta {
    display: flex;
    gap: 0.625rem;
    border-bottom-left-radius: 0.375rem;
    background: rgb(53 52 55 / 0.92);
    -webkit-backdrop-filter: blur(12px);
    backdrop-filter: blur(12px);
    color: var(--color-ink, #e5e1e4);
    box-shadow:
      0 18px 40px -16px rgb(0 0 0 / 0.75),
      inset 0 0 0 1px rgb(192 193 255 / 0.22);
  }
  .respuesta-icono {
    display: grid;
    flex: none;
    place-items: center;
    width: 1.75rem;
    height: 1.75rem;
    border-radius: 0.625rem;
    background: rgb(128 131 255 / 0.2);
    color: var(--color-primary, #c0c1ff);
  }
  .respuesta-fuente {
    font-family: var(--font-mono, ui-monospace, monospace);
    font-size: 0.625rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-primary, #c0c1ff);
  }

  @media (min-width: 640px) {
    .panel {
      padding: 1.25rem 1.375rem 1.125rem;
    }
    .fila-nombre {
      font-size: 0.75rem;
    }
    .filas {
      gap: 0.625rem;
    }
  }
  @media (min-width: 1024px) {
    .panel {
      transform: rotateX(calc(9deg + var(--rx))) rotateY(calc(-15deg + var(--ry))) rotateZ(0.5deg);
    }
    .chat {
      margin-top: -2rem;
      padding-inline: 1rem 0;
      transform: translateZ(90px) translateX(4%);
    }
  }

  /* ── Movimiento ──────────────────────────────────────────────────────── */
  @media (prefers-reduced-motion: no-preference) {
    .tramo {
      animation: cal-trazar 0.9s var(--ease-out-expo) both;
      animation-delay: calc(0.35s + var(--f) * 0.12s);
    }
    .preparar {
      animation: cal-anillo 0.6s var(--ease-out-expo) both;
      animation-delay: calc(0.75s + var(--f) * 0.12s);
    }
    /* El latido de la fila destacada anima la opacidad de un brillo extra (va por el
       compositor; animar box-shadow recalculaba estilos en cada cuadro). */
    .destacada .tramo::after {
      content: '';
      position: absolute;
      inset: 0;
      border-radius: inherit;
      box-shadow: 0 0 26px 5px rgb(128 131 255 / 0.8);
      opacity: 0;
      animation: cal-latir 3.2s ease-in-out 2s infinite;
    }
    .barrido {
      animation: cal-barrido-ver 0.6s ease 1.6s both;
    }
    .barrido span {
      animation: cal-barrer 9s linear 1.6s infinite;
    }
    .burbuja {
      animation: cal-mensaje 0.8s var(--ease-out-expo) both;
    }
    .cliente {
      animation-delay: 1s;
    }
    .respuesta {
      animation-delay: 1.5s;
    }
    .chat {
      animation: cal-flotar 7s ease-in-out 2.4s infinite;
    }
    @supports (animation-timeline: view()) {
      .enderezar {
        animation-name: cal-enderezar;
        animation-duration: auto;
        animation-timing-function: linear;
        animation-fill-mode: both;
        animation-timeline: view();
        animation-range: exit 0% exit 100%;
      }
    }
  }
  @keyframes cal-trazar {
    from {
      opacity: 0;
      transform: scaleX(0);
    }
  }
  @keyframes cal-anillo {
    from {
      opacity: 0;
      scale: 0.3;
    }
  }
  @keyframes cal-latir {
    50% {
      opacity: 1;
    }
  }
  @keyframes cal-barrido-ver {
    to {
      opacity: 1;
    }
  }
  @keyframes cal-barrer {
    from {
      transform: translateX(0);
    }
    to {
      transform: translateX(100%);
    }
  }
  @keyframes cal-mensaje {
    from {
      opacity: 0;
      translate: 0 12px;
      scale: 0.96;
    }
  }
  @keyframes cal-flotar {
    0%,
    100% {
      translate: 0 0;
    }
    50% {
      translate: 0 -6px;
    }
  }
  @keyframes cal-enderezar {
    to {
      transform: rotateX(-6deg) rotateY(10deg) translateY(-5%);
    }
  }
</style>
