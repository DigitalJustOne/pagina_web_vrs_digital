---
/**
 * Sección #comparar de /precios/: qué incluye cada plan, punto por punto.
 * Una tabla real (<table>) con una columna por plan y una fila por punto, agrupada según el
 * primer plan que lo incluye (los planes son acumulativos: cada uno suma lo del anterior).
 *
 * - Celular: tres columnas angostas con marcas (✓ / —) y el encabezado de planes fijo bajo el
 *   encabezado del sitio mientras se recorre la tabla. Nada desborda a 360 px.
 * - Computador: el encabezado muestra además el precio «desde» y la mensualidad de cada plan.
 * - La columna del plan destacado (oferta principal) lleva una luz suave.
 * - Al pie, un botón por plan a /contacto/?plan=<id> (el formulario lo preselecciona).
 * Filas y textos: sección «comparar» y textosPrecios.comparador de src/data/contenido/precios.ts.
 * Precios: PLANES de sitio.ts. NOTA_PRECIOS va en el pie de la sección.
 *
 * <ComparadorPlanes seccion={s} fondo="bajo" numero={2} resaltado="punto por punto" />
 */
import Icono from '@/components/ui/Icono.astro';
import { textosPrecios } from '@/data/contenido/precios';
import type { FondoSeccion, SeccionTabla } from '@/data/contenido/tipos';
import { CTA_PRINCIPAL, PLANES, cuotaMensual, formatoCOP } from '@/data/sitio';
import { idTitulo } from '@/lib/paginas';
import MarcoSector from './MarcoSector.astro';

interface Props {
  seccion: SeccionTabla;
  fondo?: FondoSeccion;
  numero?: number;
  resaltado?: string;
}

const { seccion: s, fondo = 'bajo', numero, resaltado } = Astro.props;
const T = textosPrecios.comparador;

/** Nombre corto para la columna en celular: «Web Esencial» → «Esencial». */
const corto = (nombre: string) => nombre.replace(/^Web\s*\+?\s*/i, '').split(/\s+/)[0] ?? nombre;

// Grupos de filas según el primer plan que incluye el punto.
const grupos = PLANES.map((_, i) => ({
  titulo: T.grupos[i],
  filas: s.filas.filter((f) => f.slice(1).findIndex((c) => c === T.incluido) === i),
})).filter((g) => g.filas.length > 0);

const sobreBajo = fondo === 'bajo';
---
<MarcoSector seccion={s} fondo={fondo} numero={numero} resaltado={resaltado} pie={{ nota: s.nota, notaPrecios: true }}>
  <div data-revelar class:list={['comparador', sobreBajo && 'sobre-bajo']}>
    <table aria-labelledby={idTitulo(s.id)}>
      <colgroup>
        <col />
        {PLANES.map(() => <col class="col-plan" />)}
      </colgroup>
      <thead>
        <tr>
          <th scope="col" class="cabeza-punto">
            <span class="cabeza-punto-texto">{s.columnas[0]}</span>
          </th>
          {
            PLANES.map((p, i) => (
              <th scope="col" class:list={['cabeza-plan', p.destacado && 'destacado']}>
                <span aria-hidden="true" class="num">{String(i + 1).padStart(2, '0')}</span>
                <span aria-hidden="true" class="corto">{corto(p.nombre)}</span>
                <span class="nombre">{p.nombre}</span>
                <span class="precio">
                  <span class="precio-rotulo">{T.precioAnual}</span>
                  <span class="precio-valor">{formatoCOP(p.precioAnualDesde)}</span>
                  <span class="precio-mes">
                    {T.cuotas} {formatoCOP(cuotaMensual(p.precioAnualDesde))} {T.alMes}
                  </span>
                  <span class="precio-rotulo">{T.iva}</span>
                </span>
              </th>
            ))
          }
        </tr>
      </thead>
      {
        grupos.map((g) => (
          <tbody>
            <tr class="grupo">
              <th scope="colgroup" colspan={PLANES.length + 1}>
                <span>{g.titulo}</span>
              </th>
            </tr>
            {g.filas.map((f) => (
              <tr class="fila">
                <th scope="row">{f[0]}</th>
                {f.slice(1).map((celda, j) => (
                  <td class:list={[PLANES[j]?.destacado && 'destacado']}>
                    {celda === T.incluido ? (
                      <span class="marca si">
                        <Icono nombre="tick" tamano={16} trazo={2.25} />
                        <span class="sr-only">{celda}</span>
                      </span>
                    ) : (
                      <span class="marca no">
                        <span aria-hidden="true" class="raya" />
                        <span class="sr-only">{celda}</span>
                      </span>
                    )}
                  </td>
                ))}
              </tr>
            ))}
          </tbody>
        ))
      }
      <tfoot>
        <tr>
          <td class="pie-vacio"></td>
          {
            PLANES.map((p) => (
              <td class:list={['pie-plan', p.destacado && 'destacado']}>
                <a href={`${CTA_PRINCIPAL.href}?plan=${p.id}`} class:list={['elegir', p.destacado && 'principal']}>
                  <span class="elegir-movil">{T.elegir}</span>
                  <span class="elegir-pc">{T.solicitar}</span>
                  <span class="sr-only">: {p.nombre}</span>
                  <Icono nombre="arrow-right" tamano={16} class="elegir-flecha" />
                </a>
              </td>
            ))
          }
        </tr>
      </tfoot>
    </table>
  </div>
</MarcoSector>

<style>
  .comparador {
    --capa: var(--color-surface-low, #1c1b1e);
    --capa-fija: rgb(28 27 30 / 0.94);
    --col: 3.5rem;
    border-radius: var(--radius-panel, 1.5rem);
    background: var(--capa);
    box-shadow: inset 0 0 0 1px rgb(70 69 84 / 0.35);
    /* Sin overflow: el encabezado fijo (sticky) necesita que ningún ancestro recorte en Y. */
  }
  .comparador.sobre-bajo {
    --capa: var(--color-surface-high, #2a2a2c);
    --capa-fija: rgb(42 42 44 / 0.94);
  }
  table {
    width: 100%;
    table-layout: fixed;
    border-collapse: separate;
    border-spacing: 0;
    font-size: 0.875rem;
    line-height: 1.45;
  }
  .col-plan {
    width: var(--col);
  }

  /* ── Encabezado fijo ─────────────────────────────────────────────────── */
  thead th {
    position: sticky;
    top: var(--alto-encabezado);
    z-index: 2;
    padding: 0.875rem 0.25rem 0.75rem;
    background: var(--capa-fija);
    -webkit-backdrop-filter: blur(14px);
    backdrop-filter: blur(14px);
    box-shadow: inset 0 -1px 0 rgb(192 193 255 / 0.16);
    vertical-align: bottom;
    text-align: center;
    font-weight: 500;
  }
  thead th:first-child {
    border-top-left-radius: var(--radius-panel, 1.5rem);
    text-align: left;
    padding-left: 1rem;
  }
  thead th:last-child {
    border-top-right-radius: var(--radius-panel, 1.5rem);
  }
  .cabeza-punto-texto {
    font-family: var(--font-mono, ui-monospace, monospace);
    font-size: 0.6875rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--color-ink-mute, #a19da0);
  }
  .cabeza-plan {
    color: var(--color-ink, #e5e1e4);
  }
  .num {
    display: block;
    font-family: var(--font-mono, ui-monospace, monospace);
    font-size: 0.6875rem;
    letter-spacing: 0.14em;
    color: var(--color-primary, #c0c1ff);
  }
  .corto {
    display: block;
    margin-top: 0.25rem;
    font-family: var(--font-display);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: -0.01em;
  }
  /* En celular el nombre completo y el precio quedan solo para lectores de pantalla. */
  .nombre,
  .precio {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
  }
  .cabeza-plan.destacado .num,
  .cabeza-plan.destacado .corto {
    color: var(--color-primary, #c0c1ff);
  }

  /* ── Grupos y filas ──────────────────────────────────────────────────── */
  .grupo th {
    padding: 1.5rem 1rem 0.625rem;
    text-align: left;
    font-family: var(--font-mono, ui-monospace, monospace);
    font-size: 0.6875rem;
    font-weight: 500;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--color-primary, #c0c1ff);
  }
  .grupo th span {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }
  .grupo th span::after {
    content: '';
    flex: 1;
    height: 1px;
    background: linear-gradient(90deg, rgb(192 193 255 / 0.3), transparent);
  }
  .fila th,
  .fila td {
    padding: 0.625rem 0.25rem;
    box-shadow: inset 0 1px 0 rgb(229 225 228 / 0.06);
    vertical-align: middle;
  }
  .fila th {
    padding-left: 1rem;
    padding-right: 0.5rem;
    text-align: left;
    font-weight: 400;
    color: var(--color-ink, #e5e1e4);
  }
  .fila td {
    text-align: center;
  }
  td.destacado,
  .pie-plan.destacado {
    background: rgb(128 131 255 / 0.07);
  }
  @media (hover: hover) {
    .fila:hover th,
    .fila:hover td {
      background-color: rgb(128 131 255 / 0.06);
    }
  }
  .marca {
    display: inline-grid;
    place-items: center;
    width: 1.75rem;
    height: 1.75rem;
    border-radius: 999px;
    vertical-align: middle;
  }
  .marca.si {
    background: linear-gradient(135deg, #c0c1ff 0%, #8083ff 100%);
    color: var(--color-on-primary, #0b0080);
    box-shadow: 0 6px 18px -8px rgb(128 131 255 / 0.8);
  }
  .marca.no .raya {
    display: block;
    width: 0.75rem;
    height: 2px;
    border-radius: 2px;
    background: rgb(229 225 228 / 0.28);
  }

  /* ── Pie: un botón por plan ──────────────────────────────────────────── */
  tfoot td {
    padding: 1rem 0.25rem 1.25rem;
    box-shadow: inset 0 1px 0 rgb(229 225 228 / 0.08);
    text-align: center;
  }
  tfoot td:first-child {
    border-bottom-left-radius: var(--radius-panel, 1.5rem);
  }
  tfoot td:last-child {
    border-bottom-right-radius: var(--radius-panel, 1.5rem);
  }
  .elegir {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.375rem;
    min-width: 44px;
    min-height: 44px;
    width: 100%;
    padding: 0.5rem 0.25rem;
    border-radius: 0.75rem;
    background: rgb(255 255 255 / 0.06);
    box-shadow: inset 0 0 0 1px rgb(229 225 228 / 0.14);
    color: var(--color-ink, #e5e1e4);
    font-size: 0.75rem;
    font-weight: 600;
    line-height: 1.2;
    transition: background-color 0.2s, box-shadow 0.3s, transform 0.2s var(--ease-out-expo);
  }
  .elegir:hover {
    background: rgb(255 255 255 / 0.1);
  }
  .elegir.principal {
    background: linear-gradient(135deg, #c0c1ff 0%, #8083ff 100%);
    color: var(--color-on-primary, #0b0080);
    box-shadow: none;
  }
  .elegir.principal:hover {
    box-shadow: 0 10px 30px -10px rgb(128 131 255 / 0.7);
    transform: translateY(-1px);
  }
  .elegir-pc,
  :global(.elegir-flecha) {
    display: none;
  }

  /* ── Tableta y computador ────────────────────────────────────────────── */
  @media (min-width: 768px) {
    .comparador {
      --col: 9.5rem;
    }
    table {
      font-size: 0.9375rem;
    }
    thead th {
      padding: 1.25rem 0.875rem 1.125rem;
      text-align: left;
    }
    thead th:first-child {
      padding-left: 1.5rem;
    }
    .corto {
      display: none;
    }
    .nombre,
    .precio {
      position: static;
      width: auto;
      height: auto;
      overflow: visible;
      clip: auto;
      white-space: normal;
    }
    .nombre {
      display: block;
      margin-top: 0.375rem;
      font-family: var(--font-display);
      font-size: 1.0625rem;
      font-weight: 600;
      line-height: 1.2;
      letter-spacing: -0.01em;
    }
    .precio {
      display: grid;
      margin-top: 0.625rem;
      gap: 0.125rem;
    }
    .precio-rotulo {
      font-size: 0.75rem;
      color: var(--color-ink-soft, #c9c5c8);
    }
    .precio-valor {
      font-family: var(--font-display);
      font-size: 1.25rem;
      font-weight: 600;
      letter-spacing: -0.02em;
      color: var(--color-ink, #e5e1e4);
    }
    .precio-mes {
      font-size: 0.75rem;
      color: var(--color-primary, #c0c1ff);
    }
    .grupo th {
      padding: 1.75rem 1.5rem 0.75rem;
    }
    .fila th {
      padding: 0.875rem 1rem 0.875rem 1.5rem;
    }
    .fila td {
      padding: 0.875rem;
      text-align: left;
    }
    tfoot td {
      padding: 1.25rem 0.875rem 1.5rem;
    }
    .elegir {
      font-size: 0.875rem;
      padding: 0.625rem 0.75rem;
    }
    .elegir-movil {
      display: none;
    }
    .elegir-pc,
    :global(.elegir-flecha) {
      display: inline;
    }
  }
  @media (min-width: 1024px) {
    .comparador {
      --col: 12.5rem;
    }
    .precio-valor {
      font-size: 1.5rem;
    }
  }

  /* Las marcas aparecen al entrar cada fila en pantalla (ligado al desplazamiento, sin JS). */
  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) {
      .marca.si {
        animation: comparador-marca linear both;
        animation-timeline: view();
        animation-range: entry 0% entry 80%;
      }
    }
  }
  @keyframes comparador-marca {
    from {
      opacity: 0;
      transform: scale(0.4);
    }
  }
</style>
