---
/**
 * Sección «estructura recomendada» de las páginas de sector (contadores y consultores): la lista
 * de páginas del módulo dibujada como el mapa de un sitio web. El primer ítem (Inicio) es la raíz
 * y los demás cuelgan de ella con líneas de árbol. Cada página tiene un solo tema: así se ve.
 *
 * Títulos H3 (la sección tiene su H2). Las ramas se dibujan al entrar en pantalla (data-revelar);
 * sin JS o con movimiento reducido, el árbol está completo desde el inicio.
 * Disposición dividida: encabezado fijo a la izquierda y el árbol a la derecha (computador).
 *
 * <MapaSitio seccion={s} fondo="bajo" numero={5} resaltado="firmas contables" />
 */
import Icono from '@/components/ui/Icono.astro';
import type { FondoSeccion, SeccionLista } from '@/data/contenido/tipos';
import { muestraPrecio } from '@/lib/paginas';
import MarcoSector from './MarcoSector.astro';

interface Props {
  seccion: SeccionLista;
  fondo?: FondoSeccion;
  numero?: number;
  resaltado?: string;
}

const { seccion: s, fondo = 'base', numero, resaltado } = Astro.props;
const bloques = s.items.map((it) => (typeof it === 'string' ? { titulo: '', texto: it } : it));
const [raiz, ...hijos] = bloques;
const capa = fondo === 'bajo' ? 'bg-surface-high' : 'bg-surface-low';
const num = (i: number) => String(i + 1).padStart(2, '0');
const pie = { parrafos: s.parrafos, nota: s.nota, notaPrecios: muestraPrecio(s), enlace: s.enlace };
---
<MarcoSector seccion={s} fondo={fondo} numero={numero} resaltado={resaltado} disposicion="dividido" pie={pie}>
  <div class="mapa">
    {
      raiz && (
        <div data-revelar class="raiz vidrio borde-luz rounded-panel p-5 sm:p-6">
          <span aria-hidden="true" class="raiz-icono">
            <Icono nombre="home" tamano={20} />
          </span>
          <div class="min-w-0">
            <p class="raiz-num" aria-hidden="true">{num(0)}</p>
            {raiz.titulo && <h3 class="titulo-tarjeta">{raiz.titulo}</h3>}
            <p class:list={['leading-relaxed text-ink-soft', raiz.titulo && 'mt-1.5']}>{raiz.texto}</p>
          </div>
        </div>
      )
    }
    <ol role="list" class="ramas">
      {
        hijos.map((h, i) => (
          <li data-revelar class="rama" style={`--retraso:${Math.min(i, 6) * 70}ms`}>
            <div class:list={['nodo rounded-card p-4 sm:p-5', capa]}>
              <span aria-hidden="true" class="nodo-num">
                {num(i + 1)}
              </span>
              <div class="min-w-0">
                {h.titulo && <h3 class="font-display text-lg leading-snug font-semibold text-ink">{h.titulo}</h3>}
                <p class:list={['leading-relaxed text-ink-soft', h.titulo && 'mt-1']}>{h.texto}</p>
              </div>
            </div>
          </li>
        ))
      }
    </ol>
  </div>
</MarcoSector>

<style>
  .mapa {
    --tronco: 1.375rem;
    --sangria: 2.75rem;
    --codo: 1.65rem;
    --linea: rgb(192 193 255 / 0.32);
  }
  .raiz {
    position: relative;
    display: flex;
    gap: 1rem;
    box-shadow: 0 30px 60px -30px rgb(99 102 241 / 0.45);
  }
  /* Tallo de la raíz hacia las ramas. */
  .raiz::after {
    content: '';
    position: absolute;
    left: var(--tronco);
    top: 100%;
    width: 2px;
    height: 0.875rem;
    background: var(--linea);
  }
  .raiz-icono {
    display: grid;
    flex: none;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    border-radius: 0.875rem;
    background: linear-gradient(135deg, #c0c1ff 0%, #8083ff 100%);
    color: var(--color-on-primary, #0b0080);
    box-shadow: 0 10px 30px -8px rgb(128 131 255 / 0.7);
  }
  .raiz-num {
    margin-bottom: 0.25rem;
    font-family: var(--font-mono, ui-monospace, monospace);
    font-size: 0.6875rem;
    letter-spacing: 0.16em;
    color: var(--color-primary, #c0c1ff);
  }
  .ramas {
    display: grid;
    gap: 0.75rem;
    margin-top: 0.875rem;
    padding-left: var(--sangria);
  }
  .rama {
    position: relative;
  }
  /* Tronco vertical (cada rama dibuja su tramo) y codo horizontal hasta la tarjeta. */
  .rama::before,
  .rama::after {
    content: '';
    position: absolute;
    background: var(--linea);
  }
  .rama::before {
    left: calc(var(--tronco) - var(--sangria));
    top: -0.875rem;
    bottom: -0.75rem;
    width: 2px;
    transform-origin: top;
  }
  .rama:first-child::before {
    top: -0.875rem;
  }
  .rama:last-child::before {
    bottom: auto;
    height: calc(var(--codo) + 0.875rem + 1px);
  }
  .rama::after {
    left: calc(var(--tronco) - var(--sangria));
    top: var(--codo);
    width: calc(var(--sangria) - var(--tronco));
    height: 2px;
    border-radius: 0 2px 2px 0;
    transform-origin: left;
  }
  .nodo {
    position: relative;
    display: flex;
    gap: 0.875rem;
    box-shadow: inset 0 1px 0 rgb(229 225 228 / 0.05);
    transition: box-shadow 0.3s, transform 0.4s var(--ease-out-expo);
  }
  .nodo::before {
    /* Punto donde el codo toca la tarjeta. */
    content: '';
    position: absolute;
    left: -4px;
    top: calc(var(--codo) - 3px);
    width: 8px;
    height: 8px;
    border-radius: 999px;
    background: var(--color-primary, #c0c1ff);
    box-shadow: 0 0 10px rgb(128 131 255 / 0.8);
  }
  @media (hover: hover) {
    .nodo:hover {
      transform: translateX(4px);
      box-shadow:
        inset 0 1px 0 rgb(229 225 228 / 0.05),
        inset 0 0 0 1px rgb(192 193 255 / 0.25);
    }
  }
  .nodo-num {
    display: inline-flex;
    flex: none;
    align-items: center;
    justify-content: center;
    width: 2.25rem;
    height: 2.25rem;
    border-radius: 0.75rem;
    background: rgb(128 131 255 / 0.12);
    color: var(--color-primary, #c0c1ff);
    font-family: var(--font-mono, ui-monospace, monospace);
    font-size: 0.8125rem;
    font-weight: 600;
  }

  @media (min-width: 640px) {
    .mapa {
      --sangria: 3.25rem;
      --codo: 1.85rem;
    }
  }

  /* Las ramas se dibujan cuando cada una entra en pantalla. */
  @media (prefers-reduced-motion: no-preference) {
    :global(.js) .rama::before {
      transform: scaleY(0);
      transition: transform 0.7s var(--ease-out-expo);
      transition-delay: var(--retraso, 0ms);
    }
    :global(.js) .rama::after {
      transform: scaleX(0);
      transition: transform 0.5s var(--ease-out-expo);
      transition-delay: calc(var(--retraso, 0ms) + 0.35s);
    }
    :global(.js) .rama.visible::before {
      transform: none;
    }
    :global(.js) .rama.visible::after {
      transform: none;
    }
  }
</style>
