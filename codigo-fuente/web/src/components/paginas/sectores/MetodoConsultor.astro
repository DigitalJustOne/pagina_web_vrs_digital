---
/**
 * Visual de la portada de /paginas-web-consultores/: «de la web a la solicitud de propuesta».
 * Detrás, la web de un consultor en un navegador (dibujada con bloques, sin texto inventado) con su
 * método en cuatro pasos encendidos uno tras otro. Delante, en 3D, la solicitud de propuesta que
 * llega ordenada: sector, tamaño, necesidad y fecha, que se marcan en orden.
 *
 * Se inclina con el puntero y se endereza al bajar. Sin JS o con movimiento reducido: quieto y
 * completo. Una sola imagen para lectores de pantalla. Sin cambios de tamaño (CLS 0).
 * Textos: visualConsultores en src/data/contenido/paginas-web-consultores.ts.
 *
 * <MetodoConsultor slot="visual" />
 */
import Icono from '@/components/ui/Icono.astro';
import { visualConsultores as V } from '@/data/contenido/paginas-web-consultores';

interface Props {
  class?: string;
}
const { class: clase } = Astro.props;
const n = V.pasos.length;
---
<div role="img" aria-label={V.etiqueta} data-metodo class:list={['metodo relative mx-auto w-full max-w-[34rem]', clase]}>
  <div aria-hidden="true" class="escena">
    <span class="halo"></span>
    <div class="enderezar">
      <div class="lienzo">
        <!-- La web del consultor -->
        <div class="pagina">
          <div class="barra">
            <span class="punto"></span><span class="punto"></span><span class="punto"></span>
            <span class="direccion"><Icono nombre="lock" tamano={10} /><span class="linea" style="width:46%"></span></span>
          </div>
          <div class="cuerpo">
            <span class="titular"></span>
            <span class="titular corto"></span>
            <span class="linea" style="width:78%"></span>

            <p class="rotulo">{V.metodo}</p>
            <div class="riel-caja">
            <span class="riel-pista"><span class="riel-luz"></span></span>
            <ol class="riel" style={`--n:${n}`}>
              {
                V.pasos.map((p, i) => (
                  <li class="nodo" style={`--i:${i}`}>
                    <span class="nodo-num">{String(i + 1).padStart(2, '0')}</span>
                    <span class="nodo-texto">{p}</span>
                  </li>
                ))
              }
            </ol>
            </div>

            <span class="tarjetas">
              <span class="tarjeta"><span class="icono"></span><span class="linea" style="width:80%"></span><span class="linea" style="width:55%"></span></span>
              <span class="tarjeta"><span class="icono"></span><span class="linea" style="width:72%"></span><span class="linea" style="width:60%"></span></span>
              <span class="tarjeta"><span class="icono"></span><span class="linea" style="width:84%"></span><span class="linea" style="width:48%"></span></span>
            </span>
          </div>
        </div>

        <!-- La solicitud que llega ordenada -->
        <div class="solicitud">
          <p class="solicitud-titulo">
            <span class="wa"><Icono nombre="whatsapp" tamano={14} /></span>
            {V.solicitud}
          </p>
          <ul class="campos">
            {
              V.campos.map((c, i) => (
                <li class="campo" style={`--i:${i}`}>
                  <span class="campo-nombre">{c}</span>
                  <span class="campo-valor" style={`width:${[62, 38, 70, 44][i % 4]}%`}></span>
                  <span class="campo-tick"><Icono nombre="tick" tamano={11} trazo={3} /></span>
                </li>
              ))
            }
          </ul>
          <span class="enviar"></span>
        </div>
      </div>

      <span class="ficha">
        <span class="ficha-icono"><Icono nombre="check" tamano={14} /></span>
        {V.ficha}
      </span>
    </div>
  </div>
</div>

<script>
  import { inclinar } from './inclinar';
  inclinar('[data-metodo]', { x: 12, y: 8 });
</script>

<style>
  .metodo {
    --rx: 0deg;
    --ry: 0deg;
    container-type: inline-size;
  }
  .escena {
    position: relative;
    perspective: 1500px;
    perspective-origin: 50% 35%;
  }
  .halo {
    position: absolute;
    inset: 10% 6% 10%;
    border-radius: 999px;
    background: radial-gradient(closest-side, rgb(99 102 241 / 0.3), transparent 75%);
    filter: blur(30px);
  }
  .enderezar {
    position: relative;
    transform-style: preserve-3d;
  }
  .lienzo {
    display: grid;
    padding-top: 9cqi;
    transform-style: preserve-3d;
    transform: rotateX(calc(6deg + var(--rx))) rotateY(calc(-9deg + var(--ry)));
    transition: transform 0.6s var(--ease-out-expo);
  }

  /* ── Navegador con la web del consultor ──────────────────────────────── */
  .pagina {
    grid-area: 1 / 1;
    align-self: start;
    width: 90%;
    border-radius: 1rem;
    overflow: hidden;
    background: var(--color-surface-low, #1c1b1e);
    box-shadow:
      0 40px 80px -30px rgb(0 0 0 / 0.8),
      0 0 0 1px rgb(229 225 228 / 0.05);
  }
  .barra {
    display: flex;
    align-items: center;
    gap: 5px;
    height: 2rem;
    padding-inline: 0.875rem;
    background: var(--color-surface-high, #2a2a2c);
  }
  .punto {
    width: 7px;
    height: 7px;
    border-radius: 99px;
    background: rgb(229 225 228 / 0.22);
  }
  .direccion {
    display: flex;
    align-items: center;
    gap: 6px;
    flex: 1;
    max-width: 58%;
    height: 1.125rem;
    margin-left: 6%;
    padding-inline: 8px;
    border-radius: 99px;
    background: rgb(14 14 16 / 0.7);
    color: var(--color-online, #4ade80);
  }
  .cuerpo {
    display: grid;
    gap: 2cqi;
    padding: 5cqi 5cqi 20cqi;
    background:
      radial-gradient(80% 60% at 85% 20%, rgb(99 102 241 / 0.16), transparent 70%),
      var(--color-surface-lowest, #0e0e10);
  }
  .linea {
    display: block;
    height: 5px;
    border-radius: 99px;
    background: rgb(229 225 228 / 0.14);
  }
  .titular {
    display: block;
    height: 2.6cqi;
    width: 82%;
    border-radius: 6px;
    background: linear-gradient(90deg, #e5e1e4 0%, #c0c1ff 55%, #8083ff 100%);
    opacity: 0.85;
  }
  .titular.corto {
    width: 52%;
  }
  .rotulo {
    margin-top: 2.5cqi;
    font-family: var(--font-mono, ui-monospace, monospace);
    font-size: clamp(0.6875rem, 2.3cqi, 0.75rem);
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--color-primary, #c0c1ff);
  }
  .riel-caja {
    position: relative;
  }
  .riel {
    position: relative;
    display: grid;
    grid-template-columns: repeat(var(--n), minmax(0, 1fr));
    gap: 1cqi;
  }
  .riel-pista {
    position: absolute;
    z-index: 0;
    top: 3.6cqi;
    left: 12.5%;
    right: 12.5%;
    height: 2px;
    border-radius: 2px;
    background: rgb(192 193 255 / 0.16);
    overflow: hidden;
  }
  .riel-luz {
    position: absolute;
    inset: 0;
    background: linear-gradient(90deg, #c0c1ff, #8083ff);
    transform-origin: left;
  }
  .nodo {
    position: relative;
    z-index: 1;
    display: grid;
    justify-items: center;
    gap: 1.6cqi;
    text-align: center;
  }
  .nodo-num {
    display: grid;
    place-items: center;
    width: 7.2cqi;
    height: 7.2cqi;
    border-radius: 2cqi;
    background: linear-gradient(135deg, #c0c1ff 0%, #8083ff 100%);
    color: var(--color-on-primary, #0b0080);
    font-family: var(--font-mono, ui-monospace, monospace);
    font-size: clamp(0.5625rem, 2.4cqi, 0.75rem);
    font-weight: 600;
    box-shadow: 0 0 0 1cqi rgb(128 131 255 / 0.12), 0 8px 22px -6px rgb(128 131 255 / 0.6);
  }
  .nodo-texto {
    font-family: var(--font-display);
    font-size: clamp(0.6875rem, 2.7cqi, 0.8125rem);
    font-weight: 600;
    line-height: 1.15;
    color: var(--color-ink, #e5e1e4);
  }
  .tarjetas {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 3%;
    margin-top: 2cqi;
  }
  .tarjeta {
    display: grid;
    gap: 6px;
    padding: 9% 10%;
    border-radius: 8px;
    background: var(--color-surface-low, #1c1b1e);
  }
  .icono {
    width: 22%;
    aspect-ratio: 1;
    border-radius: 5px;
    background: rgb(192 193 255 / 0.3);
    margin-bottom: 2px;
  }

  /* ── Solicitud de propuesta ──────────────────────────────────────────── */
  .solicitud {
    grid-area: 1 / 1;
    justify-self: end;
    align-self: start;
    width: 58%;
    margin-top: 52%;
    padding: 4cqi 4cqi 4.5cqi;
    border-radius: 1.125rem;
    background:
      radial-gradient(120% 80% at 100% 0%, rgb(128 131 255 / 0.22), transparent 60%),
      rgb(42 42 44 / 0.86);
    -webkit-backdrop-filter: blur(18px) saturate(140%);
    backdrop-filter: blur(18px) saturate(140%);
    box-shadow:
      0 40px 70px -24px rgb(0 0 0 / 0.85),
      inset 0 1px 0 rgb(255 255 255 / 0.1),
      inset 0 0 0 1px rgb(192 193 255 / 0.22);
    transform: translateZ(90px);
  }
  .solicitud-titulo {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-display);
    font-size: clamp(0.75rem, 3.2cqi, 0.9375rem);
    font-weight: 600;
    color: var(--color-ink, #e5e1e4);
  }
  .wa {
    display: grid;
    flex: none;
    place-items: center;
    width: 1.625rem;
    height: 1.625rem;
    border-radius: 0.5rem;
    background: rgb(37 211 102 / 0.16);
    color: var(--color-whatsapp, #25d366);
  }
  .campos {
    display: grid;
    gap: 2cqi;
    margin-top: 3cqi;
  }
  .campo {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    grid-template-areas: 'nombre tick' 'valor tick';
    align-items: center;
    column-gap: 0.5rem;
    row-gap: 0.3rem;
    padding: 1.6cqi 2cqi;
    border-radius: 0.625rem;
    background: rgb(14 14 16 / 0.55);
  }
  .campo-nombre {
    grid-area: nombre;
    font-size: clamp(0.6875rem, 2.3cqi, 0.75rem);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    font-family: var(--font-mono, ui-monospace, monospace);
    color: var(--color-ink-soft, #c9c5c8);
  }
  .campo-valor {
    grid-area: valor;
    display: block;
    height: 5px;
    border-radius: 99px;
    background: rgb(229 225 228 / 0.2);
  }
  .campo-tick {
    grid-area: tick;
    display: grid;
    place-items: center;
    width: 1.25rem;
    height: 1.25rem;
    border-radius: 999px;
    background: linear-gradient(135deg, #c0c1ff 0%, #8083ff 100%);
    color: var(--color-on-primary, #0b0080);
  }
  .enviar {
    display: block;
    height: 2.2rem;
    max-height: 7cqi;
    margin-top: 3cqi;
    border-radius: 0.625rem;
    background: linear-gradient(135deg, #c0c1ff, #8083ff);
    box-shadow: 0 8px 22px -8px rgb(128 131 255 / 0.7);
  }

  .ficha {
    position: absolute;
    top: 0;
    right: 5%;
    display: flex;
    align-items: center;
    gap: 0.5rem;
    max-width: 58%;
    padding: 0.4rem 0.75rem 0.4rem 0.4rem;
    border-radius: 0.875rem;
    background: rgb(53 52 55 / 0.7);
    -webkit-backdrop-filter: blur(16px);
    backdrop-filter: blur(16px);
    font-size: clamp(0.6875rem, 2.8cqi, 0.8125rem);
    font-weight: 500;
    line-height: 1.3;
    color: var(--color-ink, #e5e1e4);
    box-shadow:
      0 18px 40px -14px rgb(0 0 0 / 0.7),
      inset 0 0 0 1px rgb(229 225 228 / 0.12);
    transform: translateZ(70px);
  }
  .ficha-icono {
    display: grid;
    flex: none;
    place-items: center;
    width: 1.625rem;
    height: 1.625rem;
    border-radius: 0.5rem;
    background: rgb(128 131 255 / 0.2);
    color: var(--color-primary, #c0c1ff);
  }

  @media (min-width: 1024px) {
    .ficha {
      transform: translateZ(120px);
    }
    .lienzo {
      transform: rotateX(calc(8deg + var(--rx))) rotateY(calc(-16deg + var(--ry))) rotateZ(1deg);
    }
  }

  /* ── Movimiento ──────────────────────────────────────────────────────── */
  @media (prefers-reduced-motion: no-preference) {
    .pagina {
      animation: met-entrar 1s var(--ease-out-expo) 0.15s both;
    }
    .solicitud {
      animation:
        met-entrar-z 1s var(--ease-out-expo) 0.45s both,
        met-flotar-solicitud 7s ease-in-out 1.6s infinite;
    }
    .ficha {
      animation:
        met-aparecer 0.9s var(--ease-out-expo) 0.8s both,
        met-flotar 6s ease-in-out 2s infinite;
    }
    /* El método se recorre paso a paso, en bucle. */
    .riel-luz {
      animation: met-riel 6s var(--ease-out-expo) 0.6s infinite;
    }
    /* Destello de cada paso: opacidad de una capa clara (va por el compositor; animar filter
       recalculaba estilos en cada cuadro). */
    .nodo-num {
      position: relative;
    }
    .nodo-num::after {
      content: '';
      position: absolute;
      inset: 0;
      border-radius: inherit;
      background: rgb(255 255 255 / 0.22);
      box-shadow: 0 0 10px rgb(192 193 255 / 0.9);
      opacity: 0;
      pointer-events: none;
      animation: met-nodo 6s ease infinite;
      animation-delay: calc(0.6s + var(--i) * 1.1s);
    }
    /* Los datos de la solicitud se marcan en orden (una vez). */
    .campo-tick {
      animation: met-tick 0.5s var(--ease-out-expo) both;
      animation-delay: calc(1.1s + var(--i) * 0.35s);
    }
    .campo-valor {
      transform-origin: left;
      animation: met-valor 0.6s var(--ease-out-expo) both;
      animation-delay: calc(0.95s + var(--i) * 0.35s);
    }
    @supports (animation-timeline: view()) {
      .enderezar {
        animation-name: met-enderezar;
        animation-duration: auto;
        animation-timing-function: linear;
        animation-fill-mode: both;
        animation-timeline: view();
        animation-range: exit 0% exit 100%;
      }
    }
  }
  @keyframes met-entrar {
    from {
      opacity: 0;
      translate: 0 24px;
    }
  }
  @keyframes met-entrar-z {
    from {
      opacity: 0;
      translate: 0 40px;
    }
  }
  @keyframes met-aparecer {
    from {
      opacity: 0;
      scale: 0.9;
    }
  }
  @keyframes met-flotar {
    0%,
    100% {
      translate: 0 0;
    }
    50% {
      translate: 0 -7px;
    }
  }
  /* Con transform (no translate): met-entrar-z ya anima translate y las dos juntas no iban por
     el compositor. Repite el translateZ de .solicitud y suma el desplazamiento. */
  @keyframes met-flotar-solicitud {
    50% {
      transform: translateZ(90px) translateY(-7px);
    }
  }
  @keyframes met-riel {
    0% {
      transform: scaleX(0);
      opacity: 1;
    }
    70% {
      transform: scaleX(1);
      opacity: 1;
    }
    100% {
      transform: scaleX(1);
      opacity: 0;
    }
  }
  @keyframes met-nodo {
    0%,
    20%,
    100% {
      opacity: 0;
    }
    6% {
      opacity: 1;
    }
  }
  @keyframes met-tick {
    from {
      opacity: 0;
      scale: 0.3;
    }
  }
  @keyframes met-valor {
    from {
      opacity: 0;
      transform: scaleX(0.2);
    }
  }
  @keyframes met-enderezar {
    to {
      transform: rotateX(-6deg) rotateY(12deg) translateY(-4%);
    }
  }
</style>
