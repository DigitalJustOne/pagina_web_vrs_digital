---
/**
 * Sección #estructura de /paginas-web-empresas-servicios/: «qué debe tener la web de una
 * empresa de servicios», como anatomía de una página.
 *   - Un esquema de web (bloques, sin texto inventado) con sus ocho partes numeradas.
 *   - La lista del módulo (H3 + texto por parte), en el mismo orden y con el mismo número.
 * Computador: el esquema queda fijo a la izquierda y, al bajar, se ilumina la parte de la lista
 * que pasa por el centro de la pantalla (también al pasar el puntero). Celular, sin JS o con
 * movimiento reducido: esquema completo arriba y lista debajo; los números los relacionan.
 * Las partes del esquema siguen el orden de los ocho títulos de ESTRUCTURA en el módulo.
 *
 * <AnatomiaPagina seccion={seccion} fondo="base" numero={3} resaltado="empresa de servicios" />
 */
import Icono from '@/components/ui/Icono.astro';
import { anatomiaPagina } from '@/data/contenido/paginas-web-empresas-servicios';
import type { SeccionLista } from '@/data/contenido/tipos';
import MarcoSeccion from './MarcoSeccion.astro';

interface Props {
  seccion: SeccionLista;
  fondo?: 'base' | 'bajo';
  numero?: number;
  resaltado?: string;
}

const { seccion: s, fondo = 'base', numero, resaltado } = Astro.props;
const partes = s.items.map((it, i) => ({
  n: i + 1,
  num: String(i + 1).padStart(2, '0'),
  titulo: typeof it === 'string' ? undefined : it.titulo,
  texto: typeof it === 'string' ? it : it.texto,
}));
---
<MarcoSeccion seccion={s} fondo={fondo} numero={numero} resaltado={resaltado}>
  <div data-anatomia class="anatomia contenedor tras-encabezado">
    <div class="columna-maqueta">
      <div role="img" aria-label={anatomiaPagina.etiqueta} class:list={['maqueta', fondo === 'bajo' ? 'sobre-bajo' : 'sobre-base']}>
        <div class="m-barra" aria-hidden="true">
          <span class="m-puntos"><span></span><span></span><span></span></span>
          <span class="m-direccion"></span>
        </div>
        <div class="m-cuerpo" aria-hidden="true">
          <!-- 1 · Respuesta directa arriba -->
          <div class="zona ancho" data-zona="1">
            <span class="z-num">1</span>
            <span class="b rotulo" style="width:24%"></span>
            <span class="b titulo" style="width:82%"></span>
            <span class="b titulo" style="width:54%"></span>
            <span class="b" style="width:72%"></span>
            <span class="boton"></span>
          </div>
          <!-- 2 · Una página por servicio -->
          <div class="zona ancho" data-zona="2">
            <span class="z-num">2</span>
            <span class="tarjetas">
              {
                (['file', 'chart', 'shield'] as const).map((ic) => (
                  <span class="tarjeta">
                    <span class="mini-icono">
                      <Icono nombre={ic} tamano={12} />
                    </span>
                    <span class="b fuerte" style="width:70%" />
                    <span class="b" style="width:90%" />
                  </span>
                ))
              }
            </span>
          </div>
          <!-- 3 · Cómo trabaja -->
          <div class="zona" data-zona="3">
            <span class="z-num">3</span>
            <span class="pasos">{[1, 2, 3, 4].map(() => <span class="paso" />)}</span>
            <span class="b" style="width:84%"></span>
          </div>
          <!-- 4 · Precio o forma de cotizar -->
          <div class="zona" data-zona="4">
            <span class="z-num">4</span>
            <span class="desde">desde <span></span></span>
            <span class="b" style="width:78%"></span>
          </div>
          <!-- 5 · Pruebas reales -->
          <div class="zona" data-zona="5">
            <span class="z-num">5</span>
            <span class="fila">
              <span class="mini-icono"><Icono nombre="message" tamano={12} /></span>
              <span class="grid flex-1 gap-[1.1cqi]">
                <span class="b" style="width:92%"></span>
                <span class="b" style="width:68%"></span>
              </span>
            </span>
            <span class="b fuerte" style="width:40%"></span>
          </div>
          <!-- 6 · Quién está detrás -->
          <div class="zona" data-zona="6">
            <span class="z-num">6</span>
            <span class="fila">
              <span class="avatar"><Icono nombre="user" tamano={12} /></span>
              <span class="grid flex-1 gap-[1.1cqi]">
                <span class="b fuerte" style="width:70%"></span>
                <span class="b" style="width:52%"></span>
              </span>
            </span>
            <span class="credencial"><Icono nombre="badge" tamano={10} /><span></span></span>
          </div>
          <!-- 7 · Preguntas frecuentes reales -->
          <div class="zona ancho" data-zona="7">
            <span class="z-num">7</span>
            {
              [78, 64, 70].map((w) => (
                <span class="pregunta">
                  <span class="b fuerte" style={`width:${w}%`} />
                  <Icono nombre="plus" tamano={10} />
                </span>
              ))
            }
          </div>
          <!-- 8 · Contacto visible -->
          <div class="zona ancho" data-zona="8">
            <span class="z-num">8</span>
            <span class="contacto">
              <span class="wa"><Icono nombre="whatsapp" tamano={14} /><span></span></span>
              <span class="form"><span></span><span></span></span>
            </span>
          </div>
        </div>
      </div>
    </div>

    <ol role="list" class="partes" aria-label={s.titulo}>
      {
        partes.map((p) => (
          <li data-parte={p.n} class="parte">
            <span aria-hidden="true" class="parte-num">
              {p.num}
            </span>
            <div class="min-w-0">
              {p.titulo && <h3 class="titulo-tarjeta">{p.titulo}</h3>}
              <p class:list={['text-base leading-relaxed text-ink-soft', p.titulo && 'mt-1.5']}>{p.texto}</p>
            </div>
          </li>
        ))
      }
    </ol>
  </div>
</MarcoSeccion>

<style>
  .anatomia {
    display: grid;
    gap: 2.5rem;
  }
  .columna-maqueta {
    min-width: 0;
  }
  .maqueta {
    container-type: inline-size;
    width: 100%;
    max-width: 26rem;
    margin-inline: auto;
    overflow: hidden;
    border-radius: 1.25rem;
    box-shadow:
      inset 0 0 0 1px rgb(229 225 228 / 0.08),
      0 30px 60px -30px rgb(0 0 0 / 0.8);
  }
  .sobre-base {
    background: var(--color-surface-low, #1c1b1e);
  }
  .sobre-bajo {
    background: var(--color-surface-high, #2a2a2c);
  }
  .m-barra {
    display: flex;
    align-items: center;
    height: 8cqi;
    padding: 0 4cqi;
    background: rgb(229 225 228 / 0.04);
    box-shadow: inset 0 -1px 0 rgb(229 225 228 / 0.06);
  }
  .m-puntos {
    display: flex;
    gap: 1.2cqi;
  }
  .m-puntos span {
    width: 1.7cqi;
    height: 1.7cqi;
    border-radius: 999px;
    background: rgb(229 225 228 / 0.18);
  }
  .m-direccion {
    width: 46%;
    height: 3.6cqi;
    margin: 0 auto;
    border-radius: 999px;
    background: rgb(14 14 16 / 0.6);
    translate: -3cqi 0;
  }
  .m-cuerpo {
    display: grid;
    grid-template-columns: 1.15fr 1fr;
    gap: 4.4cqi 3.6cqi;
    padding: 6cqi 5cqi 5cqi;
  }

  /* ── Zonas ────────────────────────────────────────────────────────── */
  .zona {
    position: relative;
    display: grid;
    align-content: start;
    gap: 1.4cqi;
    min-width: 0;
    padding: 3.4cqi;
    border-radius: 2.4cqi;
    background: rgb(229 225 228 / 0.025);
    box-shadow: inset 0 0 0 1px rgb(229 225 228 / 0.09);
    transition:
      opacity 0.45s var(--ease-out-expo),
      background-color 0.45s var(--ease-out-expo),
      box-shadow 0.45s var(--ease-out-expo),
      transform 0.45s var(--ease-out-expo);
  }
  .ancho {
    grid-column: 1 / -1;
  }
  .z-num {
    position: absolute;
    top: -2.4cqi;
    left: -2.4cqi;
    display: grid;
    place-items: center;
    width: max(18px, 5.4cqi);
    height: max(18px, 5.4cqi);
    border-radius: 999px;
    background: var(--color-surface-highest, #353437);
    color: var(--color-primary, #c0c1ff);
    box-shadow: 0 0 0 2px var(--color-surface, #131315);
    font-family: var(--font-mono, ui-monospace, monospace);
    font-size: clamp(9px, 2.6cqi, 12px);
    font-weight: 600;
    line-height: 1;
    transition:
      background 0.45s var(--ease-out-expo),
      color 0.45s var(--ease-out-expo);
  }
  .b {
    display: block;
    height: 1.1cqi;
    border-radius: 99px;
    background: rgb(229 225 228 / 0.22);
  }
  .b.fuerte {
    height: 1.4cqi;
    background: rgb(229 225 228 / 0.6);
  }
  .b.rotulo {
    height: 1cqi;
    background: #8083ff;
  }
  .b.titulo {
    height: 2.8cqi;
    border-radius: 0.8cqi;
    background: linear-gradient(90deg, #e5e1e4, #c0c1ff);
  }
  .b.titulo + .b:not(.titulo) {
    margin-top: 0.6cqi;
  }
  .boton {
    width: 30%;
    height: 4.6cqi;
    margin-top: 1cqi;
    border-radius: 1.2cqi;
    background: linear-gradient(135deg, #c0c1ff, #8083ff);
  }
  .tarjetas {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 2cqi;
  }
  .tarjeta {
    display: grid;
    gap: 1.1cqi;
    padding: 2cqi;
    border-radius: 1.6cqi;
    background: rgb(229 225 228 / 0.05);
  }
  .mini-icono,
  .avatar {
    display: grid;
    flex: none;
    place-items: center;
    width: 5cqi;
    height: 5cqi;
    border-radius: 1.3cqi;
    background: rgb(128 131 255 / 0.18);
    color: #c0c1ff;
  }
  .mini-icono :global(svg),
  .avatar :global(svg) {
    width: 2.8cqi;
    height: 2.8cqi;
  }
  .tarjeta .mini-icono {
    margin-bottom: 0.4cqi;
  }
  .avatar {
    width: 6.4cqi;
    height: 6.4cqi;
    border-radius: 999px;
    background: linear-gradient(135deg, rgb(192 193 255 / 0.35), rgb(99 102 241 / 0.25));
    color: #e5e1e4;
  }
  .fila {
    display: flex;
    align-items: center;
    gap: 2cqi;
  }
  .pasos {
    position: relative;
    display: flex;
    justify-content: space-between;
    margin: 0.6cqi 0 1cqi;
  }
  .pasos::before {
    content: '';
    position: absolute;
    left: 1cqi;
    right: 1cqi;
    top: 50%;
    height: 1px;
    background: rgb(192 193 255 / 0.4);
  }
  .paso {
    position: relative;
    width: 3.4cqi;
    height: 3.4cqi;
    border-radius: 999px;
    background: #2a2a2c;
    box-shadow: inset 0 0 0 1px rgb(192 193 255 / 0.55);
  }
  .desde {
    display: inline-flex;
    align-items: center;
    gap: 1cqi;
    width: max-content;
    height: 4.2cqi;
    padding: 0 2cqi;
    border-radius: 999px;
    background: rgb(74 222 128 / 0.12);
    box-shadow: inset 0 0 0 1px rgb(74 222 128 / 0.3);
    color: #4ade80;
    font-family: var(--font-mono, ui-monospace, monospace);
    font-size: clamp(8px, 2.3cqi, 11px);
    line-height: 1;
  }
  .desde span {
    width: 7cqi;
    height: 1.1cqi;
    border-radius: 99px;
    background: rgb(74 222 128 / 0.75);
  }
  .credencial {
    display: inline-flex;
    align-items: center;
    gap: 1cqi;
    width: max-content;
    height: 3.6cqi;
    padding: 0 1.8cqi 0 1.2cqi;
    border-radius: 999px;
    background: rgb(128 131 255 / 0.14);
    color: #c0c1ff;
  }
  .credencial :global(svg) {
    width: 2.2cqi;
    height: 2.2cqi;
  }
  .credencial span {
    width: 8cqi;
    height: 1cqi;
    border-radius: 99px;
    background: rgb(192 193 255 / 0.5);
  }
  .pregunta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 2cqi;
    padding: 1.6cqi 0;
    color: #c0c1ff;
  }
  .pregunta + .pregunta {
    box-shadow: inset 0 1px 0 rgb(229 225 228 / 0.07);
  }
  .pregunta :global(svg) {
    width: 2.6cqi;
    height: 2.6cqi;
  }
  .contacto {
    display: flex;
    gap: 2.4cqi;
  }
  .wa {
    display: flex;
    flex: 1.3;
    align-items: center;
    gap: 1.6cqi;
    height: 7.4cqi;
    padding: 0 2.6cqi;
    border-radius: 1.8cqi;
    background: #25d366;
    color: #0b2a17;
    box-shadow: 0 12px 26px -14px rgb(37 211 102 / 0.8);
  }
  .wa :global(svg) {
    width: 3.4cqi;
    height: 3.4cqi;
  }
  .wa span {
    width: 50%;
    height: 1.3cqi;
    border-radius: 99px;
    background: rgb(11 42 23 / 0.75);
  }
  .form {
    display: grid;
    flex: 1;
    gap: 1cqi;
    align-content: center;
  }
  .form span {
    height: 2.6cqi;
    border-radius: 0.8cqi;
    background: rgb(229 225 228 / 0.06);
    box-shadow: inset 0 0 0 1px rgb(229 225 228 / 0.1);
  }

  /* ── Lista ────────────────────────────────────────────────────────── */
  .partes {
    display: grid;
    gap: 0.5rem;
  }
  .parte {
    position: relative;
    display: flex;
    gap: 1.25rem;
    padding: 1.25rem;
    border-radius: var(--radius-card, 1rem);
    transition:
      background-color 0.45s var(--ease-out-expo),
      box-shadow 0.45s var(--ease-out-expo);
  }
  .parte-num {
    display: grid;
    flex: none;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    border-radius: 0.875rem;
    background: var(--color-surface-high, #2a2a2c);
    color: var(--color-primary, #c0c1ff);
    font-family: var(--font-mono, ui-monospace, monospace);
    font-size: 0.875rem;
    font-weight: 600;
    transition:
      background 0.45s var(--ease-out-expo),
      color 0.45s var(--ease-out-expo),
      box-shadow 0.45s var(--ease-out-expo);
  }

  /* ── Computador: esquema fijo y parte activa ──────────────────────── */
  @media (min-width: 1024px) {
    .anatomia {
      grid-template-columns: repeat(12, minmax(0, 1fr));
      gap: 3.5rem;
      align-items: start;
    }
    .columna-maqueta {
      grid-column: 1 / span 5;
      position: sticky;
      top: calc(var(--alto-encabezado) + 2rem);
    }
    .maqueta {
      /* El esquema mide ~0,6 de ancho por cada 1 de alto: cabe entero bajo el encabezado. */
      max-width: min(100%, calc((100svh - var(--alto-encabezado) - 4rem) * 0.58));
      margin-inline: 0;
    }
    .partes {
      grid-column: 6 / span 7;
      gap: 0.75rem;
      padding-block: 1rem;
    }
    .parte {
      padding: 1.5rem 1.75rem;
    }

    :global(.anatomia-viva) .zona:not(.activa) {
      opacity: 0.42;
    }
    :global(.anatomia-viva) .zona.activa {
      background: rgb(128 131 255 / 0.1);
      box-shadow:
        inset 0 0 0 1.5px rgb(192 193 255 / 0.7),
        0 0 40px -8px rgb(128 131 255 / 0.55);
      transform: scale(1.025);
    }
    :global(.anatomia-viva) .zona.activa .z-num,
    .parte.activa .parte-num {
      background: linear-gradient(135deg, #c0c1ff 0%, #8083ff 100%);
      color: var(--color-on-primary, #0b0080);
    }
    .parte.activa .parte-num {
      box-shadow: 0 10px 30px -6px rgb(128 131 255 / 0.55);
    }
    .parte.activa {
      background: var(--color-surface-low, #1c1b1e);
      box-shadow: inset 0 0 0 1px rgb(192 193 255 / 0.14);
    }
  }
  @media (min-width: 1024px) and (prefers-reduced-motion: reduce) {
    .zona,
    .z-num,
    .parte,
    .parte-num {
      transition: none;
    }
    :global(.anatomia-viva) .zona.activa {
      transform: none;
    }
  }
</style>

<script>
  // Computador: ilumina en el esquema la parte de la lista que cruza el centro de la pantalla o
  // que está bajo el puntero. En celular el esquema queda arriba, completo, sin resaltado.
  const ancho = window.matchMedia('(min-width: 1024px)');
  for (const raiz of document.querySelectorAll<HTMLElement>('[data-anatomia]')) {
    const partes = [...raiz.querySelectorAll<HTMLElement>('[data-parte]')];
    const zonas = [...raiz.querySelectorAll<HTMLElement>('[data-zona]')];
    if (!partes.length || !zonas.length) continue;

    const activar = (n: string | undefined) => {
      if (!n) return;
      for (const z of zonas) z.classList.toggle('activa', z.dataset.zona === n);
      for (const p of partes) p.classList.toggle('activa', p.dataset.parte === n);
    };
    const encender = () => {
      raiz.classList.toggle('anatomia-viva', ancho.matches);
      if (!ancho.matches) {
        for (const el of [...zonas, ...partes]) el.classList.remove('activa');
      } else if (!raiz.querySelector('.parte.activa')) {
        activar(partes[0].dataset.parte);
      }
    };
    encender();
    ancho.addEventListener('change', encender);

    const vigia = new IntersectionObserver(
      (entradas) => {
        if (!ancho.matches) return;
        for (const e of entradas) if (e.isIntersecting) activar((e.target as HTMLElement).dataset.parte);
      },
      { rootMargin: '-48% 0px -48% 0px' },
    );
    for (const p of partes) {
      vigia.observe(p);
      p.addEventListener('pointerenter', () => ancho.matches && activar(p.dataset.parte));
    }
  }
</script>
