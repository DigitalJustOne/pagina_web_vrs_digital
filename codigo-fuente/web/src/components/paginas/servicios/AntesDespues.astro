---
/**
 * Visual de la portada de /paginas-web-empresas-servicios/: la web de una empresa de servicios
 * «antes y después» de ordenarla, en una ventana de navegador con una división deslizable.
 *   - Antes (izquierda): una web de las de siempre, en grises: menú apretado, foto genérica, un
 *     muro de texto con todos los servicios, un formulario largo y un WhatsApp diminuto.
 *   - Después (derecha): respuesta directa arriba, una tarjeta por servicio con su «desde», los
 *     pasos de trabajo y un botón de WhatsApp a la vista.
 *   Las notas de cada lado son textos de la página (antesDespues en el módulo): las fallas
 *   resumen #problema y las mejoras son títulos de #estructura. La web es ficticia y no tiene
 *   texto inventado: se dibuja con bloques.
 *
 * Interacción: la división se mueve con el control deslizante de debajo (teclado y lector de
 * pantalla, con aria-valuetext) o arrastrando sobre la ilustración (ratón, lápiz o dedo en
 * horizontal; el desplazamiento vertical de la página no se bloquea). Al cargar, si no hay
 * movimiento reducido, la división hace un recorrido corto para mostrar los dos lados.
 * Sin JS: la ilustración queda partida a la mitad, quieta, y el control no se muestra (sin
 * saltos: la clase .js existe antes de pintar). Espacio reservado con aspect-ratio (CLS 0).
 *
 * <AntesDespues slot="visual" />
 */
import Icono from '@/components/ui/Icono.astro';
import { antesDespues as A } from '@/data/contenido/paginas-web-empresas-servicios';

interface Props {
  class?: string;
}
const { class: clase } = Astro.props;

const [pistaBase, ...pistaResto] = A.pista.split(' · ');
const pistaAccion = pistaResto.join(' · ');
const [fallaServicios, fallaPrecio, fallaFormulario, fallaWhatsApp] = A.fallas;
const [mejoraRespuesta, mejoraServicio, mejoraPrecio, mejoraContacto] = A.mejoras;
const valorTexto = (v: number) => `${A.antes} ${v} %, ${A.despues} ${100 - v} %`;

// Bloques de relleno (anchos en % de su columna), fijos para que la ilustración sea estable.
const lineasMuro = [
  [96, 88, 93, 70, 95, 84, 90, 62],
  [92, 97, 80, 94, 86, 91, 74, 88],
];
const servicios = [
  { icono: 'file', titulo: 62 },
  { icono: 'chart', titulo: 74 },
  { icono: 'shield', titulo: 56 },
] as const;
---
<figure data-antes-despues class:list={['antes-despues relative mx-auto w-full', clase]}>
  <div data-marco role="img" aria-label={A.etiqueta} class="marco">
    <span class="halo halo-antes" aria-hidden="true"></span>
    <span class="halo halo-despues" aria-hidden="true"></span>

    <div class="ventana" aria-hidden="true">
      <!-- Barra del navegador (igual en los dos lados) -->
      <div class="navegador">
        <span class="puntos"><span></span><span></span><span></span></span>
        <span class="direccion"><Icono nombre="lock" tamano={10} /><span></span></span>
      </div>

      <div class="pagina">
        <!-- ══ ANTES ══════════════════════════════════════════════════════ -->
        <div class="capa antes">
          <div class="a-nav">
            <span class="a-logo"></span>
            <span class="a-enlaces">{Array.from({ length: 7 }, () => <span />)}</span>
          </div>
          <div class="a-banner">
            <span class="a-sol"></span>
            <span class="a-montes"></span>
            <span class="a-titular"></span>
            <span class="a-subtitular"></span>
          </div>
          <div class="a-muro">
            {
              lineasMuro.map((col) => (
                <span class="a-columna">
                  <span class="a-subtitulo" />
                  {col.map((w) => (
                    <span class="a-linea" style={`width:${w}%`} />
                  ))}
                </span>
              ))
            }
          </div>
          <div class="a-formulario">
            {
              Array.from({ length: 6 }, (_, i) => (
                <span class="a-campo">
                  <span style={`width:${[34, 46, 28, 52, 40, 30][i]}%`} />
                </span>
              ))
            }
            <span class="a-campo alto"><span style="width:44%"></span></span>
            <span class="a-enviar"></span>
          </div>
          <div class="a-lateral">
            <span class="a-foto"></span>
            {[90, 74, 84, 60].map((w) => <span class="a-linea" style={`width:${w}%`} />)}
            <span class="a-foto chica"></span>
            {[86, 70].map((w) => <span class="a-linea" style={`width:${w}%`} />)}
          </div>
          <div class="a-pie">
            <span class="a-copy"></span>
            <span class="a-whatsapp"><Icono nombre="whatsapp" tamano={8} /></span>
          </div>

          <span class="nota falla n-servicios" style="--n:0">
            <span class="nota-icono"><Icono nombre="x" tamano={10} trazo={2.5} /></span>{fallaServicios}
          </span>
          <span class="nota falla n-formulario" style="--n:1">
            <span class="nota-icono"><Icono nombre="x" tamano={10} trazo={2.5} /></span>{fallaFormulario}
          </span>
          <span class="nota falla n-precio" style="--n:2">
            <span class="nota-icono"><Icono nombre="x" tamano={10} trazo={2.5} /></span>{fallaPrecio}
          </span>
          <span class="nota falla n-whatsapp" style="--n:3">
            <span class="nota-icono"><Icono nombre="x" tamano={10} trazo={2.5} /></span>{fallaWhatsApp}
          </span>
        </div>

        <!-- ══ DESPUÉS ════════════════════════════════════════════════════ -->
        <div class="capa despues">
          <div class="d-nav">
            <span class="d-logo"><span></span></span>
            <span class="d-enlaces"><span></span><span></span><span></span></span>
            <span class="d-wa"><Icono nombre="whatsapp" tamano={12} /><span></span></span>
          </div>
          <div class="d-respuesta">
            <span class="d-rotulo"></span>
            <span class="d-titulo" style="width:86%"></span>
            <span class="d-titulo" style="width:58%"></span>
            <span class="d-texto" style="width:94%"></span>
            <span class="d-texto" style="width:72%"></span>
            <span class="d-acciones">
              <span class="d-boton"><span></span><Icono nombre="arrow-right" tamano={12} trazo={2.25} /></span>
              <span class="d-desde grande">desde <span></span></span>
            </span>
          </div>
          <div class="d-servicios">
            {
              servicios.map((s) => (
                <span class="d-tarjeta">
                  <span class="d-icono">
                    <Icono nombre={s.icono} tamano={14} />
                  </span>
                  <span class="d-tarjeta-titulo" style={`width:${s.titulo}%`} />
                  <span class="d-texto" style="width:92%" />
                  <span class="d-texto" style="width:70%" />
                  <span class="d-desde">
                    desde <span />
                  </span>
                </span>
              ))
            }
          </div>
          <div class="d-pasos">
            {
              [1, 2, 3, 4].map((n) => (
                <span class="d-paso">
                  <span class="d-paso-num">{n}</span>
                  <span class="d-paso-linea" />
                </span>
              ))
            }
          </div>
          <div class="d-contacto">
            <span class="d-mini-form">
              <span class="d-campo"></span>
              <span class="d-campo"></span>
              <span class="d-enviar"></span>
            </span>
            <span class="d-wa-grande"><Icono nombre="whatsapp" tamano={18} /><span></span></span>
          </div>

          <span class="nota mejora n-respuesta" style="--n:0">
            <span class="nota-icono"><Icono nombre="tick" tamano={10} trazo={2.75} /></span>{mejoraRespuesta}
          </span>
          <span class="nota mejora n-servicio" style="--n:1">
            <span class="nota-icono"><Icono nombre="tick" tamano={10} trazo={2.75} /></span>{mejoraServicio}
          </span>
          <span class="nota mejora n-contacto" style="--n:2">
            <span class="nota-icono"><Icono nombre="tick" tamano={10} trazo={2.75} /></span>{mejoraContacto}
          </span>
          <span class="nota mejora n-cotizar" style="--n:3">
            <span class="nota-icono"><Icono nombre="tick" tamano={10} trazo={2.75} /></span>{mejoraPrecio}
          </span>
        </div>

        <!-- División: capa del ancho total desplazada con transform (sin recalcular diseño). -->
        <span class="division">
          <span class="sello sello-antes">{A.antes}</span>
          <span class="sello sello-despues">{A.despues}</span>
          <span class="asa">
            <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2.25" stroke-linecap="round" stroke-linejoin="round">
              <path d="m9 7-5 5 5 5" /><path d="m15 7 5 5-5 5" />
            </svg>
          </span>
        </span>
      </div>
    </div>
  </div>

  <div class="control">
    <input
      data-control
      type="range"
      min="0"
      max="100"
      step="1"
      value="50"
      aria-label={A.control}
      aria-valuetext={valorTexto(50)}
      data-antes={A.antes}
      data-despues={A.despues}
    />
  </div>
  <figcaption class="pista">
    {pistaBase}{pistaAccion && <span class="solo-js"> · {pistaAccion}</span>}
  </figcaption>
</figure>

<style>
  /* Posición de la división (0 % = todo «después»; 100 % = todo «antes»). */
  @property --ad-corte {
    syntax: '<percentage>';
    inherits: true;
    initial-value: 50%;
  }
  .antes-despues {
    --ad-corte: 50%;
    max-width: 34rem;
  }
  .marco {
    position: relative;
    aspect-ratio: 100 / 112;
    container-type: inline-size;
    touch-action: pan-y;
    -webkit-user-select: none;
    user-select: none;
  }
  :global(.js) .marco {
    cursor: ew-resize;
  }
  .halo {
    position: absolute;
    top: 12%;
    width: 60%;
    height: 70%;
    border-radius: 999px;
    filter: blur(40px);
    pointer-events: none;
  }
  /* Dentro del ancho de la figura: el desenfoque no crea desbordamiento, la caja sí. */
  .halo-antes {
    left: 0;
    background: radial-gradient(closest-side, rgb(255 180 171 / 0.14), transparent 75%);
  }
  .halo-despues {
    right: 0;
    background: radial-gradient(closest-side, rgb(99 102 241 / 0.4), transparent 75%);
  }

  /* ── Ventana del navegador ─────────────────────────────────────────── */
  .ventana {
    position: absolute;
    inset: 0;
    overflow: hidden;
    border-radius: 3.4cqi;
    background: #0e0e10;
    box-shadow:
      inset 0 0 0 1px rgb(229 225 228 / 0.1),
      0 40px 80px -30px rgb(0 0 0 / 0.9),
      0 0 0 1px rgb(0 0 0 / 0.4);
  }
  .navegador {
    position: absolute;
    inset: 0 0 auto;
    z-index: 3;
    display: flex;
    align-items: center;
    height: 8cqi;
    padding: 0 3.4cqi;
    background: linear-gradient(180deg, #2a2a2c, #1f1e21);
    box-shadow: inset 0 -1px 0 rgb(0 0 0 / 0.5);
  }
  .puntos {
    display: flex;
    gap: 1.2cqi;
  }
  .puntos span {
    width: 1.7cqi;
    height: 1.7cqi;
    border-radius: 999px;
    background: rgb(229 225 228 / 0.2);
  }
  .direccion {
    display: flex;
    align-items: center;
    gap: 1.4cqi;
    width: 48%;
    height: 4.2cqi;
    margin: 0 auto;
    padding: 0 2.4cqi;
    border-radius: 999px;
    background: rgb(14 14 16 / 0.7);
    color: rgb(229 225 228 / 0.45);
    translate: -3cqi 0;
  }
  .direccion :global(svg) {
    width: 2.2cqi;
    height: 2.2cqi;
  }
  .direccion span {
    width: 55%;
    height: 1cqi;
    border-radius: 99px;
    background: rgb(229 225 228 / 0.22);
  }
  .pagina {
    position: absolute;
    inset: 8cqi 0 0;
  }
  .capa {
    position: absolute;
    inset: 0;
    overflow: hidden;
  }
  /* Cada lado es su propio contexto de apilamiento: las notas del «antes» no asoman encima. */
  .antes {
    z-index: 0;
  }
  .despues {
    z-index: 1;
  }

  /* ══ ANTES: grises, apretado, sin jerarquía ═════════════════════════ */
  .antes {
    background: #d5d1c9;
    --a-barra: #b0aba2;
    --a-oscuro: #8b867d;
  }
  .antes > * {
    position: absolute;
  }
  .a-nav {
    top: 0;
    left: 0;
    right: 0;
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 7cqi;
    padding: 0 4cqi;
    background: #c6c1b8;
    border-bottom: 1px solid #b5b0a7;
  }
  .a-logo {
    width: 13cqi;
    height: 3cqi;
    border-radius: 0.4cqi;
    background: var(--a-oscuro);
  }
  .a-enlaces {
    display: flex;
    gap: 1.6cqi;
  }
  .a-enlaces span {
    width: 5.6cqi;
    height: 1cqi;
    background: #6f7ca6;
    box-shadow: 0 0.5cqi 0 -0.2cqi #6f7ca6;
  }
  .a-enlaces span:nth-child(even) {
    width: 7.4cqi;
  }
  .a-banner {
    top: 9.5cqi;
    left: 4cqi;
    right: 4cqi;
    height: 21cqi;
    overflow: hidden;
    background: linear-gradient(180deg, #a9b4c1 0%, #c3c9cf 70%);
  }
  .a-sol {
    top: 3cqi;
    right: 12cqi;
    width: 7cqi;
    height: 7cqi;
    border-radius: 999px;
    background: #e3dcc4;
    position: absolute;
  }
  .a-montes {
    position: absolute;
    inset: auto 0 0;
    height: 12cqi;
    background: #8e9aa8;
    clip-path: polygon(0 100%, 0 55%, 18% 20%, 34% 62%, 52% 10%, 70% 58%, 84% 30%, 100% 64%, 100% 100%);
  }
  .a-titular,
  .a-subtitular {
    position: absolute;
    left: 50%;
    border-radius: 0.4cqi;
    background: rgb(255 255 255 / 0.8);
    translate: -50% 0;
  }
  .a-titular {
    top: 6.5cqi;
    width: 46%;
    height: 2.6cqi;
  }
  .a-subtitular {
    top: 10.6cqi;
    width: 30%;
    height: 1.2cqi;
    background: rgb(255 255 255 / 0.6);
  }
  .a-muro {
    top: 33.5cqi;
    left: 4cqi;
    right: 4cqi;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 3cqi;
  }
  .a-columna {
    display: grid;
    gap: 1.15cqi;
    align-content: start;
  }
  .a-subtitulo {
    width: 48%;
    height: 1.7cqi;
    margin-bottom: 0.4cqi;
    background: var(--a-oscuro);
  }
  .a-linea {
    display: block;
    height: 0.95cqi;
    background: var(--a-barra);
  }
  .a-formulario {
    top: 59cqi;
    left: 4cqi;
    width: 52%;
    display: grid;
    gap: 1cqi;
  }
  .a-campo {
    display: flex;
    align-items: center;
    height: 3.3cqi;
    padding: 0 1.2cqi;
    background: #ebe8e2;
    box-shadow: inset 0 0 0 1px #a8a39a;
  }
  .a-campo.alto {
    height: 6cqi;
    align-items: flex-start;
    padding-top: 1.1cqi;
  }
  .a-campo span {
    height: 0.9cqi;
    background: #c4bfb6;
  }
  .a-enviar {
    width: 30%;
    height: 3.6cqi;
    margin-top: 0.6cqi;
    background: #a29d94;
    box-shadow: inset 0 -0.4cqi 0 rgb(0 0 0 / 0.12);
  }
  .a-lateral {
    top: 59cqi;
    right: 4cqi;
    width: 34%;
    display: grid;
    gap: 1.1cqi;
    padding: 2cqi;
    background: #cbc7bf;
    box-shadow: inset 0 0 0 1px #b8b3aa;
  }
  .a-foto {
    height: 9cqi;
    background: linear-gradient(135deg, #b6bdc4, #a4adb6);
  }
  .a-foto.chica {
    height: 5cqi;
    margin-top: 0.8cqi;
  }
  .a-pie {
    left: 0;
    right: 0;
    bottom: 0;
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 6cqi;
    padding: 0 4cqi;
    background: #c6c1b8;
    border-top: 1px solid #b5b0a7;
  }
  .a-copy {
    width: 30%;
    height: 0.9cqi;
    background: var(--a-barra);
  }
  /* El WhatsApp que nadie ve: diminuto y sin contraste. */
  .a-whatsapp {
    display: grid;
    place-items: center;
    width: 2.6cqi;
    height: 2.6cqi;
    border-radius: 999px;
    background: #b9c4b9;
    color: #d5d1c9;
  }
  .a-whatsapp :global(svg) {
    width: 1.6cqi;
    height: 1.6cqi;
  }

  /* ══ DESPUÉS: marca, jerarquía y contacto a la vista ═══════════════ */
  .despues {
    clip-path: inset(0 0 0 var(--ad-corte));
    background:
      radial-gradient(rgb(192 193 255 / 0.05) 1px, transparent 1px) 0 0 / 3.2cqi 3.2cqi,
      radial-gradient(120% 60% at 80% 0%, rgb(99 102 241 / 0.16), transparent 60%),
      linear-gradient(180deg, #161618 0%, #111113 100%);
  }
  .despues > * {
    position: absolute;
  }
  .d-nav {
    top: 0;
    left: 0;
    right: 0;
    display: flex;
    align-items: center;
    gap: 3cqi;
    height: 7cqi;
    padding: 0 4cqi;
    border-bottom: 1px solid rgb(229 225 228 / 0.06);
  }
  .d-logo {
    display: flex;
    align-items: center;
    gap: 1.4cqi;
  }
  .d-logo::before {
    content: '';
    width: 3.2cqi;
    height: 3.2cqi;
    border-radius: 1cqi;
    background: linear-gradient(135deg, #c0c1ff, #6366f1);
  }
  .d-logo span {
    width: 9cqi;
    height: 1.4cqi;
    border-radius: 99px;
    background: #e5e1e4;
  }
  .d-enlaces {
    display: flex;
    gap: 2.4cqi;
    margin-left: auto;
  }
  .d-enlaces span {
    width: 5.4cqi;
    height: 1cqi;
    border-radius: 99px;
    background: rgb(229 225 228 / 0.4);
  }
  .d-wa {
    display: flex;
    align-items: center;
    gap: 1cqi;
    height: 4.4cqi;
    padding: 0 2cqi 0 1.4cqi;
    border-radius: 999px;
    background: #25d366;
    color: #0b2a17;
  }
  .d-wa :global(svg) {
    width: 2.4cqi;
    height: 2.4cqi;
  }
  .d-wa span {
    width: 6cqi;
    height: 1cqi;
    border-radius: 99px;
    background: rgb(11 42 23 / 0.7);
  }
  .d-respuesta {
    top: 10cqi;
    left: 4cqi;
    right: 4cqi;
    display: grid;
    gap: 1.3cqi;
    padding: 3.6cqi;
    border-radius: 2.6cqi;
    background: linear-gradient(160deg, rgb(128 131 255 / 0.14), rgb(128 131 255 / 0.04));
    box-shadow:
      inset 0 0 0 1px rgb(192 193 255 / 0.2),
      0 20px 40px -24px rgb(99 102 241 / 0.6);
  }
  .d-rotulo {
    width: 18cqi;
    height: 1cqi;
    margin-bottom: 0.6cqi;
    border-radius: 99px;
    background: #8083ff;
  }
  .d-titulo {
    height: 2.8cqi;
    border-radius: 0.8cqi;
    background: linear-gradient(90deg, #e5e1e4, #c0c1ff);
  }
  .d-texto {
    display: block;
    height: 1cqi;
    border-radius: 99px;
    background: rgb(229 225 228 / 0.28);
  }
  .d-titulo + .d-texto {
    margin-top: 0.8cqi;
  }
  .d-acciones {
    display: flex;
    align-items: center;
    gap: 2.4cqi;
    margin-top: 1.4cqi;
  }
  .d-boton {
    display: flex;
    align-items: center;
    gap: 1.4cqi;
    height: 5cqi;
    padding: 0 2.4cqi;
    border-radius: 1.4cqi;
    background: linear-gradient(135deg, #c0c1ff, #8083ff);
    color: #0b0080;
  }
  .d-boton span {
    width: 12cqi;
    height: 1.1cqi;
    border-radius: 99px;
    background: rgb(11 0 128 / 0.55);
  }
  .d-boton :global(svg) {
    width: 2.4cqi;
    height: 2.4cqi;
  }
  /* Pastilla «desde»: el precio de partida a la vista (sin cifra: es una ilustración). */
  .d-desde {
    display: inline-flex;
    align-items: center;
    gap: 0.8cqi;
    width: max-content;
    height: 3.4cqi;
    padding: 0 1.6cqi;
    border-radius: 999px;
    background: rgb(74 222 128 / 0.12);
    box-shadow: inset 0 0 0 1px rgb(74 222 128 / 0.3);
    color: #4ade80;
    font-family: var(--font-mono, ui-monospace, monospace);
    font-size: 1.9cqi;
    line-height: 1;
  }
  .d-desde span {
    width: 5cqi;
    height: 1cqi;
    border-radius: 99px;
    background: rgb(74 222 128 / 0.75);
  }
  .d-desde.grande {
    height: 4.2cqi;
    font-size: 2.3cqi;
  }
  .d-desde.grande span {
    width: 8cqi;
  }
  .d-servicios {
    top: 45cqi;
    left: 4cqi;
    right: 4cqi;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 2cqi;
  }
  .d-tarjeta {
    display: grid;
    gap: 1.1cqi;
    align-content: start;
