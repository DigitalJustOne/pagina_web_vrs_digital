<script>
  // División deslizable: control de rango (teclado, lector de pantalla) y arrastre sobre la
  // ilustración. Al cargar, un recorrido corto muestra los dos lados (salvo movimiento reducido).
  const reducido = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  for (const figura of document.querySelectorAll<HTMLElement>('[data-antes-despues]')) {
    const marco = figura.querySelector<HTMLElement>('[data-marco]');
    const control = figura.querySelector<HTMLInputElement>('[data-control]');
    if (!marco || !control) continue;
    const antes = control.dataset.antes ?? '';
    const despues = control.dataset.despues ?? '';
    let recorrido = 0;

    const pintar = (valor: number) => {
      const v = Math.min(100, Math.max(0, valor));
      figura.style.setProperty('--ad-corte', `${v.toFixed(2)}%`);
      const entero = Math.round(v);
      control.value = String(entero);
      control.setAttribute('aria-valuetext', `${antes} ${entero} %, ${despues} ${100 - entero} %`);
    };
    const tocar = () => {
      if (recorrido) cancelAnimationFrame(recorrido);
      recorrido = 0;
      figura.classList.add('tocado');
    };

    control.addEventListener('input', () => {
      tocar();
      pintar(Number(control.value));
    });

    // Arrastre: ratón y lápiz desde el primer toque; con el dedo solo el gesto horizontal
    // (touch-action: pan-y deja el desplazamiento vertical al navegador).
    let arrastrando = false;
    const desdePuntero = (e: PointerEvent) => {
      const r = marco.getBoundingClientRect();
      pintar(((e.clientX - r.left) / r.width) * 100);
    };
    marco.addEventListener('pointerdown', (e) => {
      if (e.button !== 0) return;
      arrastrando = true;
      tocar();
      if (e.pointerType !== 'touch') {
        marco.setPointerCapture(e.pointerId);
        desdePuntero(e);
      }
    });
    marco.addEventListener('pointermove', (e) => {
      if (arrastrando) desdePuntero(e);
    });
    const soltar = () => {
      arrastrando = false;
    };
    marco.addEventListener('pointerup', soltar);
    marco.addEventListener('pointercancel', soltar);
    marco.addEventListener('lostpointercapture', soltar);

    // Recorrido de presentación: 50 → 76 → 26 → 50 (muestra el «antes» y luego el «después»).
    if (!reducido) {
      const puntos = [50, 76, 26, 50];
      const tramo = 1100;
      const suave = (t: number) => (t < 0.5 ? 4 * t * t * t : 1 - (-2 * t + 2) ** 3 / 2);
      window.setTimeout(() => {
        if (figura.classList.contains('tocado')) return;
        const inicio = performance.now();
        const paso = (ahora: number) => {
          const t = (ahora - inicio) / tramo;
          const i = Math.floor(t);
          if (i >= puntos.length - 1) {
            pintar(50);
            recorrido = 0;
            return;
          }
          pintar(puntos[i] + (puntos[i + 1] - puntos[i]) * suave(t - i));
          recorrido = requestAnimationFrame(paso);
        };
        recorrido = requestAnimationFrame(paso);
      }, 1400);
    }
  }
</script>
