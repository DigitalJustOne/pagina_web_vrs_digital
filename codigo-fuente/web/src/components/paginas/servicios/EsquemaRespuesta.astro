---
/**
 * Esquema «cómo se arma una respuesta con IA» (página /posicionamiento-google-inteligencia-artificial/).
 * Una pregunta arriba; haces que salen a buscar; tres páginas de una web (la de un servicio, sus
 * preguntas frecuentes y una guía) con el fragmento que se lee resaltado; y abajo, la respuesta
 * con IA con sus citas numeradas 1, 2 y 3.
 *
 * modo="portada"  → se arma una vez al cargar (pregunta que se escribe, haces, páginas, respuesta)
 *                   y luego queda en reposo con haces que fluyen. Inclinado en 3D; sigue al
 *                   puntero (puntero fino) y se endereza al salir de la pantalla.
 * modo="historia" → cada parte se enciende según el paso activo de la narrativa fija que lo
 *                   contiene ([data-historia] → data-paso-activo 0 a 3, de scripts/desplazamiento).
 *
 * Sin JS, sin soporte o con movimiento reducido: el esquema completo, quieto.
 * CSS y SVG en línea (sin peticiones). Espacio reservado con aspect-ratio (CLS 0).
 * Es una sola imagen para lectores de pantalla (role="img" con su descripción). En modo="historia"
 * se oculta (aria-hidden): la portada ya la describe y los pasos de al lado cuentan lo mismo.
 * Textos: esquemaRespuesta en src/data/contenido/posicionamiento-google-inteligencia-artificial.ts.
 */
import Icono from '@/components/ui/Icono.astro';
import { esquemaRespuesta as E } from '@/data/contenido/posicionamiento-google-inteligencia-artificial';

interface Props {
  modo?: 'portada' | 'historia';
  class?: string;
}

const { modo = 'portada', class: clase } = Astro.props;
const uid = Math.random().toString(36).slice(2, 8);

// Geometría en unidades del lienzo (100 de ancho × 110 de alto), igual al viewBox del SVG.
const X = [18, 50, 82] as const;
const Y = { pregunta: 17, fuentesArriba: 33, fuentesAbajo: 64, respuesta: 76 } as const;
const curva = (x1: number, y1: number, x2: number, y2: number) => {
  const m = (y1 + y2) / 2;
  return `M${x1} ${y1} C${x1} ${m} ${x2} ${m} ${x2} ${y2}`;
};
const busqueda = X.map((x) => curva(50, Y.pregunta, x, Y.fuentesArriba));
const respuesta = X.map((x) => curva(x, Y.fuentesAbajo, 50, Y.respuesta));
---
<div
  role={modo === 'portada' ? 'img' : undefined}
  aria-label={modo === 'portada' ? E.etiqueta : undefined}
  aria-hidden={modo === 'historia' ? 'true' : undefined}
  data-esquema
  class:list={['esquema relative mx-auto w-full', `modo-${modo}`, clase]}
>
  <div class="escena" aria-hidden="true">
    <div class="enderezar">
      <div class="plano">
        <span class="halo"></span>

        <!-- Haces: búsqueda (pregunta → páginas) y respuesta (páginas → respuesta) -->
        <svg class="haces" viewBox="0 0 100 110" fill="none">
          <defs>
            <linearGradient id={`haz-${uid}`} gradientUnits="userSpaceOnUse" x1="0" y1={Y.pregunta} x2="0" y2={Y.respuesta}>
              <stop offset="0" stop-color="#c0c1ff" />
              <stop offset="0.55" stop-color="#8083ff" />
              <stop offset="1" stop-color="#6366f1" />
            </linearGradient>
          </defs>
          <g class="haces-busqueda">
            {busqueda.map((d, i) => <path class="haz" d={d} pathLength="1" stroke={`url(#haz-${uid})`} style={`--i:${i}`} />)}
            {busqueda.map((d, i) => <path class="flujo" d={d} pathLength="1" style={`--i:${i}`} />)}
          </g>
          <g class="haces-respuesta">
            {respuesta.map((d, i) => <path class="haz" d={d} pathLength="1" stroke={`url(#haz-${uid})`} style={`--i:${i}`} />)}
            {respuesta.map((d, i) => <path class="flujo" d={d} pathLength="1" style={`--i:${i}`} />)}
          </g>
        </svg>

        <!-- 1. La pregunta -->
        <div class="e-pregunta">
          <span class="rotulo">{E.rotuloPregunta}</span>
          <span class="barra">
            <span class="lupa"><Icono nombre="search" tamano={16} /></span>
            <span class="consulta"><span class="tecleo">{E.consulta}</span></span>
            <span class="cursor"></span>
          </span>
        </div>

        <!-- 2 y 3. Las páginas que puede leer -->
        <span class="rotulo rotulo-lectura">{E.rotuloLectura}</span>
        <div class="e-fuentes">
          {
            E.fuentes.map((f, i) => (
              <span class={`fuente f-${i}`} style={`--i:${i}`}>
                <span class="fuente-barra">
                  <span />
                  <span />
                  <span />
                </span>
                <span class="fuente-titulo">
                  <b>{i + 1}</b>
                  <span>{f}</span>
                </span>
                <span class="l" style="--w:86%" />
                <span class="l" style="--w:64%" />
                <span class="l fragmento" style="--w:92%" />
                <span class="l" style="--w:74%" />
                <span class="l" style="--w:82%" />
                <span class="l" style="--w:58%" />
              </span>
            ))
          }
        </div>

        <!-- 4. La respuesta con IA -->
        <div class="e-respuesta">
          <span class="rotulo-respuesta">
            <span class="chispa"><Icono nombre="spark" tamano={14} /></span>
            {E.rotuloRespuesta}
          </span>
          <span class="renglones">
            {
              [92, 74, 58].map((w, i) => (
                <span class="renglon" style={`--i:${i}`}>
                  <span class="r" style={`--w:${w}%`} />
                  <b class="cita">{i + 1}</b>
                </span>
              ))
            }
          </span>
          <span class="citas">
            <span class="citas-rotulo">{E.rotuloFuentes}</span>
            {
              E.fuentes.map((f, i) => (
                <span class="ficha" style={`--i:${i}`}>
                  <b>{i + 1}</b>
                  <span>{f}</span>
                </span>
              ))
            }
          </span>
        </div>
      </div>
    </div>
  </div>
</div>

<style>
  .esquema {
    aspect-ratio: 100 / 110;
    max-width: 34rem;
    container-type: inline-size;
    --rx: 0deg;
    --ry: 0deg;
  }
  .escena {
    position: absolute;
    inset: 0;
    perspective: 1500px;
    perspective-origin: 50% 35%;
  }
  .enderezar,
  .plano {
    position: absolute;
    inset: 0;
    transform-style: preserve-3d;
  }
  .modo-portada .plano {
    transform: rotateX(calc(10deg + var(--rx))) rotateY(calc(-9deg + var(--ry)));
    transition: transform 0.6s var(--ease-out-expo);
  }
  /* En la narrativa, plano aplanado (flat): los resplandores que cambian con cada paso se pintan
     sin los recortes que Chrome aplica a sombras de capas 3D. */
  .modo-historia .plano {
    transform: rotateX(6deg) rotateY(-5deg);
  }
  .modo-historia .plano,
  .modo-historia .e-fuentes {
    transform-style: flat;
  }
  .halo {
    position: absolute;
    inset: 18% 4% 8%;
    border-radius: 999px;
    background: radial-gradient(closest-side, rgb(99 102 241 / 0.3), transparent 75%);
    filter: blur(30px);
    transform: translateZ(-60px);
  }

  /* ── Haces ─────────────────────────────────────────────────────────────── */
  .haces {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: visible;
  }
  .haz {
    stroke-width: 0.55;
    stroke-linecap: round;
    opacity: 0.75;
  }
  .flujo {
    stroke: #e4e4ff;
    stroke-width: 0.8;
    stroke-linecap: round;
    stroke-dasharray: 0.06 0.94;
    stroke-dashoffset: 0;
    opacity: 0;
    filter: drop-shadow(0 0 1.2px rgb(192 193 255 / 0.9));
  }

  /* ── Rótulos ───────────────────────────────────────────────────────────── */
  .rotulo {
    position: absolute;
    font-family: var(--font-mono, ui-monospace, monospace);
    font-size: clamp(11px, 2.1cqi, 11.5px);
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--color-primary, #c0c1ff);
  }

  /* ── 1. Pregunta ───────────────────────────────────────────────────────── */
  .e-pregunta {
    position: absolute;
    left: 6%;
    right: 6%;
    top: 0;
    height: 15.5%;
    transform: translateZ(50px);
  }
  .e-pregunta .rotulo {
    position: static;
    display: block;
  }
  .barra {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 64%;
    display: flex;
    align-items: center;
    gap: 2.4cqi;
    padding-inline: 2.2cqi 3cqi;
    border-radius: 999px;
    background: rgb(42 42 44 / 0.94);
    box-shadow:
      inset 0 0 0 1px rgb(192 193 255 / 0.28),
      0 18px 40px -16px rgb(0 0 0 / 0.8),
      0 0 0 4px rgb(128 131 255 / 0.08);
  }
  .lupa {
    display: grid;
    flex: none;
    place-items: center;
    width: 7.4cqi;
    height: 7.4cqi;
    border-radius: 999px;
    background: linear-gradient(135deg, #c0c1ff, #8083ff);
    color: var(--color-on-primary, #0b0080);
  }
  .lupa :global(svg) {
    width: 55%;
    height: 55%;
  }
  .consulta {
    min-width: 0;
    overflow: hidden;
    font-size: clamp(11px, 3cqi, 15.5px);
    font-weight: 500;
    color: var(--color-ink, #e5e1e4);
    white-space: nowrap;
  }
  .tecleo {
    display: inline-block;
  }
  .cursor {
    flex: none;
    width: 2px;
    height: 42%;
    margin-left: -1.6cqi;
    border-radius: 2px;
    background: var(--color-primary, #c0c1ff);
  }

  /* ── 2 y 3. Fuentes ────────────────────────────────────────────────────── */
  .rotulo-lectura {
    left: 0;
    right: 0;
    top: 21.6%;
    width: max-content;
    margin-inline: auto;
    padding: 0.9cqi 2.4cqi;
    border-radius: 999px;
    white-space: nowrap;
    background: var(--color-surface-lowest, #0e0e10);
    box-shadow: inset 0 0 0 1px rgb(192 193 255 / 0.25);
    transform: translateZ(20px);
  }
  .e-fuentes {
    position: absolute;
    inset: 30% 0 auto;
    height: 28.2%;
    transform-style: preserve-3d;
  }
  .fuente {
    position: absolute;
    top: 0;
    bottom: 0;
    width: 28%;
    display: flex;
    flex-direction: column;
    gap: 1.6cqi;
    padding: 0 2.2cqi 2.4cqi;
    border-radius: 2.6cqi;
    overflow: hidden;
    background:
      linear-gradient(180deg, rgb(192 193 255 / 0.06), transparent 40%),
      var(--color-surface-low, #1c1b1e);
    box-shadow:
      inset 0 0 0 1px rgb(229 225 228 / 0.1),
      0 24px 40px -22px rgb(0 0 0 / 0.85);
  }
  .f-0 {
    left: 4%;
    transform: translateZ(10px) rotateY(16deg);
    transform-origin: right center;
  }
  .f-1 {
    left: 36%;
    transform: translateZ(30px);
  }
  .f-2 {
    left: 68%;
    transform: translateZ(10px) rotateY(-16deg);
    transform-origin: left center;
  }
  .fuente-barra {
    display: flex;
    gap: 0.9cqi;
    margin-inline: -2.2cqi;
    padding: 1.5cqi 2.2cqi;
    background: rgb(229 225 228 / 0.05);
  }
  .fuente-barra span {
    width: 1.2cqi;
    height: 1.2cqi;
    border-radius: 99px;
    background: rgb(229 225 228 / 0.22);
  }
  .fuente-titulo {
    display: flex;
    align-items: flex-start;
    gap: 1.2cqi;
    min-height: 2.6em;
    font-size: clamp(11px, 2.3cqi, 12.5px);
    font-weight: 600;
    line-height: 1.25;
    color: var(--color-ink, #e5e1e4);
  }
  .fuente-titulo b,
  .cita,
  .ficha b {
    display: inline-grid;
    flex: none;
    place-items: center;
    width: 1.55em;
    height: 1.55em;
    border-radius: 999px;
    background: rgb(128 131 255 / 0.22);
    color: var(--color-primary, #c0c1ff);
    font-family: var(--font-mono, ui-monospace, monospace);
    font-size: 0.85em;
    font-weight: 600;
  }
  .l {
    display: block;
    width: var(--w);
    height: 1.25cqi;
    border-radius: 99px;
    background: rgb(229 225 228 / 0.13);
  }
  .fragmento {
    height: 1.9cqi;
    background: linear-gradient(90deg, #c0c1ff, #8083ff) 0 0 / 100% 100% no-repeat, rgb(229 225 228 / 0.13);
    box-shadow: 0 0 12px rgb(128 131 255 / 0.55);
  }

  /* ── 4. Respuesta ──────────────────────────────────────────────────────── */
  .e-respuesta {
    position: absolute;
    inset: auto 4% 0;
    top: 69.1%;
    display: flex;
    flex-direction: column;
    gap: 2cqi;
    padding: 3cqi 3.6cqi;
    border-radius: 3.4cqi;
    background:
      radial-gradient(120% 90% at 100% 0%, rgb(128 131 255 / 0.2), transparent 60%),
      rgb(42 42 44 / 0.96);
    box-shadow:
      inset 0 0 0 1px rgb(192 193 255 / 0.3),
      0 30px 60px -24px rgb(0 0 0 / 0.85),
      0 0 50px -10px rgb(99 102 241 / 0.35);
    transform: translateZ(60px);
  }
  .rotulo-respuesta {
    display: flex;
    align-items: center;
    gap: 1.6cqi;
    font-family: var(--font-display, system-ui);
    font-size: clamp(11px, 2.9cqi, 15px);
    font-weight: 600;
    color: var(--color-ink, #e5e1e4);
  }
  .chispa {
    display: grid;
    place-items: center;
    width: 5.6cqi;
    height: 5.6cqi;
    border-radius: 1.4cqi;
    background: rgb(128 131 255 / 0.2);
    color: var(--color-primary, #c0c1ff);
  }
  .chispa :global(svg) {
    width: 62%;
    height: 62%;
  }
  .renglones {
    display: grid;
    gap: 1.6cqi;
  }
  .renglon {
    display: flex;
    align-items: center;
    gap: 1.4cqi;
    font-size: clamp(8px, 2cqi, 11px);
  }
  .r {
    display: block;
    width: var(--w);
    height: 1.5cqi;
    border-radius: 99px;
    background: linear-gradient(90deg, rgb(229 225 228 / 0.4), rgb(192 193 255 / 0.32));
    transform-origin: left center;
  }
  .citas {
    display: flex;
    flex-wrap: nowrap;
    align-items: center;
    gap: 1.2cqi;
    margin-top: auto;
  }
  /* En celular, las fichas de fuentes quedarían en unos 8 px y cortadas: la respuesta ya lleva
     sus citas 1, 2 y 3. */
  @container (max-width: 480px) {
    .citas {
      display: none;
    }
  }
  .citas-rotulo {
    flex: none;
    font-family: var(--font-mono, ui-monospace, monospace);
    font-size: clamp(8px, 1.9cqi, 10.5px);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-ink-soft, #c9c5c8);
  }
  .ficha {
    display: inline-flex;
    align-items: center;
    gap: 0.9cqi;
    flex: 0 1 auto;
    min-width: 0;
    padding: 0.7cqi 1.6cqi 0.7cqi 0.8cqi;
    border-radius: 999px;
    background: rgb(14 14 16 / 0.7);
    box-shadow: inset 0 0 0 1px rgb(229 225 228 / 0.1);
    font-size: clamp(8px, 1.95cqi, 11px);
    font-weight: 500;
    color: var(--color-ink-soft, #c9c5c8);
  }
  .ficha span {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  /* ════ Movimiento: portada ══════════════════════════════════════════════
     Se arma una vez (≈ 4,5 s) y luego solo fluyen los haces. Todo lo oculto vive en las
     animaciones: sin ellas, el esquema se ve completo. */
  @media (prefers-reduced-motion: no-preference) {
    .modo-portada .tecleo {
      animation: esq-tecleo 1.2s steps(34, end) 0.35s both;
    }
    .modo-portada .cursor {
      animation: esq-cursor 1s steps(1, end) infinite;
    }
    .modo-portada .haz {
      stroke-dasharray: 1;
      animation: esq-trazar 0.7s var(--ease-out-expo) both;
    }
    .modo-portada .haces-busqueda .haz {
      animation-delay: calc(1.5s + var(--i) * 90ms);
    }
    .modo-portada .haces-respuesta .haz {
      animation-delay: calc(3.1s + var(--i) * 90ms);
    }
    /* El flujo es SVG (no va por el compositor): dos pasadas y queda el esquema quieto. */
    .modo-portada .flujo {
      animation: esq-fluir 2.6s linear 2;
      animation-delay: calc(4.2s + var(--i) * 0.45s);
    }
    .modo-portada .rotulo-lectura,
    .modo-portada .fuente {
      animation: esq-aparecer 0.8s var(--ease-out-expo) both;
      animation-delay: calc(1.85s + var(--i, 0) * 120ms);
    }
    .modo-portada .fragmento {
      animation: esq-resaltar 0.7s var(--ease-out-expo) both;
      animation-delay: calc(2.5s + var(--i) * 150ms);
    }
    .modo-portada .fuente .fragmento {
      animation-delay: calc(2.5s + var(--i) * 150ms);
    }
    .modo-portada .e-respuesta {
      animation: esq-respuesta 0.9s var(--ease-out-expo) 3.35s both;
    }
    .modo-portada .r {
      animation: esq-renglon 0.6s var(--ease-out-expo) both;
      animation-delay: calc(3.6s + var(--i) * 120ms);
    }
    .modo-portada .cita,
    .modo-portada .ficha {
      animation: esq-pop 0.5s var(--ease-out-expo) both;
      animation-delay: calc(3.9s + var(--i) * 140ms);
    }
    .modo-portada .halo {
      animation: esq-halo 6s ease-in-out 4.5s infinite;
    }

    /* Al salir de la pantalla, el esquema se endereza (desplazamiento, sin JS). */
    @supports (animation-timeline: view()) {
      .modo-portada .enderezar {
        animation-name: esq-enderezar;
        animation-duration: auto;
        animation-timing-function: linear;
        animation-fill-mode: both;
        animation-timeline: view();
        animation-range: exit 0% exit 100%;
      }
    }
  }

  /* ════ Movimiento: narrativa fija ═══════════════════════════════════════
     Solo cuando la narrativa está activa (.vrs-historia, la pone scripts/desplazamiento).
     Cada parte queda tenue hasta su paso; el paso actual brilla. */
  .modo-historia .e-pregunta,
  .modo-historia .rotulo-lectura,
  .modo-historia .fuente,
  .modo-historia .haces-busqueda,
  .modo-historia .haces-respuesta,
  .modo-historia .e-respuesta,
  .modo-historia .fragmento,
  .modo-historia .cita,
  .modo-historia .ficha {
    transition:
      opacity 0.6s var(--ease-out-expo),
      box-shadow 0.6s var(--ease-out-expo),
      filter 0.6s var(--ease-out-expo);
  }
  :global(.vrs-historia) .modo-historia .rotulo-lectura,
  :global(.vrs-historia) .modo-historia .fuente,
  :global(.vrs-historia) .modo-historia .haces-busqueda {
    opacity: 0.22;
  }
  :global(.vrs-historia) .modo-historia .haces-respuesta,
  :global(.vrs-historia) .modo-historia .e-respuesta {
    opacity: 0.18;
  }
  :global(.vrs-historia) .modo-historia .fragmento {
    background-size: 0% 100%;
    box-shadow: none;
  }
  :global(.vrs-historia) .modo-historia .cita,
  :global(.vrs-historia) .modo-historia .ficha {
    opacity: 0.3;
  }
  /* Paso 2 en adelante: búsqueda. */
  :global(.vrs-historia:is([data-paso-activo='1'], [data-paso-activo='2'], [data-paso-activo='3'])) .modo-historia :is(.haces-busqueda, .fuente, .rotulo-lectura) {
    opacity: 1;
  }
  :global(.vrs-historia[data-paso-activo='1']) .modo-historia .fuente {
    opacity: 0.55;
  }
  /* Paso 3 en adelante: lectura (fragmentos resaltados). */
  :global(.vrs-historia:is([data-paso-activo='2'], [data-paso-activo='3'])) .modo-historia .fragmento {
    background-size: 100% 100%;
    box-shadow: 0 0 12px rgb(128 131 255 / 0.55);
    transition: background-size 0.8s var(--ease-out-expo), box-shadow 0.8s;
  }
  /* Paso 4: respuesta. */
  :global(.vrs-historia[data-paso-activo='3']) .modo-historia :is(.haces-respuesta, .e-respuesta, .cita, .ficha) {
    opacity: 1;
  }
  /* El elemento del paso actual brilla. */
  :global(.vrs-historia[data-paso-activo='0']) .modo-historia .barra,
  :global(.vrs-historia[data-paso-activo='2']) .modo-historia .fuente,
  :global(.vrs-historia[data-paso-activo='3']) .modo-historia .e-respuesta {
    box-shadow:
      inset 0 0 0 1px rgb(192 193 255 / 0.55),
      0 0 0 6px rgb(128 131 255 / 0.12),
      0 0 60px -6px rgb(128 131 255 / 0.55);
  }
  :global(.vrs-historia[data-paso-activo='1']) .modo-historia .haces-busqueda {
    filter: drop-shadow(0 0 2px rgb(192 193 255 / 0.9));
  }
  @media (prefers-reduced-motion: no-preference) {
    /* El flujo (SVG, no va por el compositor) corre unas pasadas al llegar a su paso: búsqueda
       en el paso 2 y respuesta en el 4. Al volver a ese paso, empieza otra vez. */
    :global(.vrs-historia[data-paso-activo='1']) .modo-historia .haces-busqueda .flujo,
    :global(.vrs-historia[data-paso-activo='3']) .modo-historia .haces-respuesta .flujo {
      animation: esq-fluir 2.4s linear 3;
      animation-delay: calc(var(--i) * 0.4s);
    }
    .modo-historia .cursor {
      animation: esq-cursor 1s steps(1, end) infinite;
    }
  }

  @keyframes esq-tecleo {
    from {
      clip-path: inset(0 100% 0 0);
    }
    to {
      clip-path: inset(0 0 0 0);
    }
  }
  @keyframes esq-cursor {
    50% {
      opacity: 0;
    }
  }
  @keyframes esq-trazar {
    from {
      stroke-dashoffset: 1;
    }
    to {
      stroke-dashoffset: 0;
    }
  }
  @keyframes esq-fluir {
    0% {
      opacity: 0;
      stroke-dashoffset: 0.06;
    }
    12% {
      opacity: 1;
    }
    88% {
      opacity: 1;
    }
    100% {
      opacity: 0;
      stroke-dashoffset: -0.94;
    }
  }
  @keyframes esq-aparecer {
    from {
      opacity: 0;
      translate: 0 14px;
    }
  }
  @keyframes esq-resaltar {
    from {
      background-size: 0% 100%;
      box-shadow: none;
    }
  }
  @keyframes esq-respuesta {
    from {
      opacity: 0;
      translate: 0 18px;
      scale: 0.97;
    }
  }
  @keyframes esq-renglon {
    from {
      transform: scaleX(0);
    }
  }
  @keyframes esq-pop {
    from {
      opacity: 0;
      scale: 0.6;
    }
  }
  @keyframes esq-halo {
    50% {
      opacity: 0.65;
      scale: 1.06;
    }
  }
  @keyframes esq-enderezar {
    to {
      transform: rotateX(-4deg) rotateY(10deg) translateY(-3%);
    }
  }
</style>

<script>
  // Inclinación según el puntero (solo portada, puntero fino y sin movimiento reducido).
  const fino = window.matchMedia('(pointer: fine)').matches;
  const reducido = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (fino && !reducido) {
    for (const esquema of document.querySelectorAll<HTMLElement>('[data-esquema].modo-portada')) {
      let cuadro = 0;
      let x = 0;
      let y = 0;
      const zona = esquema.closest('header') ?? esquema;
      zona.addEventListener('pointermove', (e) => {
        const r = esquema.getBoundingClientRect();
        x = ((e as PointerEvent).clientX - (r.left + r.width / 2)) / window.innerWidth;
        y = ((e as PointerEvent).clientY - (r.top + r.height / 2)) / window.innerHeight;
        if (cuadro) return;
        cuadro = requestAnimationFrame(() => {
          cuadro = 0;
          esquema.style.setProperty('--ry', `${(x * 12).toFixed(2)}deg`);
          esquema.style.setProperty('--rx', `${(-y * 8).toFixed(2)}deg`);
        });
      });
      zona.addEventListener('pointerleave', () => {
        esquema.style.setProperty('--ry', '0deg');
        esquema.style.setProperty('--rx', '0deg');
      });
    }
  }
</script>
