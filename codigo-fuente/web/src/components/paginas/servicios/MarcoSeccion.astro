---
/**
 * Marco de sección para los bloques propios de las páginas de servicio (slots «seccion-<id>» de
 * PlantillaPagina). Reproduce lo que hace Seccion.astro alrededor del cuerpo:
 *   <section id aria-labelledby="<id>-titulo">, fondo base/bajo con filo de luz, número grande
 *   de orden (solo computador), encabezado (etiqueta + H2 + introducción) y pie (párrafos, nota, enlace,
 *   nota de precios si la sección muestra un precio).
 * El cuerpo va en el slot por defecto y elige su propio ancho (con o sin .contenedor).
 *
 * <MarcoSeccion seccion={s} fondo="bajo" numero={2} resaltado="una respuesta">
 *   <div class="contenedor tras-encabezado">…</div>
 * </MarcoSeccion>
 */
import EncabezadoSeccion from '@/components/ui/EncabezadoSeccion.astro';
import PieSeccion from '@/components/pagina/PieSeccion.astro';
import { idTitulo, necesitaNotaPrecios } from '@/lib/paginas';
import type { Seccion } from '@/data/contenido/tipos';

interface Props {
  seccion: Seccion;
  fondo?: 'base' | 'bajo';
  /** Número de orden (01, 02…) que la plantilla pinta en las demás secciones. */
  numero?: number;
  /** Fragmento exacto del H2 que se pinta con el degradado. */
  resaltado?: string;
  /** Muestra la nota y el enlace de la sección al final (por defecto sí). */
  conPie?: boolean;
  class?: string;
}

const { seccion: s, fondo = 'base', numero, resaltado, conPie = true, class: clase } = Astro.props;
const pie = { parrafos: s.parrafos, nota: s.nota, enlace: s.enlace, notaPrecios: necesitaNotaPrecios(s) };
---
<section
  id={s.id}
  aria-labelledby={idTitulo(s.id)}
  data-tipo={s.tipo}
  class:list={['marco-seccion seccion relative isolate', fondo === 'bajo' && 'fondo-bajo', clase]}
>
  {
    numero !== undefined && (
      <span aria-hidden="true" class="numero pointer-events-none absolute top-0 right-6 -z-10 hidden font-display select-none lg:block xl:right-[max(2rem,calc((100vw-80rem)/2+2rem))]">
        {String(numero).padStart(2, '0')}
      </span>
    )
  }
  <div class="contenedor">
    <EncabezadoSeccion etiqueta={s.etiqueta} titulo={s.titulo} resaltado={resaltado} introduccion={s.introduccion} id={idTitulo(s.id)} dividido />
  </div>
  <slot />
  {
    conPie && (
      <div class="contenedor">
        <PieSeccion {...pie} />
      </div>
    )
  }
</section>

<style>
  /* Igual que Seccion.astro: clip (no hidden) para no romper los bloques fijos (sticky). */
  .marco-seccion {
    overflow: clip;
  }
  .fondo-bajo {
    background: var(--color-surface-low, #1c1b1e);
  }
  .fondo-bajo::before {
    content: '';
    position: absolute;
    inset: 0 0 auto;
    height: 1px;
    background: linear-gradient(90deg, transparent, rgb(192 193 255 / 0.28) 30%, rgb(128 131 255 / 0.22) 70%, transparent);
  }
  .numero {
    font-size: clamp(8rem, 12vw, 13rem);
    line-height: 1;
    font-weight: 600;
    letter-spacing: -0.06em;
    translate: 0 -42%;
    background: linear-gradient(180deg, rgb(192 193 255 / 0.03) 40%, rgb(192 193 255 / 0.12));
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    -webkit-text-stroke: 1px rgb(192 193 255 / 0.13);
  }
  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) {
      .numero {
        animation-name: marco-numero;
        animation-duration: auto;
        animation-timing-function: linear;
        animation-fill-mode: both;
        animation-timeline: view();
        animation-range: entry 10% entry 90%;
      }
    }
  }
  @keyframes marco-numero {
    from {
      translate: 0 -95%;
    }
    to {
      translate: 0 -42%;
    }
  }
</style>
