---
/**
 * Conversación de ejemplo en un marco de teléfono con la estética de la marca.
 * Sugiere WhatsApp (burbujas, verde de acento) sin copiar su interfaz ni usar su logo.
 * Los dos primeros mensajes ya vienen pintados (el teléfono nunca se ve vacío); los demás
 * aparecen escalonados con un indicador "escribiendo…" un poco antes de que el teléfono entre
 * en pantalla. La pantalla tiene alto de teléfono y la conversación baja sola hasta el último
 * mensaje (como un chat real). La lista no atrapa el dedo ni la rueda (overflow hidden): la
 * página sigue bajando; con el teclado (foco en la lista) se recorre con las flechas.
 * Sin JS o con movimiento reducido, la conversación se muestra completa, sin alto fijo.
 * Todo el texto está en el HTML: los lectores de pantalla y los buscadores lo leen completo.
 *
 * <ConversacionWhatsApp
 *   titulo="Contadores Ruiz & Asociados"
 *   mensajes={[
 *     { de: 'cliente', texto: 'Hola, ¿cuánto cuesta la declaración de renta?', hora: '9:12 p. m.' },
 *     { de: 'asistente', texto: 'Hola. La declaración de renta para persona natural empieza en…', hora: '9:12 p. m.' },
 *     { de: 'persona', texto: 'Buenos días, soy Laura. Le confirmo la cita del jueves.', hora: '8:05 a. m.' },
 *   ]}
 *   nota="Ejemplo ilustrativo. Las respuestas reales dependen de la información que su empresa apruebe."
 * />
 */
import Icono from './Icono.astro';

type Autor = 'cliente' | 'asistente' | 'persona';

interface Mensaje {
  de: Autor;
  texto: string;
  hora: string;
  /** Rótulo centrado antes del mensaje para marcar un salto de tiempo (ej. "Al día siguiente"). */
  separador?: string;
}

interface Props {
  /** Nombre del contacto que se ve en la cabecera (la empresa). */
  titulo: string;
  mensajes: readonly Mensaje[];
  /** Estado bajo el nombre. Por defecto "En línea". */
  estado?: string;
  /** Nota al pie del teléfono (aclaración). */
  nota?: string;
  class?: string;
}

const { titulo, mensajes, estado = 'En línea', nota, class: clase } = Astro.props;

const NOMBRE_AUTOR: Record<Autor, string> = {
  cliente: 'Cliente',
  asistente: 'Agente de IA',
  persona: 'Persona del equipo',
};

/** Mensajes que ya vienen visibles en el HTML (pregunta y primera respuesta). */
const PINTADOS = 2;

const iniciales = titulo
  .split(/\s+/)
  .filter((p) => /^[\p{L}\d]/u.test(p))
  .slice(0, 2)
  .map((p) => p[0]!.toUpperCase())
  .join('');
---
<figure data-conversacion class:list={['conversacion mx-auto flex w-full max-w-[23rem] flex-col items-center', clase]}>
  <p class="chip mb-5 font-mono text-[0.6875rem] tracking-[0.12em] uppercase">
    <Icono nombre="info" tamano={14} />
    Conversación de ejemplo
  </p>

  <div class="telefono relative w-full">
    <span aria-hidden="true" class="halo-telefono pointer-events-none absolute -inset-x-4 -inset-y-10 -z-10 sm:-inset-10"></span>
    <div class="pantalla">
      <span aria-hidden="true" class="isla"></span>

      <div class="cabecera flex items-center gap-3 px-4 pt-9 pb-3">
        <span aria-hidden="true" class="avatar flex h-10 w-10 shrink-0 items-center justify-center rounded-full font-display text-sm font-semibold">
          {iniciales}
        </span>
        <div class="min-w-0">
          <p class="truncate font-display text-[0.9375rem] font-semibold text-ink">{titulo}</p>
          <p class="flex items-center gap-1.5 text-xs text-ink-soft">
            <span aria-hidden="true" class="h-2 w-2 rounded-full bg-online shadow-[0_0_8px_rgb(74_222_128/0.7)]"></span>
            {estado}
          </p>
        </div>
      </div>

      <ol role="list" tabindex="0" aria-label={`Mensajes de ejemplo con ${titulo}`} class="mensajes relative flex flex-col gap-2 px-3 pt-4 pb-5">
        {
          mensajes.map((m, i) => {
            const cambiaAutor = i === 0 || mensajes[i - 1]!.de !== m.de;
            const deEmpresa = m.de !== 'cliente';
            return (
              <li data-de={m.de} class:list={['msg flex flex-col', deEmpresa ? 'items-start' : 'items-end', (cambiaAutor || m.separador) && i > 0 && 'mt-2', i < PINTADOS && 'mostrado']}>
                {m.separador && (
                  <span class="separador mb-3 self-center rounded-full bg-surface-high/80 px-3 py-1 font-mono text-[0.6875rem] tracking-[0.08em] text-ink-soft">
                    {m.separador}
                  </span>
                )}
                {deEmpresa && (cambiaAutor || m.separador) && (
                  <span aria-hidden="true" class:list={['autor mb-1 flex items-center gap-1.5 px-1 text-[0.6875rem] font-medium', m.de === 'persona' ? 'text-primary' : 'text-ink-soft']}>
                    <Icono nombre={m.de === 'persona' ? 'user' : 'spark'} tamano={12} />
                    {NOMBRE_AUTOR[m.de]}
                  </span>
                )}
                <div class="celda grid max-w-[86%]">
                  {deEmpresa && (
                    <span aria-hidden="true" class="escribiendo burbuja burbuja-asistente flex items-center gap-2 self-start justify-self-start">
                      <span class="puntos flex gap-1">
                        <span />
                        <span />
                        <span />
                      </span>
                      <span class="text-xs text-ink-soft">escribiendo…</span>
                    </span>
                  )}
                  <p class:list={['contenido burbuja', `burbuja-${m.de}`]}>
                    <span class="sr-only">{NOMBRE_AUTOR[m.de]}: </span>
                    <span class="texto">{m.texto}</span>
                    <span class="hora">
                      <span class="sr-only">, </span>
                      {m.hora}
                    </span>
                  </p>
                </div>
              </li>
            );
          })
        }
      </ol>

      <div aria-hidden="true" class="entrada flex items-center gap-2 px-3 pb-4">
        <span class="h-10 flex-1 rounded-full bg-surface-high/70"></span>
        <span class="flex h-10 w-10 items-center justify-center rounded-full bg-whatsapp/90 text-surface-lowest">
          <Icono nombre="send" tamano={16} />
        </span>
      </div>
    </div>
  </div>

  {nota && <figcaption class="mt-5 max-w-[22rem] text-center text-sm leading-relaxed text-ink-soft">{nota}</figcaption>}
</figure>

<script>
  // Reproduce la conversación una vez, cuando entra en pantalla.
  // «Reducir movimiento» del sistema o «Pausar animaciones» del pie (src/scripts/pausa.ts): la
  // conversación se muestra completa. La pausa puede llegar después de cargar (evento
  // 'vrs:movimiento'): entonces se detiene la reproducción y se muestran todos los mensajes.
  const reducido =
    window.matchMedia('(prefers-reduced-motion: reduce)').matches || document.documentElement.hasAttribute('data-sin-movimiento');
  let detenido = reducido;
  const esperar = (ms: number) => new Promise((r) => setTimeout(r, ms));

  async function reproducir(conv: HTMLElement) {
    const lista = conv.querySelector<HTMLElement>('.mensajes');
    // Si la persona recorre la conversación con el teclado, deja de bajar sola. (El dedo y la
    // rueda pasan de largo: la lista no se desplaza con ellos y la página sigue bajando.)
    let seguir = true;
    lista?.addEventListener('keydown', () => (seguir = false), { once: true });
    /** Baja la lista lo justo para que el mensaje (aún invisible, ya ocupa su lugar) se vea completo. */
    const mostrarEnPantalla = (msg: HTMLElement) => {
      if (!lista || !seguir) return;
      const destino = msg.offsetTop + msg.offsetHeight - lista.clientHeight + 20;
      if (destino > lista.scrollTop) lista.scrollTo({ top: destino, behavior: 'smooth' });
    };
    for (const msg of conv.querySelectorAll<HTMLElement>('.msg:not(.mostrado)')) {
      if (detenido) return;
      mostrarEnPantalla(msg);
      if (msg.dataset.de === 'cliente') {
        await esperar(300);
      } else {
        msg.classList.add('escribe');
        await esperar(500);
        msg.classList.remove('escribe');
      }
      msg.classList.add('mostrado');
      await esperar(150);
    }
  }

  function mostrarTodo(conv: HTMLElement) {
    conv.querySelectorAll('.msg').forEach((m) => {
      m.classList.remove('escribe');
      m.classList.add('mostrado');
    });
  }

  const conversaciones = document.querySelectorAll<HTMLElement>('[data-conversacion]');
  let obs: IntersectionObserver | undefined;
  window.addEventListener('vrs:movimiento', (e) => {
    if (!(e as CustomEvent<{ pausado: boolean }>).detail?.pausado || detenido) return;
    detenido = true;
    obs?.disconnect();
    conversaciones.forEach(mostrarTodo);
  });
  if (reducido || !('IntersectionObserver' in window)) {
    conversaciones.forEach(mostrarTodo);
  } else {
    const observador = new IntersectionObserver(
      (entradas) => {
        for (const e of entradas) {
          if (!e.isIntersecting) continue;
          observador.unobserve(e.target);
          void reproducir(e.target as HTMLElement);
        }
      },
      // Empieza cuando el teléfono está a menos de 40 % de pantalla de entrar.
      { rootMargin: '0px 0px 40% 0px', threshold: 0 },
    );
    obs = observador;
    conversaciones.forEach((c) => observador.observe(c));
  }
</script>

<style>
  .telefono {
    isolation: isolate;
    padding: 0.55rem;
    border-radius: 2.9rem;
    background: linear-gradient(150deg, #353437 0%, #1c1b1e 35%, #0e0e10 100%);
    box-shadow:
      inset 0 0 0 1px rgb(229 225 228 / 0.08),
      inset 0 1px 0 rgb(229 225 228 / 0.12),
      0 40px 80px -24px rgb(0 0 0 / 0.75);
  }
  .halo-telefono {
    background: radial-gradient(50% 45% at 50% 50%, rgb(99 102 241 / 0.28), transparent 70%);
    filter: blur(24px);
  }
  .pantalla {
    position: relative;
    overflow: hidden;
    border-radius: 2.4rem;
    background:
      radial-gradient(rgb(192 193 255 / 0.05) 1px, transparent 1px) 0 0 / 18px 18px,
      linear-gradient(180deg, #131315 0%, #0e0e10 100%);
  }
  .isla {
    position: absolute;
    top: 0.6rem;
    left: 50%;
    width: 5.5rem;
    height: 1.5rem;
    translate: -50% 0;
    border-radius: 999px;
    background: #050506;
  }
  /* Alto de teléfono: los mensajes se desplazan dentro de la pantalla, con un difuminado en los bordes. */
  .mensajes {
    max-height: clamp(20rem, 52svh, 33rem);
    /* hidden: el dedo y la rueda mueven la página, no la lista (scrollTo del script sí funciona). */
    overflow-y: hidden;
    outline: none;
    scrollbar-width: thin;
    scrollbar-color: rgb(192 193 255 / 0.22) transparent;
    -webkit-mask-image: linear-gradient(180deg, transparent 0, #000 1rem, #000 calc(100% - 1rem), transparent 100%);
    mask-image: linear-gradient(180deg, transparent 0, #000 1rem, #000 calc(100% - 1rem), transparent 100%);
  }
  /* Con el teclado, la lista se recorre con las flechas. */
  .mensajes:focus-visible {
    overflow-y: auto;
  }
  /* Sin JS o con movimiento reducido no hay reproducción: la conversación completa, sin alto fijo. */
  :global(html:not(.js)) .mensajes {
    max-height: none;
  }
  @media (prefers-reduced-motion: reduce) {
    .mensajes {
      max-height: none;
    }
  }
  :global(html[data-sin-movimiento]) .mensajes {
    max-height: none;
  }
  /* Foco de teclado en la lista: se marca el borde de la pantalla (el difuminado taparía un contorno interno). */
  .pantalla:has(.mensajes:focus-visible) {
    box-shadow: 0 0 0 2px var(--color-primary, #c0c1ff);
  }
  .cabecera {
    background: rgb(28 27 30 / 0.85);
    -webkit-backdrop-filter: blur(16px);
    backdrop-filter: blur(16px);
  }
  .avatar {
    background: linear-gradient(135deg, #c0c1ff, #6366f1);
    color: var(--color-on-primary, #0b0080);
  }

  .burbuja {
    position: relative;
    padding: 0.55rem 0.8rem 0.45rem;
    border-radius: 1.1rem;
    font-size: 0.9375rem;
    line-height: 1.45;
    color: var(--color-ink, #e5e1e4);
    overflow-wrap: anywhere;
  }
  .texto {
    white-space: pre-line;
  }
  .contenido {
    grid-area: 1 / 1;
    transition: opacity 0.35s;
  }
  .burbuja-cliente {
    background: rgb(37 211 102 / 0.16);
    box-shadow: inset 0 0 0 1px rgb(37 211 102 / 0.22);
    border-bottom-right-radius: 0.35rem;
  }
  .burbuja-asistente {
    background: rgb(53 52 55 / 0.85);
    box-shadow: inset 0 0 0 1px rgb(229 225 228 / 0.06);
    border-top-left-radius: 0.35rem;
  }
  .burbuja-persona {
    background: rgb(128 131 255 / 0.18);
    box-shadow: inset 0 0 0 1px rgb(192 193 255 / 0.2);
    border-top-left-radius: 0.35rem;
  }
  .hora {
    float: right;
    margin: 0.35rem 0 0 0.75rem;
    font-family: var(--font-mono, ui-monospace, monospace);
    font-size: 0.6875rem;
    line-height: 1.6;
    color: var(--color-ink-soft, #c9c5c8);
    opacity: 0.85;
  }

  /* Indicador "escribiendo…": ocupa la misma celda que la burbuja (sin saltos de diseño). */
  .escribiendo {
    grid-area: 1 / 1;
    visibility: hidden;
    opacity: 0;
    padding-block: 0.6rem;
  }
  .puntos span {
    width: 0.4rem;
    height: 0.4rem;
    border-radius: 999px;
    background: var(--color-primary, #c0c1ff);
    opacity: 0.8;
  }

  @media (prefers-reduced-motion: no-preference) {
    :global(.js) .conversacion .msg {
      opacity: 0;
      transform: translateY(10px) scale(0.98);
      transition:
        opacity 0.45s cubic-bezier(0.16, 1, 0.3, 1),
        transform 0.45s cubic-bezier(0.16, 1, 0.3, 1);
    }
    :global(.js) .conversacion .msg.escribe {
      opacity: 1;
      transform: none;
    }
    :global(.js) .conversacion .msg.escribe .contenido {
      opacity: 0;
    }
    :global(.js) .conversacion .msg.escribe .escribiendo {
      visibility: visible;
      opacity: 1;
    }
    :global(.js) .conversacion .msg.mostrado {
      opacity: 1;
      transform: none;
    }
    /* Los puntos solo se mueven mientras se ve «escribiendo…» (antes seguían en bucle, ocultos,
       en los diez mensajes y recalculaban estilos en cada cuadro). */
    :global(.js) .conversacion .msg.escribe .puntos span {
      animation: conversacion-punto 1.1s ease-in-out infinite;
    }
    :global(.js) .conversacion .msg.escribe .puntos span:nth-child(2) {
      animation-delay: 0.15s;
    }
    :global(.js) .conversacion .msg.escribe .puntos span:nth-child(3) {
      animation-delay: 0.3s;
    }
  }

  @keyframes conversacion-punto {
    0%, 60%, 100% { transform: translateY(0); opacity: 0.45; }
    30% { transform: translateY(-3px); opacity: 1; }
  }
</style>
