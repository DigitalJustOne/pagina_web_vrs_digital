---
/**
 * Encabezado de sección: etiqueta técnica + título editorial + introducción.
 * No impone H1: por defecto es H2. Use nivel="h1" solo en el encabezado principal de la página.
 *
 * <EncabezadoSeccion
 *   etiqueta="Proceso"
 *   titulo="Cinco pasos, sin intermediarios"
 *   resaltado="sin intermediarios"
 *   introduccion="Sabe qué sigue en cada etapa y qué necesitamos de su parte."
 *   id="proceso-titulo"
 * />
 *
 * Con `dividido`, en computador el título va a la izquierda y la introducción a la derecha
 * (asimetría editorial). El slot por defecto se muestra debajo (botones, chips…).
 */
interface Props {
  etiqueta: string;
  titulo: string;
  /** Fragmento exacto de `titulo` que se pinta con el degradado de la marca. */
  resaltado?: string;
  introduccion?: string;
  alineacion?: 'izquierda' | 'centro';
  nivel?: 'h1' | 'h2';
  /** id del título, para usarlo en aria-labelledby de la sección. */
  id?: string;
  /** Título a la izquierda e introducción a la derecha en pantallas grandes (solo con alineación izquierda). */
  dividido?: boolean;
  /** Animación de entrada al desplazarse. Por defecto no: los títulos se leen apenas entran en pantalla. */
  revelar?: boolean;
  class?: string;
}

const {
  etiqueta,
  titulo,
  resaltado,
  introduccion,
  alineacion = 'izquierda',
  nivel = 'h2',
  id,
  dividido = false,
  revelar = false,
  class: clase,
} = Astro.props;

const Titulo = nivel;
const centro = alineacion === 'centro';
const partido = !centro && dividido && Boolean(introduccion);

// Divide el título para resaltar un fragmento sin usar HTML crudo.
let partes: { texto: string; resaltar: boolean }[] = [{ texto: titulo, resaltar: false }];
if (resaltado) {
  const i = titulo.indexOf(resaltado);
  if (i >= 0) {
    partes = [
      { texto: titulo.slice(0, i), resaltar: false },
      { texto: resaltado, resaltar: true },
      { texto: titulo.slice(i + resaltado.length), resaltar: false },
    ].filter((p) => p.texto);
  }
}

const claseTitulo = nivel === 'h1' ? 'titulo-pagina' : 'titulo-seccion';
---
<header
  data-revelar={revelar ? '' : undefined}
  class:list={[
    'encabezado-seccion',
    centro ? 'mx-auto max-w-3xl text-center' : partido ? 'grid gap-6 lg:grid-cols-12 lg:items-end lg:gap-10' : 'max-w-3xl',
    clase,
  ]}
>
  <div class:list={[partido && 'lg:col-span-7']}>
    <Titulo id={id} class:list={[claseTitulo]}>
      {partes.map((p) => (p.resaltar ? <span class="degradado-texto">{p.texto}</span> : p.texto))}
    </Titulo>
  </div>
  {
    introduccion && (
      <p
        class:list={[
          'texto-guia',
          partido ? 'lg:col-span-5 lg:pb-1.5' : 'mt-5',
          centro && 'mx-auto',
          nivel === 'h1' && 'sm:text-xl',
        ]}
      >
        {introduccion}
      </p>
    )
  }
  {Astro.slots.has('default') && (
    <div class:list={['mt-8 flex flex-wrap gap-3', centro && 'justify-center', partido && 'lg:col-span-12 lg:mt-0']}>
      <slot />
    </div>
  )}
</header>
