---
/**
 * Galería de casos reales (CASOS de @/data/sitio): un caso destacado grande + grilla.
 *
 * <GaleriaCasos />                → todos los casos
 * <GaleriaCasos limite={4} />     → destacado + 3 (para inicio o servicios)
 * <GaleriaCasos clientes={['Equipos y Componentes DEC', 'Delis Broaster']} /> → solo esos, en ese orden
 * <GaleriaCasos fondo="bajo" />   → si la sección usa bg-surface-low
 *
 * Cada caso lleva su rótulo según CASOS[].tipo: «Cliente», «Producto propio» o «Plataforma»
 * (src/lib/casos.ts). Los productos no muestran «resultados» ni cifras.
 * Imágenes: width/height reales y carga diferida; si existe el .webp junto al .png, se sirve con <picture>.
 * Las capturas nunca se recortan: el caso destacado usa la proporción real de su imagen y las
 * tarjetas la muestran completa (object-contain) sobre el fondo del marco.
 * En celular (< 768 px), las tarjetas forman un carrusel horizontal con scroll-snap.
 * Medidas y textos alternativos de cada caso: src/lib/casos.ts.
 */
import { CASOS, type Caso } from '@/data/sitio';
import { casosPorNombre, imagenCaso, rotuloCaso } from '@/lib/casos';
import Icono from './Icono.astro';

interface Props {
  /** Número total de casos a mostrar (incluido el destacado). */
  limite?: number;
  /** Nombres exactos de CASOS[].cliente, en el orden en que se muestran. */
  clientes?: readonly string[];
  nivelTitulo?: 'h2' | 'h3';
  fondo?: 'base' | 'bajo';
  /** Carga inmediata de la imagen destacada (solo si la galería está en la primera pantalla). */
  prioridad?: boolean;
  class?: string;
}

const { limite, clientes, nivelTitulo = 'h3', fondo = 'base', prioridad = false, class: clase } = Astro.props;
const Titulo = nivelTitulo;
const imagen = (caso: Caso) => imagenCaso(caso);
/** Lista accesible de logros: «Resultados» solo para trabajos de clientes. */
const etiquetaLogros = (caso: Caso) => (caso.tipo === 'cliente' ? `Resultados de ${caso.cliente}` : `Qué ofrece ${caso.cliente}`);

/** Separa "+160% en ingresos el primer año" en cifra y explicación (nunca en productos propios). */
function partirLogro(logro: string, caso: Caso) {
  const m = caso.tipo === 'cliente' ? /^([+\-−]?\d[\d.,]*\s?%?)\s+(.+)$/.exec(logro) : null;
  return m ? { cifra: m[1], texto: m[2] } : { cifra: null, texto: logro };
}

const base = clientes ? casosPorNombre(clientes) : CASOS;
const lista = base.slice(0, limite ?? base.length);
const destacado = lista.find((c) => c.destacado) ?? lista[0];
const otros = lista.filter((c) => c !== destacado);
const capa = fondo === 'bajo' ? 'bg-surface-high' : 'bg-surface-low';
const hueco = fondo === 'bajo' ? 'bg-surface-low' : 'bg-surface-lowest';
const idBase = `caso-${Math.random().toString(36).slice(2, 7)}`;

/** En computador la grilla tiene 6 columnas: filas de 3 tarjetas; si sobran 2, ocupan media fila cada una; si sobra 1, va centrada. */
function claseCelda(i: number) {
  const n = otros.length;
  const sobran = n % 3;
  const enUltimaFila = i >= n - sobran;
  if (sobran === 2 && enUltimaFila) return 'lg:col-span-3';
  if (sobran === 1 && enUltimaFila) return 'md:col-span-2 md:mx-auto md:w-full md:max-w-[36rem] lg:col-span-2 lg:col-start-3 lg:max-w-none';
  return 'lg:col-span-2';
}
---
<div class:list={['galeria-casos', clase]}>
  {
    destacado && (() => {
      const img = imagen(destacado);
      const id = `${idBase}-0`;
      return (
        <article
          aria-labelledby={id}
          data-revelar={prioridad ? undefined : ''}
          class:list={['group relative grid gap-6 overflow-hidden rounded-panel p-4 sm:p-6 lg:grid-cols-12 lg:gap-x-10 lg:p-8', capa]}
        >
          <span aria-hidden="true" class="resplandor pointer-events-none absolute -top-40 -right-40 h-96 w-96 rounded-full" />
          <figure class="ventana relative lg:col-span-7 lg:row-span-3 lg:self-center">
            <div aria-hidden="true" class="flex items-center gap-1.5 px-4 py-3">
              <span class="h-2.5 w-2.5 rounded-full bg-ink-mute/40" />
              <span class="h-2.5 w-2.5 rounded-full bg-ink-mute/40" />
              <span class="h-2.5 w-2.5 rounded-full bg-ink-mute/40" />
            </div>
            <div
              class:list={['relative overflow-hidden', img.ajuste === 'contain' && 'aspect-[3/2]', hueco]}
              style={img.ajuste === 'contain' ? undefined : `aspect-ratio:${img.ancho}/${img.alto}`}
            >
              <picture>
                {img.webp && <source srcset={img.webp} type="image/webp" />}
                <img
                  src={destacado.imagen}
                  alt={img.alt}
                  width={img.ancho}
                  height={img.alto}
                  loading={prioridad ? 'eager' : 'lazy'}
                  fetchpriority={prioridad ? 'high' : undefined}
                  decoding="async"
                  class:list={['captura absolute inset-0 h-full w-full', img.ajuste === 'contain' ? 'object-contain p-8' : 'object-cover']}
                  style={`object-position:${img.posicion}`}
                />
              </picture>
            </div>
          </figure>

          <div class="relative flex flex-col lg:col-span-5 lg:col-start-8 lg:pt-2">
            <p class="flex flex-wrap gap-2">
              <span class="chip font-mono text-[0.6875rem] tracking-[0.12em] uppercase">
                <Icono nombre="spark" tamano={14} />
                Caso destacado
              </span>
              <span class="chip rotulo font-mono text-[0.6875rem] tracking-[0.12em] uppercase">{rotuloCaso(destacado.cliente)}</span>
            </p>
            <Titulo id={id} class="mt-5 font-display text-[1.75rem] leading-tight font-semibold tracking-[-0.02em] text-ink sm:text-[2rem]">
              {destacado.cliente}
            </Titulo>
            <p class="etiqueta mt-2 !tracking-[0.15em] text-ink-soft">{destacado.sector}</p>
            <p class="mt-4 text-base leading-relaxed text-ink-soft sm:text-lg">{destacado.resumen}</p>
          </div>

          <ul role="list" aria-label={etiquetaLogros(destacado)} class="relative grid gap-3 sm:grid-cols-3 lg:col-span-5 lg:col-start-8">
            {destacado.logros.map((logro) => {
              const { cifra, texto } = partirLogro(logro, destacado);
              return (
                <li class:list={['flex items-center gap-4 rounded-card p-4 sm:flex-col sm:items-start sm:gap-2', hueco]}>
                  {cifra && (
                    <span class="min-w-[5rem] font-display text-[1.875rem] leading-none font-semibold tracking-[-0.03em] text-primary sm:min-w-0">
                      {cifra}
                    </span>
                  )}
                  <span class="text-sm leading-snug text-ink-soft">{texto}</span>
                </li>
              );
            })}
          </ul>

          <div class="relative lg:col-span-5 lg:col-start-8 lg:self-end">
            <a href={destacado.enlace} target="_blank" rel="noopener noreferrer" class="boton boton-secundario w-full sm:w-auto">
              Ver proyecto
              <span class="sr-only">{` de ${destacado.cliente} (se abre en una pestaña nueva)`}</span>
              <Icono nombre="arrow-up-right" tamano={18} />
            </a>
          </div>
        </article>
      );
    })()
  }

  {
    otros.length > 0 && (
      <ul role="list" class="carrusel mt-5 grid gap-5 md:grid-cols-2 lg:grid-cols-6">
        {otros.map((caso, i) => {
          const img = imagen(caso);
          const id = `${idBase}-${i + 1}`;
          return (
            <li data-revelar style={`--retraso:${Math.min(i, 4) * 80}ms`} class={claseCelda(i)}>
              <article
                aria-labelledby={id}
                class:list={['group flex h-full flex-col rounded-panel p-3 transition-colors duration-300 sm:p-4', capa, fondo === 'bajo' ? 'hover:bg-surface-highest' : 'hover:bg-surface-high']}
              >
                <div class:list={['relative aspect-[16/10] overflow-hidden rounded-card', claseCelda(i) === 'lg:col-span-3' && 'lg:aspect-[2/1]', hueco]}>
                  <picture>
                    {img.webp && <source srcset={img.webp} type="image/webp" />}
                    <img
                      src={caso.imagen}
                      alt={img.alt}
                      width={img.ancho}
                      height={img.alto}
                      loading="lazy"
                      decoding="async"
                      class:list={['captura absolute inset-0 h-full w-full object-contain', img.ajuste === 'contain' && 'p-6']}
                      style={`object-position:${img.posicion}`}
                    />
                  </picture>
                </div>
                <div class="flex flex-1 flex-col px-2 pt-5 pb-2 sm:px-3">
                  <p class="flex flex-wrap items-center gap-x-3 gap-y-2">
                    <span class="chip rotulo font-mono text-[0.6875rem] tracking-[0.12em] uppercase">{rotuloCaso(caso.cliente)}</span>
                    <span class="font-mono text-xs tracking-[0.15em] text-ink-soft uppercase">{caso.sector}</span>
                  </p>
                  <Titulo id={id} class="titulo-tarjeta mt-2">
                    {caso.cliente}
                  </Titulo>
                  <p class="mt-2 text-base leading-relaxed text-ink-soft">{caso.resumen}</p>
                  <ul role="list" aria-label={etiquetaLogros(caso)} class="mt-4 flex flex-wrap gap-2">
                    {caso.logros.map((logro) => (
                      <li class="rounded-full bg-primary/10 px-3 py-1.5 text-[0.8125rem] leading-snug text-primary">{logro}</li>
                    ))}
                  </ul>
                  <div class="mt-auto pt-4">
                    <a
                      href={caso.enlace}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="-ml-1 inline-flex min-h-11 items-center gap-1.5 rounded-lg px-1 text-sm font-semibold text-primary underline-offset-4 hover:underline"
                    >
                      Ver proyecto
                      <span class="sr-only">{` de ${caso.cliente} (se abre en una pestaña nueva)`}</span>
                      <Icono nombre="arrow-up-right" tamano={16} class="transition-transform duration-300 group-hover:translate-x-0.5 group-hover:-translate-y-0.5" />
                    </a>
                  </div>
                </div>
              </article>
            </li>
          );
        })}
      </ul>
    )
  }
</div>

<style>
  .rotulo {
    background: rgb(229 225 228 / 0.08);
    color: var(--color-ink-soft, #c9c5c8);
  }
  .resplandor {
    background: radial-gradient(circle, rgb(99 102 241 / 0.18), transparent 65%);
  }
  /* Celular: carrusel horizontal (una tarjeta y el borde de la siguiente a la vista). */
  @media (max-width: 767.98px) {
    .carrusel {
      display: flex;
      gap: 1rem;
      margin-inline: -1rem;
      padding: 0 1rem 0.75rem;
      overflow-x: auto;
      overscroll-behavior-x: contain;
      scroll-snap-type: x mandatory;
      scroll-padding-inline: 1rem;
      scrollbar-width: thin;
      scrollbar-color: rgb(192 193 255 / 0.22) transparent;
    }
    /* Las tarjetas fuera de la vista horizontal no esperan a «revelarse»: se ven al deslizar. */
    .carrusel > li {
      flex: 0 0 85%;
      scroll-snap-align: start;
      opacity: 1 !important;
      transform: none !important;
    }
  }
  .ventana {
    border-radius: 1rem;
    overflow: hidden;
    background: rgb(53 52 55 / 0.6);
    box-shadow: 0 20px 40px rgb(0 0 0 / 0.4);
  }
  @media (prefers-reduced-motion: no-preference) {
    .captura {
      transition: transform 0.6s cubic-bezier(0.16, 1, 0.3, 1);
    }
    .group:hover .captura {
      transform: scale(1.03);
    }
  }
</style>
