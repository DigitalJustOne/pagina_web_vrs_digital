---
/**
 * Icono SVG en línea (sin JS ni peticiones). Trazo de 1.75 y color heredado (currentColor).
 *
 * Decorativo por defecto (aria-hidden). Si el icono transmite información por sí solo,
 * pase `etiqueta` y se anuncia como imagen.
 *
 * <Icono nombre="search" />
 * <Icono nombre="shield" tamano={28} class="text-primary" />
 * <Icono nombre="alert" etiqueta="Atención" />
 */
import { ICONOS, type NombreIcono } from './iconos';

interface Props {
  nombre: NombreIcono;
  /** Lado en píxeles (por defecto 24). */
  tamano?: number;
  /** Grosor del trazo (por defecto 1.75, el de la marca). */
  trazo?: number;
  /** Texto alternativo. Si se omite, el icono es decorativo. */
  etiqueta?: string;
  class?: string;
}

const { nombre, tamano = 24, trazo = 1.75, etiqueta, class: clase } = Astro.props;
const contenido = ICONOS[nombre];
/** Los glifos de marca (WhatsApp) son rellenos; el resto, trazos. */
const relleno = nombre === 'whatsapp';
---
<svg
  xmlns="http://www.w3.org/2000/svg"
  width={tamano}
  height={tamano}
  viewBox="0 0 24 24"
  fill={relleno ? 'currentColor' : 'none'}
  stroke={relleno ? 'none' : 'currentColor'}
  stroke-width={relleno ? undefined : trazo}
  stroke-linecap="round"
  stroke-linejoin="round"
  class:list={['shrink-0', clase]}
  aria-hidden={etiqueta ? undefined : 'true'}
  role={etiqueta ? 'img' : undefined}
  aria-label={etiqueta}
  focusable="false"
  set:html={contenido}
/>
