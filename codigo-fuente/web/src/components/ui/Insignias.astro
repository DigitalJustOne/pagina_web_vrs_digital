---
/**
 * Señales de confianza: aval MinTIC, precios publicados y cupo limitado.
 * Datos desde AVAL (@/data/sitio).
 *
 * <Insignias />                    → fila de tres tarjetas de vidrio (debajo del hero o antes del cierre)
 * <Insignias variante="compacta" /> → píldoras en línea (junto a un formulario o en un pie de sección)
 */
import { AVAL } from '@/data/sitio';
import Icono from './Icono.astro';
import type { NombreIcono } from './iconos';

interface Props {
  variante?: 'fila' | 'compacta';
  class?: string;
}

const { variante = 'fila', class: clase } = Astro.props;

const INSIGNIAS: { icono: NombreIcono; titulo: string; texto: string; enlace?: { texto: string; href: string } }[] = [
  {
    icono: 'badge',
    titulo: AVAL.titulo,
    texto: AVAL.texto,
    enlace: { texto: 'Ver verificación en Cercia', href: AVAL.enlace },
  },
  {
    icono: 'calculator',
    titulo: 'Precios publicados',
    texto: 'Los precios y lo que incluye cada plan están publicados, con IVA incluido.',
  },
  {
    icono: 'target',
    titulo: 'Máximo 2 proyectos a la vez',
    texto: 'Trabajamos con pocos clientes al mismo tiempo para cuidar la calidad y los plazos.',
  },
];
---
{
  variante === 'compacta' ? (
    <ul role="list" aria-label="Por qué confiar en VRS Digital" class:list={['flex flex-wrap gap-2.5', clase]}>
      {INSIGNIAS.map((ins) => (
        <li class="vidrio inline-flex min-h-11 items-center gap-2 rounded-full py-2 pr-4 pl-2.5 text-sm font-medium text-ink">
          <span class="flex h-7 w-7 items-center justify-center rounded-full bg-primary/15 text-primary">
            <Icono nombre={ins.icono} tamano={16} />
          </span>
          {ins.enlace ? (
            <a href={ins.enlace.href} target="_blank" rel="noopener noreferrer" class="-my-2 inline-flex min-h-11 items-center underline-offset-4 hover:text-primary hover:underline">
              {ins.titulo}
              <span class="sr-only">: {ins.enlace.texto} (se abre en una pestaña nueva)</span>
            </a>
          ) : (
            ins.titulo
          )}
        </li>
      ))}
    </ul>
  ) : (
    <ul role="list" aria-label="Por qué confiar en VRS Digital" class:list={['grid gap-3 sm:grid-cols-3 sm:gap-4', clase]}>
      {INSIGNIAS.map((ins, i) => (
        <li
          data-revelar
          style={`--retraso:${i * 80}ms`}
          class:list={['insignia vidrio borde-fantasma relative flex gap-4 overflow-hidden rounded-card p-5', i === 0 && 'principal']}
        >
          <span class="relative flex h-11 w-11 shrink-0 items-center justify-center rounded-xl bg-surface-lowest text-primary">
            <Icono nombre={ins.icono} tamano={22} />
          </span>
          <div class="relative min-w-0">
            <p class="font-display text-base leading-snug font-semibold text-ink">{ins.titulo}</p>
            <p class="mt-1 text-sm leading-relaxed text-ink-soft">{ins.texto}</p>
            {ins.enlace && (
              <a
                href={ins.enlace.href}
                target="_blank"
                rel="noopener noreferrer"
                class="-ml-1 mt-1 inline-flex min-h-11 items-center gap-1 rounded-md px-1 text-sm font-semibold text-primary underline-offset-4 hover:underline"
              >
                {ins.enlace.texto}
                <span class="sr-only">{' (se abre en una pestaña nueva)'}</span>
                <Icono nombre="arrow-up-right" tamano={16} />
              </a>
            )}
          </div>
        </li>
      ))}
    </ul>
  )
}

<style>
  .principal::after {
    content: '';
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: radial-gradient(80% 100% at 0% 0%, rgb(128 131 255 / 0.14), transparent 60%);
  }
</style>
