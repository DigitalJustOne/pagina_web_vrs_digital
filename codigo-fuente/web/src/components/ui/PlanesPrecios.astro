---
/**
 * Planes y precios desde los datos maestros (PLANES, PLAN_ENTRADA de @/data/sitio).
 * No escriba precios a mano en las páginas: cambie sitio.ts y todo se actualiza.
 *
 * <PlanesPrecios />                 → versión completa (página /precios/): incluye y no incluye.
 * <PlanesPrecios compacto />        → tira de resumen para inicio, servicios y sectores: una fila por
 *                                     plan (nombre, para quién, precios con «IVA incluido») con enlace
 *                                     a su detalle en /precios/. Mide un tercio de la grilla completa.
 * <PlanesPrecios sinEmprendedor />  → oculta las opciones de entrada (Landing Page y Plan Emprendedor).
 *
 * Cada plan web muestra un precio anual y la misma cantidad en 12 cuotas mensuales (cuotaMensual: 20 % más). Debajo de los planes va siempre la franja «Dominio y hosting» (DOMINIO_HOSTING): qué trae cada oferta,
 * con las dos palabras explicadas.
 *
 * Regla de claridad (Víctor, 2026-10-18): cada tarjeta dice primero qué es (queEs) y luego responde
 * las mismas preguntas en el mismo orden (FichaOferta.astro, FILAS_FICHA de sitio.ts). La lista
 * completa de lo que incluye queda plegada en celular.
 * <PlanesPrecios fondo="bajo" />    → si la sección usa bg-surface-low.
 * <PlanesPrecios recomendado="visible" /> → marca ese plan como recomendado para el público de la página.
 *
 * Cada precio lleva «IVA incluido» al lado, y al pie va NOTA_PRECIOS con el alcance.
 *
 * Cada botón lleva a /contacto/?plan=<id>; el formulario preselecciona ese plan.
 * En la versión completa cada tarjeta tiene id="plan-<id>" para enlazar directo. En celular, sus
 * listas «incluye» y «no incluye» se pliegan (Plegable.astro): la tabla #comparar de /precios/
 * las repite punto por punto. En computador se ven abiertas.
 */
import { PLANES, PLAN_ENTRADA, LANDING, DOMINIO_HOSTING, NOTA_PRECIOS, CUOTAS, cuotaMensual, formatoCOP, CTA_PRINCIPAL, type IdPlan } from '@/data/sitio';
import Plegable from '@/components/pagina/Plegable.astro';
import FichaOferta from './FichaOferta.astro';
import Icono from './Icono.astro';

interface Props {
  compacto?: boolean;
  /** Superficie de la sección: 'base' (#131315) → tarjetas surface-low; 'bajo' (sección surface-low) → surface-high. */
  fondo?: 'base' | 'bajo';
  sinEmprendedor?: boolean;
  nivelTitulo?: 'h2' | 'h3';
  /** Plan recomendado para el público de la página (rótulo «Recomendado»). */
  recomendado?: IdPlan;
  class?: string;
}

const { compacto = false, fondo = 'base', sinEmprendedor = false, nivelTitulo = 'h3', recomendado, class: clase } = Astro.props;
const capa = fondo === 'bajo' ? 'bg-surface-high' : 'bg-surface-low';
const Titulo = nivelTitulo;
const rutaContacto = CTA_PRINCIPAL.href;
const minuscula = (t: string) => t.charAt(0).toLowerCase() + t.slice(1);
const cuota = (precioAnual: number) => cuotaMensual(precioAnual);
const totalCuotas = (precioAnual: number) => cuotaMensual(precioAnual) * CUOTAS.numero;
---
<div class:list={['planes', clase]}>
  {
    compacto && (
      <ul role="list" class="grid gap-4">
        {PLANES.map((plan, i) => (
          <li
            data-revelar
            style={`--retraso:${i * 90}ms`}
            class:list={[
              'tira relative grid gap-5 rounded-panel p-5 sm:p-7 lg:grid-cols-12 lg:items-center lg:gap-8',
              plan.destacado ? 'destacado borde-luz' : capa,
              plan.id === recomendado && !plan.destacado && 'es-recomendado',
            ]}
          >
            <div class="lg:col-span-5">
              <div class="flex flex-wrap items-center gap-x-3 gap-y-2">
                <Titulo class="font-display text-xl leading-tight font-semibold tracking-[-0.01em] text-ink sm:text-2xl">{plan.nombre}</Titulo>
                {plan.id === recomendado && (
                  <span class="chip recomendado font-mono text-[0.6875rem] tracking-[0.12em] uppercase">
                    <Icono nombre="target" tamano={14} />
                    Recomendado
                  </span>
                )}
                {plan.etiqueta && (
                  <span class="chip font-mono text-[0.6875rem] tracking-[0.12em] uppercase">
                    <Icono nombre="spark" tamano={14} />
                    {plan.etiqueta}
                  </span>
                )}
              </div>
              <p class="mt-2 text-[0.9375rem] leading-snug text-ink-soft">{plan.queEs}</p>
            </div>
            <dl class="grid grid-cols-2 gap-4 lg:col-span-4">
              <div>
                <dt class="text-sm text-ink-soft">Precio anual desde</dt>
                <dd class="mt-1 font-display text-[1.5rem] leading-none font-semibold tracking-[-0.02em] text-ink">
                  {formatoCOP(plan.precioAnualDesde)}
                </dd>
                <dd class="mt-1.5 text-xs text-ink-soft">IVA incluido</dd>
              </div>
              <div>
                <dt class="text-sm text-ink-soft">O en 12 cuotas de</dt>
                <dd class="mt-1 font-display text-[1.5rem] leading-none font-semibold tracking-[-0.02em] text-primary">
                  {formatoCOP(cuota(plan.precioAnualDesde))}
                </dd>
                <dd class="mt-1.5 text-xs text-ink-soft">al mes, IVA incluido (total {formatoCOP(totalCuotas(plan.precioAnualDesde))})</dd>
              </div>
            </dl>
            <div class="lg:col-span-3 lg:justify-self-end">
              <a
                href={`/precios/#plan-${plan.id}`}
                class:list={['boton w-full lg:w-auto', plan.destacado ? 'boton-primario' : 'boton-secundario']}
              >
                Ver qué incluye<span class="sr-only">{` el plan ${plan.nombre}`}</span>
                <Icono nombre="arrow-right" tamano={18} />
              </a>
            </div>
          </li>
        ))}
      </ul>
    )
  }
  {
    !compacto && (
  <ul role="list" class="grid gap-5 lg:grid-cols-3 lg:items-stretch lg:gap-6">
    {
      PLANES.map((plan, i) => {
        return (
          <li
            id={`plan-${plan.id}`}
            data-revelar
            style={`--retraso:${i * 90}ms`}
            class:list={[
              'plan relative flex flex-col rounded-panel p-6 sm:p-8',
              plan.destacado ? 'destacado borde-luz' : capa,
              plan.id === recomendado && !plan.destacado && 'es-recomendado',
            ]}
          >
            {plan.destacado && <span aria-hidden="true" class="aura pointer-events-none absolute -inset-x-3 -inset-y-6 -z-10 rounded-[2.5rem] sm:-inset-6" />}

            {(plan.etiqueta || plan.id === recomendado) && (
            <div class="mb-4 flex flex-wrap items-center gap-3">
                <p class="flex flex-wrap gap-2">
                  {plan.id === recomendado && (
                    <span class="chip recomendado font-mono text-[0.6875rem] tracking-[0.12em] uppercase">
                      <Icono nombre="target" tamano={14} />
                      Recomendado
                    </span>
                  )}
                  {plan.etiqueta && (
                    <span class="chip font-mono text-[0.6875rem] tracking-[0.12em] uppercase">
                      <Icono nombre="spark" tamano={14} />
                      {plan.etiqueta}
                    </span>
                  )}
                </p>
            </div>
            )}

            <Titulo class="font-display text-2xl leading-tight font-semibold tracking-[-0.02em] text-ink sm:text-[1.75rem]">
              {plan.nombre}
            </Titulo>
            <p class="mt-3 text-base leading-relaxed text-ink-soft">{plan.queEs}</p>

            <dl class="precio mt-6 grid gap-4 rounded-card bg-surface-lowest p-5">
              <div>
                <dt class="text-sm text-ink-soft">Precio anual desde</dt>
                <dd class="mt-1 font-display text-[2rem] leading-none font-semibold tracking-[-0.03em] text-ink sm:text-[2.25rem]">
                  {formatoCOP(plan.precioAnualDesde)}
                </dd>
                <dd class="mt-2 text-xs text-ink-soft">IVA incluido, pago de una vez</dd>
              </div>
              <div class="border-t border-surface-highest pt-4">
                <dt class="text-sm text-ink-soft">O en 12 cuotas mensuales de</dt>
                <dd class="mt-1 font-display text-xl font-semibold tracking-[-0.02em] text-primary">
                  {formatoCOP(cuota(plan.precioAnualDesde))}
                  {' '}<span class="font-sans text-sm font-normal text-ink-soft">al mes</span>
                </dd>
                <dd class="mt-1.5 text-xs text-ink-soft">IVA incluido. Total en cuotas: {formatoCOP(totalCuotas(plan.precioAnualDesde))}</dd>
              </div>
            </dl>

            <FichaOferta ficha={plan.ficha} class="mt-6" />

            <a
              href={`${rutaContacto}?plan=${plan.id}`}
              class:list={['boton mt-6 w-full', plan.destacado ? 'boton-primario' : 'boton-secundario']}
            >
              Solicitar este plan<span class="sr-only">: {plan.nombre}</span>
              <Icono nombre="arrow-right" tamano={18} />
            </a>

            <div class="mt-6 flex-1 lg:mt-8">
              <Plegable texto="Ver todo lo que incluye">
              <p class="text-sm font-semibold text-ink">{plan.incluyeAnterior ?? 'Incluye:'}</p>
              <ul role="list" class="mt-3 grid gap-2.5">
                {plan.incluye.map((punto) => (
                  <li class="flex items-start gap-3 text-[0.9375rem] leading-snug text-ink-soft">
                    <Icono nombre="tick" tamano={18} class="mt-px text-primary" />
                    <span>{punto}</span>
                  </li>
                ))}
              </ul>

              {plan.noIncluye.length > 0 && (
                <div class="mt-6">
                  <p class="text-sm font-semibold text-ink">No incluye:</p>
                  <ul role="list" class="mt-3 grid gap-2.5">
                    {plan.noIncluye.map((punto) => (
                      <li class="flex items-start gap-3 text-[0.9375rem] leading-snug text-ink-mute">
                        <Icono nombre="minus" tamano={18} class="mt-px" />
                        <span>{punto}</span>
                      </li>
                    ))}
                  </ul>
                </div>
              )}
              </Plegable>
            </div>
          </li>
        );
      })
    }
  </ul>
    )
  }

  {
    !sinEmprendedor && compacto && (
      <div class="mt-4 grid gap-4 md:grid-cols-2">
        <div data-revelar class:list={['flex flex-wrap items-center justify-between gap-x-6 gap-y-3 rounded-panel px-5 py-4 sm:px-7', capa]}>
          <p class="text-[0.9375rem] leading-snug text-ink-soft">
            <span class="font-display font-semibold text-ink">{LANDING.nombre}</span>
            {' · '}pago único:{' '}
            <span class="font-semibold text-ink">{formatoCOP(LANDING.precio)}</span>, IVA incluido.
          </p>
          <a href="/precios/#plan-landing" class="inline-flex min-h-12 items-center gap-1.5 text-sm font-semibold text-primary underline-offset-4 hover:underline">
            Ver qué incluye<span class="sr-only">{` la ${LANDING.nombre}`}</span>
            <Icono nombre="arrow-right" tamano={16} />
          </a>
        </div>
        <div data-revelar class:list={['flex flex-wrap items-center justify-between gap-x-6 gap-y-3 rounded-panel px-5 py-4 sm:px-7', capa]}>
          <p class="text-[0.9375rem] leading-snug text-ink-soft">
            <span class="font-display font-semibold text-ink">{PLAN_ENTRADA.nombre}</span>
            {' · '}una página sencilla, pago fijo:{' '}
            <span class="font-semibold text-ink">{formatoCOP(PLAN_ENTRADA.mensualidad)} al mes</span>, IVA incluido.
          </p>
          <a href="/precios/#plan-emprendedor" class="inline-flex min-h-12 items-center gap-1.5 text-sm font-semibold text-primary underline-offset-4 hover:underline">
            Ver qué incluye<span class="sr-only">{` el ${PLAN_ENTRADA.nombre}`}</span>
            <Icono nombre="arrow-right" tamano={16} />
          </a>
        </div>
      </div>
    )
  }

  {
    !sinEmprendedor && !compacto && (
      <ul role="list" class="mt-6 grid gap-5 lg:grid-cols-2 lg:gap-6">
        <li id="plan-landing" data-revelar class:list={['entrada flex flex-col rounded-panel p-6 sm:p-8', capa]}>
          <Titulo class="font-display text-xl font-semibold tracking-[-0.01em] text-ink sm:text-2xl">{LANDING.nombre}</Titulo>
          <p class="mt-2 text-base leading-relaxed text-ink-soft">{LANDING.queEs}</p>
          <dl class="mt-5 grid gap-3 rounded-card bg-surface-lowest p-5">
            <div>
              <dt class="text-sm text-ink-soft">Pago único</dt>
              <dd class="mt-1 font-display text-[1.75rem] leading-none font-semibold tracking-[-0.02em] text-ink">{formatoCOP(LANDING.precio)}</dd>
              <dd class="mt-1.5 text-xs text-ink-soft">IVA incluido</dd>
            </div>
            <div class="flex flex-wrap items-baseline justify-between gap-x-3 gap-y-1">
              <dt class="text-sm text-ink-soft">Lista para publicar, con dominio y hosting del primer año</dt>
              <dd class="font-display text-xl font-semibold tracking-[-0.02em] text-primary">{formatoCOP(LANDING.precioConDominio)}</dd>
            </div>
          </dl>
          <FichaOferta ficha={LANDING.ficha} class="mt-5" />
          <div class="mt-5 flex-1">
            <Plegable texto="Ver todo lo que incluye">
              <ul role="list" class="grid gap-2.5">
                {LANDING.incluye.map((punto) => (
                  <li class="flex items-start gap-3 text-[0.9375rem] leading-snug text-ink-soft">
                    <Icono nombre="tick" tamano={18} class="mt-px text-primary" />
                    <span>{punto}</span>
                  </li>
                ))}
              </ul>
              <p class="mt-4 text-sm leading-snug text-ink-mute">No incluye: {LANDING.noIncluye.map(minuscula).join(', ').replace(/, ([^,]*)$/, ' ni $1')}.</p>
            </Plegable>
          </div>
          <a href={`${rutaContacto}?plan=landing`} class="boton boton-secundario mt-6 w-full">
            Solicitar la {LANDING.nombre}
            <Icono nombre="arrow-right" tamano={18} />
          </a>
        </li>
        <li id="plan-emprendedor" data-revelar class:list={['entrada flex flex-col rounded-panel p-6 sm:p-8', capa]}>
          <Titulo class="font-display text-xl font-semibold tracking-[-0.01em] text-ink sm:text-2xl">{PLAN_ENTRADA.nombre}</Titulo>
          <p class="mt-2 text-base leading-relaxed text-ink-soft">{PLAN_ENTRADA.queEs}</p>
          <dl class="mt-5 grid gap-3 rounded-card bg-surface-lowest p-5">
            <div>
              <dt class="text-sm text-ink-soft">Mensualidad</dt>
              <dd class="mt-1 font-display text-[1.75rem] leading-none font-semibold tracking-[-0.02em] text-ink">
                {formatoCOP(PLAN_ENTRADA.mensualidad)}
                {' '}<span class="font-sans text-sm font-normal text-ink-soft">al mes</span>
              </dd>
              <dd class="mt-1.5 text-xs text-ink-soft">IVA incluido</dd>
            </div>
          </dl>
          <FichaOferta ficha={PLAN_ENTRADA.ficha} class="mt-5" />
          <div class="mt-5 flex-1">
            <Plegable texto="Ver todo lo que incluye">
              <ul role="list" class="grid gap-2.5">
                {PLAN_ENTRADA.incluye.map((punto) => (
                  <li class="flex items-start gap-3 text-[0.9375rem] leading-snug text-ink-soft">
                    <Icono nombre="tick" tamano={18} class="mt-px text-primary" />
                    <span>{punto}</span>
                  </li>
                ))}
              </ul>
              <p class="mt-4 text-sm leading-snug text-ink-mute">No incluye: {PLAN_ENTRADA.noIncluye.map(minuscula).join(', ').replace(/, ([^,]*)$/, ' ni $1')}.</p>
            </Plegable>
          </div>
          <a href={`${rutaContacto}?plan=emprendedor`} class="boton boton-secundario mt-6 w-full">
            Solicitar el {PLAN_ENTRADA.nombre}
            <Icono nombre="arrow-right" tamano={18} />
          </a>
        </li>
      </ul>
    )
  }

  <div data-revelar class="dominio mt-6 grid gap-4 rounded-panel p-5 sm:p-7 lg:grid-cols-12 lg:items-center lg:gap-8">
    <div class="flex items-start gap-3 lg:col-span-7">
      <Icono nombre="spark" tamano={22} class="mt-0.5 shrink-0 text-primary" />
      <div>
        <p class="font-display text-lg font-semibold text-ink sm:text-xl">
          Dominio y hosting incluidos el primer año en los planes web
        </p>
        <p class="mt-1.5 text-[0.9375rem] leading-snug text-ink-soft">{DOMINIO_HOSTING.aparte}</p>
      </div>
    </div>
    {!compacto && (
      <ul role="list" class="grid gap-2 lg:col-span-5">
        {DOMINIO_HOSTING.incluye.map((punto) => (
          <li class="flex items-start gap-2.5 text-sm leading-snug text-ink-soft">
            <Icono nombre="tick" tamano={16} class="mt-px text-primary" />
            <span>{punto}</span>
          </li>
        ))}
      </ul>
    )}
  </div>

  <p class="mt-6 flex items-start gap-2.5 text-sm leading-relaxed text-ink-soft">
    <Icono nombre="info" tamano={18} class="mt-px text-primary" />
    <span>{NOTA_PRECIOS} «Desde» es el precio más bajo: sube si necesita más páginas, otro idioma o pasar el contenido de una web anterior. Antes de pagar, usted recibe el valor exacto por escrito.</span>
  </p>
</div>

<style>
  .destacado {
    background:
      radial-gradient(120% 60% at 100% 0%, rgb(128 131 255 / 0.16), transparent 60%),
      var(--color-surface-high, #2a2a2c);
    box-shadow: 0 30px 60px -20px rgb(0 0 0 / 0.6);
  }
  .destacado .precio {
    background: rgb(14 14 16 / 0.75);
  }
  .es-recomendado {
    box-shadow: inset 0 0 0 1px rgb(192 193 255 / 0.35), 0 24px 48px -24px rgb(128 131 255 / 0.45);
  }
  .recomendado {
    background: rgb(229 225 228 / 0.1);
    color: var(--color-ink, #e5e1e4);
  }
  .dominio {
    background:
      radial-gradient(80% 120% at 0% 0%, rgb(128 131 255 / 0.14), transparent 60%),
      var(--color-surface-low, #1c1b1d);
    box-shadow: inset 0 0 0 1px rgb(192 193 255 / 0.18);
  }
  .aura {
    background: radial-gradient(60% 50% at 50% 40%, rgb(99 102 241 / 0.22), transparent 70%);
    filter: blur(20px);
  }
  @media (min-width: 1024px) {
    .destacado {
      translate: 0 -0.75rem;
    }
  }
</style>
