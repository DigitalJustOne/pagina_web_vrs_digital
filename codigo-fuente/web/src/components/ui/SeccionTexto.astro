---
/**
 * Contenedor de texto largo con estilos .prosa (párrafos, listas, tablas, citas).
 * Úselo para políticas, artículos y bloques explicativos. No agrega encabezados.
 *
 * <SeccionTexto>
 *   <h2>¿Qué incluye?</h2>
 *   <p>…</p>
 *   <ul><li>…</li></ul>
 * </SeccionTexto>
 *
 * Con contenido de colecciones: <SeccionTexto><Content /></SeccionTexto>
 * Tablas anchas: envuélvalas en <div class="tabla"> para que se desplacen en celular
 * sin perder la semántica de tabla.
 */
interface Props {
  /** 'normal' ≈ 70 caracteres por línea (lectura); 'amplio' para tablas o comparativos. */
  ancho?: 'normal' | 'amplio';
  /** Etiqueta HTML del contenedor. */
  como?: 'div' | 'article' | 'section';
  class?: string;
}

const { ancho = 'normal', como = 'div', class: clase } = Astro.props;
const Elemento = como;
---
<Elemento class:list={['prosa seccion-texto', ancho === 'normal' ? 'max-w-[44rem]' : 'max-w-[64rem]', clase]}>
  <slot />
</Elemento>

<style>
  .seccion-texto > :global(:first-child) {
    margin-top: 0;
  }
  .seccion-texto :global(ul > li::marker) {
    color: var(--color-primary, #c0c1ff);
  }
  .seccion-texto :global(ol > li::marker) {
    color: var(--color-primary, #c0c1ff);
    font-family: var(--font-mono, ui-monospace, monospace);
    font-size: 0.875em;
  }
  .seccion-texto :global(a:hover) {
    text-decoration-thickness: 2px;
  }
  .seccion-texto :global(blockquote) {
    margin-block: 1.75rem;
    padding: 1.25rem 1.5rem;
    border-radius: 1rem;
    background: var(--color-surface-low, #1c1b1e);
    color: var(--color-ink, #e5e1e4);
    box-shadow: inset 3px 0 0 var(--color-primary-container, #8083ff);
  }
  .seccion-texto :global(code) {
    font-family: var(--font-mono, ui-monospace, monospace);
    font-size: 0.875em;
    padding: 0.125rem 0.375rem;
    border-radius: 0.375rem;
    background: var(--color-surface-high, #2a2a2c);
    color: var(--color-ink, #e5e1e4);
  }
  .seccion-texto :global(hr) {
    margin-block: 2.5rem;
    height: 0.5rem;
    border: 0;
    background: radial-gradient(circle, rgb(192 193 255 / 0.35) 1.5px, transparent 2px) center / 1.25rem 0.5rem repeat-x;
  }
  /* Tabla con desplazamiento horizontal en celular, sin perder la semántica (display: table). */
  .seccion-texto :global(.tabla) {
    overflow-x: auto;
    margin-block: 1.5rem;
    border-radius: 1rem;
  }
  .seccion-texto :global(.tabla table) {
    display: table;
    margin: 0;
    min-width: 32rem;
  }
  .seccion-texto :global(th:first-child),
  .seccion-texto :global(td:first-child) {
    padding-left: 1rem;
  }
  .seccion-texto :global(img) {
    border-radius: 1rem;
    height: auto;
  }
</style>
