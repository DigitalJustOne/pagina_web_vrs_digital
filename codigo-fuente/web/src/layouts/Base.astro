---
import '@/styles/global.css';
import Seo from '@/components/Seo.astro';
import Encabezado from '@/components/Encabezado.astro';
import PiePagina from '@/components/PiePagina.astro';
import BarraMovil from '@/components/BarraMovil.astro';
// Precarga de las dos fuentes de la primera pantalla (titulares e interfaz, subconjunto
// latino: cubre tildes, ñ, ¿ y ¡). Son los mismos archivos que pide global.css, así que no
// se descargan dos veces. Con font-display: optional (global.css), la precarga hace que lleguen
// a tiempo para el primer pintado; si no llegan, se usa el respaldo sin cambiar de fuente (sin CLS).
import fuenteTitulos from '@fontsource-variable/space-grotesk/files/space-grotesk-latin-wght-normal.woff2?url';
import fuenteTexto from '@fontsource-variable/inter/files/inter-latin-wght-normal.woff2?url';

interface Props {
  titulo: string;
  descripcion: string;
  ruta: string;
  imagen?: string;
  tipo?: 'website' | 'article';
  noIndexar?: boolean;
  jsonld?: object;
  /** Guías: fechas AAAA-MM-DD para article:published_time y article:modified_time. */
  publicado?: string;
  modificado?: string;
  /** true si la página termina con BandaCta: el pie no repite los botones ni el lema grande. */
  pieCompacto?: boolean;
}
const { pieCompacto = false, ...props } = Astro.props;
---
<!doctype html>
<html lang="es-CO">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#131315" />
    <meta name="color-scheme" content="dark" />
    <meta name="format-detection" content="telephone=no" />
    <link rel="preload" href={fuenteTitulos} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={fuenteTexto} as="font" type="font/woff2" crossorigin />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" type="image/png" sizes="32x32" href="/icono-32.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <meta name="apple-mobile-web-app-title" content="VRS Digital" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <!-- «Pausar animaciones» guardado (src/scripts/pausa.ts): se aplica antes de pintar. -->
    <script is:inline>document.documentElement.classList.add('js');try{if(localStorage.getItem('vrs-sin-movimiento')==='1')document.documentElement.setAttribute('data-sin-movimiento','')}catch(e){}</script>
    <Seo {...props} />
    <slot name="head" />
  </head>
  <body class="min-h-dvh bg-surface text-ink antialiased">
    <a href="#contenido" class="sr-only focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus:z-[999] focus:rounded-lg focus:bg-surface-highest focus:px-4 focus:py-3">Saltar al contenido</a>
    <Encabezado ruta={props.ruta} />
    <main id="contenido" tabindex="-1" class="outline-none">
      <slot />
    </main>
    <PiePagina compacto={pieCompacto} />
    <BarraMovil />
    <script>
      import '@/scripts/movimiento';
      import '@/scripts/pausa';
      import '@/scripts/anclas';
    </script>
  </body>
</html>
