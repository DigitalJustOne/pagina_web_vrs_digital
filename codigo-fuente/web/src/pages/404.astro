---
// Página de error 404. Hostinger la sirve para cualquier dirección inexistente
// (ErrorDocument 404 /404.html en public/.htaccess), a cualquier profundidad:
// por eso todos los enlaces son absolutos. No se indexa.
import Base from '@/layouts/Base.astro';
import Icono from '@/components/ui/Icono.astro';
import EncabezadoSeccion from '@/components/ui/EncabezadoSeccion.astro';
import type { NombreIcono } from '@/components/ui/iconos';
import { CONTACTO, CTA_PRINCIPAL, SECTORES, SERVICIOS, enlaceWhatsApp } from '@/data/sitio';

const servicio = (slug: string) => SERVICIOS.find((s) => s.slug === slug)!;

const destinos: { nombre: string; texto: string; href: string; icono: NombreIcono }[] = [
  { nombre: servicio('paginas-web-bogota').nombre, texto: servicio('paginas-web-bogota').resumen, href: '/paginas-web-bogota/', icono: 'monitor' },
  {
    nombre: servicio('posicionamiento-google-inteligencia-artificial').nombre,
    texto: servicio('posicionamiento-google-inteligencia-artificial').resumen,
    href: '/posicionamiento-google-inteligencia-artificial/',
    icono: 'search',
  },
  { nombre: servicio('asistente-whatsapp-business').nombre, texto: servicio('asistente-whatsapp-business').resumen, href: '/asistente-whatsapp-business/', icono: 'message' },
  { nombre: 'Planes y precios', texto: 'Qué incluye cada plan, cuánto cuesta y cómo se paga.', href: '/precios/', icono: 'calculator' },
  { nombre: 'Proyectos', texto: 'Trabajos reales entregados, con enlace público para revisarlos.', href: '/proyectos/', icono: 'briefcase' },
  { nombre: 'Recursos', texto: 'Guías prácticas sobre su web, Google y la atención por WhatsApp.', href: '/recursos/', icono: 'file' },
  { nombre: 'Nosotros', texto: 'Quién hace el trabajo y cómo lo hacemos, paso a paso.', href: '/nosotros/', icono: 'users' },
  { nombre: 'Contacto', texto: 'Solicite una revisión digital de su empresa sin compromiso.', href: CTA_PRINCIPAL.href, icono: 'mail' },
];

const mensajeWhatsApp = 'Hola, llegué a una página de su web que no existe. Estoy buscando información sobre';
---
<Base
  titulo="Página no encontrada"
  descripcion="La dirección que buscó no existe o cambió. Vuelva al inicio, revise nuestros servicios y precios o escríbanos por WhatsApp."
  ruta="/404.html"
  noIndexar
  pieCompacto
>
  <section aria-labelledby="titulo-404" class="error-404 relative isolate overflow-hidden">
    <span aria-hidden="true" class="luz-404 luz-404-a pointer-events-none absolute -z-10"></span>
    <span aria-hidden="true" class="luz-404 luz-404-b pointer-events-none absolute -z-10"></span>
    <span aria-hidden="true" class="reticula-404 pointer-events-none absolute inset-0 -z-10"></span>

    <div class="contenedor grid gap-12 pt-28 pb-20 sm:pt-32 lg:grid-cols-12 lg:items-center lg:gap-10 lg:pt-40 lg:pb-28">
      <div class="lg:col-span-7">
        <h1 id="titulo-404" class="titulo-pagina mt-4">
          Esta página no existe <span class="degradado-texto">o cambió de dirección</span>
        </h1>
        <p class="texto-guia mt-6">
          Puede que el enlace esté incompleto o que la página se haya movido cuando renovamos el sitio.
          Elija un destino de la lista o escríbanos y le ayudamos a encontrar lo que busca.
        </p>
        <div class="mt-9 flex flex-col gap-3 sm:flex-row sm:flex-wrap">
          <a href="/" class="boton boton-primario">
            <Icono nombre="home" tamano={18} />
            Volver al inicio
          </a>
          <a href={enlaceWhatsApp(mensajeWhatsApp)} target="_blank" rel="noopener noreferrer" class="boton boton-secundario">
            <Icono nombre="whatsapp" tamano={20} class="icono-whatsapp" />
            Escribir por WhatsApp
            <span class="sr-only">{' (se abre en una pestaña nueva)'}</span>
          </a>
        </div>
        <p class="mt-5 flex items-start gap-2 text-sm leading-relaxed text-ink-soft">
          <Icono nombre="clock" tamano={16} class="mt-0.5 text-primary" />
          {CONTACTO.horario}. {CONTACTO.respuestaHumana}
        </p>
      </div>

      <!-- Lectura tipo instrumento: decorativa salvo la ruta, que también se anuncia. En celular se
           omite: repite el título y empuja los destinos hacia abajo. -->
      <div class="hidden sm:block lg:col-span-5">
        <div class="lectura vidrio borde-luz relative rounded-panel p-6 sm:p-8">
          <p aria-hidden="true" class="cifra font-display font-semibold select-none">404</p>
          <dl class="mt-6 grid gap-3 font-mono text-[0.8125rem] leading-snug">
            <div class="fila">
              <dt class="text-ink-mute">Estado</dt>
              <dd class="flex items-center gap-2 text-ink"><span aria-hidden="true" class="punto"></span>Página no encontrada</dd>
            </div>
            <div class="fila">
              <dt class="text-ink-mute">Dirección</dt>
              <dd class="min-w-0 break-all text-primary" data-ruta-404>Esta dirección</dd>
            </div>
            <div class="fila">
              <dt class="text-ink-mute">Siguiente paso</dt>
              <dd class="text-ink">Elegir un destino abajo</dd>
            </div>
          </dl>
        </div>
      </div>
    </div>
  </section>

  <section aria-labelledby="titulo-destinos" class="seccion bg-surface-low">
    <div class="contenedor">
      <EncabezadoSeccion etiqueta="Destinos principales" titulo="Probablemente buscaba una de estas páginas" id="titulo-destinos" revelar={false} />
      <!-- En celular, cada destino es una fila compacta (ícono, nombre y flecha) sin la descripción. -->
      <ul class="tras-encabezado grid gap-3 sm:grid-cols-2 lg:grid-cols-4" role="list">
        {
          destinos.map((d) => (
            <li class="flex">
              <a
                href={d.href}
                class="destino group grid w-full grid-cols-[auto_1fr_auto] items-center gap-4 rounded-card bg-surface-high p-4 sm:flex sm:flex-col sm:items-stretch sm:gap-0 sm:p-6"
              >
                <span class="contents sm:flex sm:items-center sm:justify-between sm:gap-4">
                  <span class="grid size-11 place-items-center rounded-xl bg-surface-lowest text-primary">
                    <Icono nombre={d.icono} tamano={22} />
                  </span>
                  <Icono nombre="arrow-right" tamano={18} class="flecha order-3 text-ink-mute sm:order-none" />
                </span>
                <span class="order-2 font-display text-lg leading-snug font-semibold text-ink sm:order-none sm:mt-5">{d.nombre}</span>
                <span class="mt-2 hidden text-[0.9375rem] leading-relaxed text-ink-soft sm:block">{d.texto}</span>
              </a>
            </li>
          ))
        }
      </ul>

      <nav aria-label="Páginas por sector" class="mt-10 flex flex-col gap-3 sm:flex-row sm:flex-wrap sm:items-center">
        <span class="text-sm text-ink-soft">Páginas web por sector:</span>
        <ul class="flex flex-wrap gap-2" role="list">
          {
            SECTORES.map((s) => (
              <li>
                <a href={`/${s.slug}/`} class="chip-sector inline-flex min-h-11 items-center rounded-full px-4 text-sm font-medium text-primary">
                  {s.nombre}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
    </div>
  </section>
</Base>

<script is:inline>
  // Muestra la dirección que la persona intentó abrir (solo texto, sin HTML).
  (function () {
    var el = document.querySelector('[data-ruta-404]');
    if (!el || location.pathname === '/404.html') return;
    try { el.textContent = decodeURI(location.pathname); } catch (e) { el.textContent = location.pathname; }
  })();
</script>

<style>
  .luz-404 {
    border-radius: 9999px;
    filter: blur(80px);
  }
  .luz-404-a {
    width: 34rem;
    height: 34rem;
    right: -10rem;
    top: -8rem;
    background: rgb(99 102 241 / 0.28);
  }
  .luz-404-b {
    width: 26rem;
    height: 26rem;
    left: -12rem;
    bottom: -16rem;
    background: rgb(192 193 255 / 0.12);
  }
  .reticula-404 {
    background-image:
      linear-gradient(rgb(229 225 228 / 0.035) 1px, transparent 1px),
      linear-gradient(90deg, rgb(229 225 228 / 0.035) 1px, transparent 1px);
    background-size: 56px 56px;
    mask-image: radial-gradient(70% 60% at 70% 30%, #000 0%, transparent 75%);
  }

  .lectura {
    border-radius: var(--radius-panel);
    box-shadow: 0 20px 40px rgb(0 0 0 / 0.4);
  }
  .cifra {
    font-size: clamp(5.5rem, 3rem + 14vw, 10rem);
    line-height: 0.85;
    letter-spacing: -0.06em;
    background: linear-gradient(135deg, #e5e1e4 0%, #c0c1ff 40%, #6366f1 100%);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    filter: drop-shadow(0 0 32px rgb(128 131 255 / 0.35));
  }
  .fila {
    display: grid;
    grid-template-columns: 8.5rem minmax(0, 1fr);
    gap: 1rem;
    align-items: baseline;
    padding: 0.75rem 1rem;
    border-radius: 0.75rem;
    background: rgb(14 14 16 / 0.55);
  }
  @media (max-width: 380px) {
    .fila { grid-template-columns: 1fr; gap: 0.25rem; }
  }
  .punto {
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 9999px;
    background: #fbbf24;
    box-shadow: 0 0 10px rgb(251 191 36 / 0.7);
  }


  .destino {
    transition: background-color 0.25s, transform 0.3s var(--ease-out-expo);
  }
  .destino:hover { background: var(--color-surface-highest); }
  .destino:hover .flecha { color: var(--color-primary); }
  @media (prefers-reduced-motion: no-preference) {
    .destino:hover { transform: translateY(-2px); }
    .flecha { transition: transform 0.3s var(--ease-out-expo), color 0.25s; }
    .destino:hover .flecha { transform: translateX(3px); }
  }
  .chip-sector { background: rgb(128 131 255 / 0.12); transition: background-color 0.2s; }
  .chip-sector:hover { background: rgb(128 131 255 / 0.22); }
</style>
