---
// /asistente-whatsapp-business/ — configuración del agente de IA que Meta ofrece en WhatsApp Business.
// Todo el texto sale de src/data/contenido/asistente-whatsapp-business.ts y los precios de sitio.ts.
// La plantilla arma SEO, JSON-LD (página, migas, FAQ y servicio), secciones, preguntas y cierre.
// Momentos propios de la página:
//   - Portada: teléfono dentro de un anillo de 24 horas (el agente puede responder a cualquier
//     hora; una persona continúa en su horario), con las horas de la conversación de ejemplo.
//   - #pruebas: banco de pruebas (una celda por pregunta y una tarjeta por grupo), con los
//     criterios de aprobación al pie.
// JSON-LD: el módulo no da precioDesde al servicio (el precio publicado es del plan completo), así
// que la oferta se publica aparte: el plan Web + Atención Inteligente, que incluye la configuración.
import PlantillaPagina from '@/components/pagina/PlantillaPagina.astro';
import BancoPruebas from '@/components/paginas/servicios/BancoPruebas.astro';
import RelojAtencion from '@/components/paginas/servicios/RelojAtencion.astro';
import { contenido } from '@/data/contenido/asistente-whatsapp-business';
import type { SeccionTabla } from '@/data/contenido/tipos';
import { PLANES, cuotaMensual } from '@/data/sitio';
import { especificacionPrecio, urlAbsoluta } from '@/lib/schema';

const indice = contenido.secciones.findIndex((s) => s.id === 'pruebas');
const pruebas = contenido.secciones[indice] as SeccionTabla;

const atencion = PLANES.find((p) => p.id === 'atencion')!;
const oferta = {
  '@type': 'Offer',
  '@id': urlAbsoluta(contenido.ruta) + '#oferta',
  name: atencion.nombre,
  description: atencion.paraQuien,
  url: urlAbsoluta('/precios/#plan-atencion'),
  itemOffered: { '@id': urlAbsoluta(contenido.ruta) + '#servicio' },
  seller: { '@id': urlAbsoluta('/#organizacion') },
  areaServed: { '@type': 'Country', name: 'Colombia' },
  priceCurrency: 'COP',
  // Precios «desde», con IVA incluido (NOTA_PRECIOS en sitio.ts).
  priceSpecification: [
    especificacionPrecio('Precio anual', atencion.precioAnualDesde),
    especificacionPrecio('Cuota en 12 cuotas', cuotaMensual(atencion.precioAnualDesde), { mensual: true }),
  ],
};
---
<PlantillaPagina
  contenido={contenido}
  resaltado="agente de IA de WhatsApp Business"
  jsonldExtra={[oferta]}
  opciones={{
    'que-es': { iluminar: true },
    ejemplo: { resaltado: 'una conversación' },
    'que-puede-hacer': { resaltado: 'según Meta', plegar: 'Ver qué puede hacer' },
    controles: { resaltado: 'usted controla', plegar: 'Ver los controles' },
    alcance: { resaltado: 'y qué no' },
    informacion: { plegar: 'Ver la información que pedimos' },
    'depende-de-meta': { resaltado: 'no de nosotros', plegar: 'Ver lo que depende de Meta' },
    privacidad: { resaltado: 'sus clientes', plegar: 'Ver qué pasa con los datos' },
    'sin-acceso': { resaltado: 'todavía no', plegar: 'Ver qué hacemos en ese caso' },
  }}
>
  <RelojAtencion slot="visual" />
  <BancoPruebas
    slot="seccion-pruebas"
    seccion={pruebas}
    fondo={indice % 2 === 0 ? 'base' : 'bajo'}
    numero={indice + 1}
    resaltado="antes de activarlo"
    plegar="Ver qué comprobamos en cada grupo"
  />
</PlantillaPagina>
