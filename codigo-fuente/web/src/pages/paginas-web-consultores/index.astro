---
// /paginas-web-consultores/ — página de sector para consultores, capacitadores y asesores SST.
// Todo el texto sale de src/data/contenido/paginas-web-consultores.ts y los precios de sitio.ts.
// La plantilla arma SEO, JSON-LD (página, migas, FAQ y servicio), secciones, preguntas y cierre.
// Momentos propios de la página:
//   - Portada: la web de un consultor con su método en cuatro pasos y, delante en 3D, la
//     solicitud de propuesta que llega ordenada (sector, tamaño, necesidad y fecha).
//   - #estructura: la estructura recomendada dibujada como el mapa del sitio.
// Plan recomendado (Web Visible): lo marca el módulo en la sección «precio».
import PlantillaPagina from '@/components/pagina/PlantillaPagina.astro';
import MapaSitio from '@/components/paginas/sectores/MapaSitio.astro';
import MetodoConsultor from '@/components/paginas/sectores/MetodoConsultor.astro';
import Insignias from '@/components/ui/Insignias.astro';
import { contenido } from '@/data/contenido/paginas-web-consultores';
import type { FondoSeccion, SeccionLista } from '@/data/contenido/tipos';

const i = contenido.secciones.findIndex((s) => s.id === 'estructura');
const estructura = contenido.secciones[i] as SeccionLista;
const fondoEstructura: FondoSeccion = i % 2 === 0 ? 'base' : 'bajo';
---
<PlantillaPagina
  contenido={contenido}
  resaltado="consultores, capacitadores y asesores SST"
  opciones={{
    'que-necesita-ver': { resaltado: 'antes de pedirle una propuesta' },
    capacitadores: { resaltado: 'qué entrega su curso', iluminar: true, plegar: 'Ver qué debe decir su web' },
    sst: { resaltado: 'seguridad y salud en el trabajo', plegar: 'Ver qué debe mostrar su web' },
    whatsapp: { resaltado: 'ordenar solicitudes' },
    demostracion: { resaltado: 'atención por WhatsApp' },
    casos: { resaltado: 'confidencialidad', iluminar: true, plegar: 'Ver cómo hacerlo' },
    precio: { resaltado: 'un consultor' },
  }}
>
  <MetodoConsultor slot="visual" />
  <div slot="antes-secciones" class="contenedor -mt-6 pb-6 lg:-mt-8">
    <Insignias />
  </div>
  <MapaSitio slot="seccion-estructura" seccion={estructura} fondo={fondoEstructura} numero={i + 1} resaltado="la web de un consultor" />
</PlantillaPagina>
