---
// /paginas-web-contadores/ — página de sector para firmas contables y contadores en Bogotá.
// Todo el texto sale de src/data/contenido/paginas-web-contadores.ts y los precios de sitio.ts.
// La plantilla arma SEO, JSON-LD (página, migas, FAQ y servicio), secciones, preguntas y cierre.
// Momentos propios de la página:
//   - Portada: el año tributario 2026 (DIAN) en un panel 3D, con el mes para preparar la web y
//     una consulta típica por WhatsApp («¿Cuándo vence mi declaración?»).
//   - #demostracion: la estructura recomendada dibujada como el mapa del sitio de la firma
//     (el id se conserva por los enlaces existentes; no se ofrece una demostración).
// Plan recomendado (Web + Atención Inteligente): lo marca el módulo en la sección «precio».
import PlantillaPagina from '@/components/pagina/PlantillaPagina.astro';
import CalendarioTributario from '@/components/paginas/sectores/CalendarioTributario.astro';
import MapaSitio from '@/components/paginas/sectores/MapaSitio.astro';
import Insignias from '@/components/ui/Insignias.astro';
import { contenido } from '@/data/contenido/paginas-web-contadores';
import type { FondoSeccion, SeccionLista } from '@/data/contenido/tipos';

const i = contenido.secciones.findIndex((s) => s.id === 'demostracion');
const demostracion = contenido.secciones[i] as SeccionLista;
const fondoDemostracion: FondoSeccion = i % 2 === 0 ? 'base' : 'bajo';
---
<PlantillaPagina
  contenido={contenido}
  resaltado="contadores y firmas contables"
  opciones={{
    servicios: { resaltado: 'debe explicar' },
    'preguntas-clientes': { resaltado: 'debe responder', plegar: 'Ver las preguntas' },
    temporadas: { resaltado: 'cuándo preparar', plegar: 'Ver las fechas de 2026' },
    whatsapp: { resaltado: 'el contador asesora', plegar: 'Ver qué responde el agente y qué pasa a un contador' },
    conversacion: { resaltado: 'una consulta' },
    confianza: { resaltado: 'antes de escribirle', plegar: 'Ver las señales que revisa' },
    precio: { resaltado: 'una firma contable' },
    'que-no-hacemos': { resaltado: 'no hacemos' },
  }}
>
  <CalendarioTributario slot="visual" />
  <div slot="antes-secciones" class="contenedor -mt-6 pb-6 lg:-mt-8">
    <Insignias />
  </div>
  <MapaSitio slot="seccion-demostracion" seccion={demostracion} fondo={fondoDemostracion} numero={i + 1} resaltado="firma contable" />
</PlantillaPagina>
