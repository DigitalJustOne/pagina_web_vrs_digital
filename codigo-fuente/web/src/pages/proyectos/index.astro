---
// /proyectos/ — portafolio desde CASOS de sitio.ts: trabajos para clientes y productos propios,
// cada uno rotulado («Cliente», «Producto propio», «Plataforma»). Beauty Manager es producto
// propio de VRS Digital: se muestra qué ofrece, nunca resultados ni cifras.
// Todo el texto sale de src/data/contenido/proyectos.ts; capturas, medidas y textos alternativos
// de @/lib/casos. La plantilla arma SEO, JSON-LD (CollectionPage, migas y FAQ), secciones,
// preguntas y cierre.
// Momentos propios de la página:
//   - Portada: muro 3D con las capturas; cada una lleva a su proyecto en esta página.
// JSON-LD propio: lista de los proyectos (ItemList) con su enlace público.
import PlantillaPagina from '@/components/pagina/PlantillaPagina.astro';
import Cifras from '@/components/pagina/Cifras.astro';
import MosaicoProyectos from '@/components/paginas/sectores/MosaicoProyectos.astro';
import { contenido, textosProyectos } from '@/data/contenido/proyectos';
import { CASOS, CIFRAS } from '@/data/sitio';
import { imagenAbsoluta, urlAbsoluta } from '@/lib/schema';

// Lista de proyectos para buscadores: nombre, resumen y enlace público (lo mismo que se ve).
const lista = {
  '@type': 'ItemList',
  '@id': urlAbsoluta(contenido.ruta) + '#lista',
  name: contenido.hero.titulo,
  numberOfItems: CASOS.length,
  itemListElement: CASOS.map((c, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    item: {
      '@type': 'CreativeWork',
      name: c.cliente,
      description: c.resumen,
      about: c.sector,
      url: c.enlace,
      image: imagenAbsoluta(c.imagen),
      creator: { '@id': urlAbsoluta('/#organizacion') },
    },
  })),
};
---
<PlantillaPagina
  contenido={contenido}
  resaltado="Proyectos reales"
  jsonldExtra={[lista]}
  opciones={{
    portafolio: { resaltado: 'enlace público' },
  }}
>
  <MosaicoProyectos slot="visual" />
  <div slot="antes-secciones" role="group" aria-label={textosProyectos.cifras} class="contenedor -mt-6 pb-6 lg:-mt-8">
    <Cifras cifras={CIFRAS} />
  </div>
</PlantillaPagina>
